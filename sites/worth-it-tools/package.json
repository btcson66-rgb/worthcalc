{
  "name": "worth-it-tools",
  "version": "1.0.0",
  "description": "WorthCalc — free, fast, browser-based tools.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/postbuild-sitemaps.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint . --ext .js,.mjs,.ts,.astro",
    "lint:fix": "eslint . --ext .js,.mjs,.ts,.astro --fix",
    "check:links": "node scripts/check-links.mjs",
    "check:multilingual": "node scripts/check-multilingual-editorial.mjs",
    "check:shell": "node scripts/check-five-language-shell.mjs",
    "check:all-locales": "node scripts/check-all-localized-routes.mjs",
    "check:growth-content": "node scripts/check-growth-content.mjs",
    "check:growth-release": "node scripts/check-growth-release.mjs",
    "check:seo-packages": "node scripts/check-seo-packages-002-005.mjs",
    "check:url-budget": "node scripts/check-url-budget.mjs",
    "check:guide-index": "node scripts/check-guide-index.mjs",
    "generate:guide-index": "node scripts/generate-guide-index.mjs",
    "gsc:sitemap-health": "node scripts/gsc-submit-sitemaps.mjs --health",
    "test:growth": "tsc -p tsconfig.growth-tests.json && node tests/growth-smoke.mjs && node tests/growth-edge-cases.mjs",
    "audit:brief-coverage": "node scripts/audit-editorial-brief-coverage.mjs",
    "audit": "npm run build && node scripts/check-links.mjs && node scripts/audit.mjs",
    "verify": "npm run test:growth && npm run check:growth-content && npm run build && npm run typecheck && npm run lint && npm run check:links && npm run check:seo-packages && npm run check:url-budget && npm run check:guide-index && npm run check:multilingual && npm run check:shell && npm run check:all-locales && npm run check:growth-release && npm run audit:brief-coverage"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.3.0",
    "astro": "^5.6.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.23.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "eslint": "^9.23.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^16.0.0",
    "typescript": "^5.8.2"
  }
}
