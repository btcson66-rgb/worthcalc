---
import type { Locale } from '../consts';
import { getAffiliateProducts } from '../data/affiliateProducts';

interface Props {
  toolSlug: string;
  locale: Locale;
}

const { toolSlug, locale } = Astro.props;
const products = getAffiliateProducts(toolSlug);
const heading = locale === 'zh' ? '相關好物推薦' : 'Recommended products';
const cta = locale === 'zh' ? '前往查看 →' : 'View product →';
const disclosure =
  locale === 'zh'
    ? '本區塊含聯盟行銷連結，透過連結購買我們可能獲得分潤，不影響您的價格。'
    : 'This section contains affiliate links. We may earn a commission at no extra cost to you.';
---

{
  products.length > 0 && (
    <section
      class="affiliate-recs"
      aria-label={heading}
      data-affiliate-module
      data-affiliate-placement="result_card"
      data-affiliate-surface="calculator"
    >
      <h2>{heading}</h2>
      <div class="affiliate-grid">
        {products.map((product, index) => (
          <a
            class="affiliate-card"
            href={product.affiliate_url}
            rel="sponsored nofollow noopener"
            target="_blank"
            data-affiliate-product-id={product.product_id}
            data-affiliate-category={product.category}
            data-affiliate-network={product.affiliate_network}
            data-affiliate-batch={product.batch_id}
            data-affiliate-position={String(index + 1)}
          >
            <strong>{product.name}</strong>
            <span class="affiliate-note">{product.category}</span>
            <span class="affiliate-meta">
              {product.price}｜{product.affiliate_network}
            </span>
            <span class="affiliate-cta">{cta}</span>
          </a>
        ))}
      </div>
      <p class="affiliate-disclosure">{disclosure}</p>
    </section>
  )
}

{products.length > 0 && <script>
  import { trackAffiliateClick, trackAffiliateItemView, trackAffiliateModuleView } from '../lib/affiliateAnalytics';

  const startAffiliateTracking = () => {
    const module = document.querySelector('[data-affiliate-module]');
    if (!(module instanceof HTMLElement) || module.dataset.affiliateTrackingReady === 'true') return;
    module.dataset.affiliateTrackingReady = 'true';
    const links = Array.from(module.querySelectorAll('a[data-affiliate-product-id]'))
      .filter((link): link is HTMLAnchorElement => link instanceof HTMLAnchorElement);
    const context = {
      placement: module.dataset.affiliatePlacement || 'result_card',
      surface_type: module.dataset.affiliateSurface || 'calculator',
    };
    const network = [...new Set(links.map((link) => link.dataset.affiliateNetwork || 'other'))];
    const batchId = links[0]?.dataset.affiliateBatch || 'worthcalc-catalog-legacy';
    const moduleObserver = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting && entry.intersectionRatio >= 0.5)) {
        trackAffiliateModuleView({ ...context, affiliate_network: network.length === 1 ? network[0] : 'mixed', batch_id: batchId });
        moduleObserver.disconnect();
      }
    }, { threshold: [0.5] });
    moduleObserver.observe(module);

    const itemObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting || entry.intersectionRatio < 0.5) continue;
        const link = entry.target;
        if (!(link instanceof HTMLAnchorElement)) continue;
        trackAffiliateItemView({
          ...context,
          affiliate_network: link.dataset.affiliateNetwork || 'other',
          product_id: link.dataset.affiliateProductId || 'unknown',
          product_category: link.dataset.affiliateCategory || 'general',
          batch_id: link.dataset.affiliateBatch || batchId,
          card_position: Number(link.dataset.affiliatePosition || 0),
        });
        itemObserver.unobserve(link);
      }
    }, { threshold: [0.5] });
    links.forEach((link) => {
      itemObserver.observe(link);
      link.addEventListener('click', () => trackAffiliateClick({
        ...context,
        affiliate_network: link.dataset.affiliateNetwork || 'other',
        product_id: link.dataset.affiliateProductId || 'unknown',
        product_category: link.dataset.affiliateCategory || 'general',
        batch_id: link.dataset.affiliateBatch || batchId,
        card_position: Number(link.dataset.affiliatePosition || 0),
      }));
    });
    window.addEventListener('pagehide', () => { moduleObserver.disconnect(); itemObserver.disconnect(); }, { once: true });
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', startAffiliateTracking, { once: true });
  else startAffiliateTracking();
</script>}

<style>
  .affiliate-recs {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
    margin-block: 1.5rem;
    padding: 1rem;
  }

  .affiliate-grid {
    display: grid;
    gap: 0.6rem;
    margin-top: 0.8rem;
  }

  .affiliate-card {
    display: grid;
    gap: 0.25rem;
    padding: 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
  }

  .affiliate-card:hover {
    border-color: var(--color-accent, currentColor);
  }

  .affiliate-note,
  .affiliate-meta,
  .affiliate-disclosure {
    color: var(--color-muted);
  }

  .affiliate-disclosure {
    margin: 0.8rem 0 0;
    font-size: 0.85em;
  }

  .affiliate-cta {
    font-weight: 600;
  }
</style>
