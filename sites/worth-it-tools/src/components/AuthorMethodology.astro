---
import type { CoreLocale } from '../consts';

interface Props {
  locale: CoreLocale;
}

const { locale } = Astro.props;

const copy = {
  en: {
    heading: 'Who builds this and how the numbers are checked',
    lead: {
      before: 'WorthCalc is published by Btcson Lab. ',
      strong: 'Benson Lai',
      after: ' builds the calculators and reviews the content: he is responsible for how each formula is set up, which official source each figure comes from, and the check date printed on every page. This site is not a bank, a lender, a broker or a financial adviser, and this page lists no degree, licence or job title for anyone, because the figures should earn trust from sources and arithmetic you can check yourself, not from a title. What the site does is narrower and, we think, more useful: calculators that show their own arithmetic, and a statement of where every number comes from.',
    },
    formula: 'Every formula is on the page. If a calculator produces a result, the arithmetic behind it is written out in the same page, not hidden in code. You can check our work with a pen.',
    labelsIntro: 'Every number is labelled. We sort figures into four kinds, and each is marked as such:',
    labels: [
      { term: 'Verified', text: 'taken from a named primary or official source, with a link and the date we checked it.' },
      { term: 'Illustrative', text: 'a worked example to show how the formula behaves. Not a claim about your situation.' },
      { term: 'Your input', text: 'a value you typed. We never change it silently.' },
      { term: 'Derived', text: 'calculated from the above, using the formula shown.' },
    ],
    sources: 'Sources are primary where possible. We cite the agency or institution that publishes the figure rather than an article about it. Where we could not find a primary source, the page says so instead of citing a weaker one.',
    stale: 'Prices and rates go stale. Energy tariffs, fees and thresholds change. Every page carries the date it was last checked. If that date is old, treat the defaults as a starting point and enter your own figures.',
    advice: 'This is not advice. These tools compute; they do not recommend. A calculator cannot know your circumstances, and we do not ask for them.',
    error: {
      before: 'Found an error? Tell us and we will fix it or take the page down. Contact details are on the ',
      link: 'contact page',
      after: '. We would rather be corrected than be wrong quietly.',
      href: '/en/contact/',
    },
  },
  zh: {
    heading: '這個站是誰做的，數字怎麼查核',
    lead: {
      before: 'WorthCalc 由 Btcson Lab 發布，',
      strong: 'Benson Lai',
      after: ' 負責計算機的開發與內容審核：每一條公式怎麼設計、每個數字取自哪一個官方來源、每一頁印出來的查核日期，都由他負責。本站不是銀行、放款機構、券商，也不是理財顧問；這一頁不列出任何人的學歷、證照或職稱，因為數字的可信度應該來自你能自己查證的來源與算式，而不是頭銜。本站做的事比較窄，但我們認為更有用：做會把自己算式攤開來的計算機，並且說清楚每個數字從哪裡來。',
    },
    formula: '每一條公式都寫在頁面上。計算機算出結果，背後的算式就寫在同一頁，不藏在程式裡。你可以拿紙筆自己驗算。',
    labelsIntro: '每一個數字都標明種類。我們把數字分成四類，頁面上會標示：',
    labels: [
      { term: '已查證', text: '取自具名的一手或官方來源，附連結與我們查核的日期。' },
      { term: '示意', text: '用來說明公式怎麼運作的算例，不是對你處境的宣稱。' },
      { term: '你的輸入', text: '你自己填的值，我們不會偷偷改動。' },
      { term: '推導', text: '由以上數字依頁面所示公式算出。' },
    ],
    sources: '來源盡量用一手。我們引用發布該數字的機關或機構本身，而不是報導它的文章。找不到一手來源時，頁面會直說，而不是隨便找個次級來源充數。',
    stale: '價格與費率會過期。電價、手續費、級距門檻都會變。每一頁都標了最後查核日期。如果那個日期已經很舊，請把預設值當成起點，改填你自己的數字。',
    advice: '這不是投資或理財建議。這些工具只做計算，不做推薦。計算機不可能知道你的處境，我們也不會問。',
    error: {
      before: '發現錯誤？告訴我們，我們會更正或把那一頁下架。聯絡方式在',
      link: '聯絡頁',
      after: '。我們寧可被指正，也不要安靜地錯下去。',
      href: '/zh/contact/',
    },
  },
}[locale];
---

<section class="author-methodology" data-author-methodology>
  <h2>{copy.heading}</h2>
  <p>{copy.lead.before}<strong>{copy.lead.strong}</strong>{copy.lead.after}</p>
  <p>{copy.formula}</p>
  <p>{copy.labelsIntro}</p>
  <ul>
    {copy.labels.map((item) => <li><strong>{item.term}</strong> — {item.text}</li>)}
  </ul>
  <p>{copy.sources}</p>
  <p>{copy.stale}</p>
  <p>{copy.advice}</p>
  <p>{copy.error.before}<a href={copy.error.href}>{copy.error.link}</a>{copy.error.after}</p>
</section>

<style>
  .author-methodology {
    margin-block: 2rem 0;
  }

  .author-methodology li + li {
    margin-top: 0.4rem;
  }
</style>
