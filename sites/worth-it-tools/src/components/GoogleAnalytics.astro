---
import { AFFILIATE_GA_ID, GA_ID } from '../consts';
---

{(GA_ID || AFFILIATE_GA_ID) && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID || AFFILIATE_GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID, AFFILIATE_GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());
      if (GA_ID) gtag('config', GA_ID);
      if (AFFILIATE_GA_ID && AFFILIATE_GA_ID !== GA_ID) gtag('config', AFFILIATE_GA_ID, { send_page_view: false });
    </script>
  </>
)}
