---
import { LOCALES, SITE, type ContentLocale } from '../consts';
import { getLocaleFromUrl, localizedCorePath, useTranslations } from '../i18n/utils';
import LanguageSwitch from './LanguageSwitch.astro';

interface Props {
  locales?: ContentLocale[];
}

const { locales = [...LOCALES] } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href={localizedCorePath(locale, '/')} aria-label={SITE.name}>
      <svg class="brand__mark" viewBox="0 0 32 32" width="30" height="30" aria-hidden="true" focusable="false">
        <rect x="1" y="1" width="30" height="30" rx="4" fill="#1f8a63" />
        <rect x="1.75" y="1.75" width="28.5" height="28.5" rx="3.25" fill="none" stroke="#e2c58b" stroke-width="1.5" />
        <path d="M8 16.5l4.2 4.4L24 9.5" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M8 25h16" stroke="#e2c58b" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      <span class="brand__name">Worth<b>Calc</b></span>
    </a>
    <div class="site-header__actions">
      <nav class="primary-nav" aria-label="Primary">
        <a href={localizedCorePath(locale, '/')}>{t('nav.home')}</a>
        <a href={localizedCorePath(locale, '/tools')}>{t('nav.tools')}</a>
        <a href={localizedCorePath(locale, '/guides')}>{t('nav.guides')}</a>
        <a href={localizedCorePath(locale, '/about')}>{t('nav.about')}</a>
      </nav>
      <LanguageSwitch locales={locales} />
    </div>
  </div>
</header>
