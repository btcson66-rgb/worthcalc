---
/*
 * The homepage.
 *
 * It used to render the entire site: 15 <h2> sections and 304 internal links on
 * English, including `guideIndex[locale]` in full because that index was the
 * only inbound link 131 editorial pages had. That made the most-crawled page on
 * the site a sitemap, and it made the homepage's own topic — what WorthCalc is
 * for — impossible to read from the markup.
 *
 * Now it is nine sections: hero, what the site is for, the four decision
 * clusters, ten calculators, the two directories, six guides, method and
 * limits, FAQ. The complete catalogue moved to /tools/ and /guides/, which is
 * where the 131 pages get their inbound link from instead.
 */
import type { CoreLocale } from '../consts';
import { localizedPath } from '../i18n/utils';
import { homeContent } from '../lib/home';
import { getFeaturedCalculators } from '../lib/catalog';
import { PRIMARY_TOPIC_IDS, TOPIC_IDS, topicCopy, topicHref } from '../lib/topics';
import FAQ from './FAQ.astro';
import NewsletterSignup from './NewsletterSignup.astro';

interface Props {
  locale: CoreLocale;
}

const { locale } = Astro.props;
const content = homeContent[locale];
const trust = content.trust;
const topics = topicCopy[locale];

const featured = await getFeaturedCalculators(locale);
const secondaryTopics = TOPIC_IDS.filter((topic) => !PRIMARY_TOPIC_IDS.includes(topic));
---

<section class="hero">
  <span class="hero__eyebrow">💸 {content.eyebrow}</span>
  <h1>{content.heading}<span class="accent">{content.accent}</span>{content.headingSuffix}</h1>
  <p>{content.intro}</p>
  <ul class="hero__badges">
    {content.badges.map((badge) => <li>{badge}</li>)}
  </ul>
</section>

<section class="home-value" aria-labelledby="home-value-heading">
  <h2 id="home-value-heading">{content.value.heading}</h2>
  <p class="section-lead">{content.value.lead}</p>
  <div class="home-value__grid">
    {content.value.items.map((item) => (
      <div>
        <h3>{item.title}</h3>
        <p>{item.body}</p>
      </div>
    ))}
  </div>
</section>

<section class="home-categories" aria-labelledby="home-categories-heading">
  <h2 id="home-categories-heading">{content.categories.heading}</h2>
  <p class="section-lead">{content.categories.lead}</p>
  <div class="guide-grid">
    {PRIMARY_TOPIC_IDS.map((topic) => (
      <article class="guide-card">
        <h3><a href={topicHref(locale, topic)}>{topics[topic].name}</a></h3>
        <p>{topics[topic].blurb}</p>
        <span>{content.categories.cta} →</span>
      </article>
    ))}
  </div>
</section>

<section id="tools">
  <h2>{content.toolsHeading}</h2>
  <p class="section-lead">{content.toolsLead}</p>
  <div class="grid">
    {featured.map((tool) => (
      <article class="card">
        <span class="card__icon" aria-hidden="true">{tool.icon}</span>
        <h3><a href={localizedPath(locale, tool.path)}>{tool.title}</a></h3>
        <p>{tool.description}</p>
        <span class="card__cta">{content.toolsCta}</span>
      </article>
    ))}
  </div>
</section>

<section class="home-library" aria-labelledby="home-library-heading">
  <h2 id="home-library-heading">{content.library.heading}</h2>
  <p class="section-lead">{content.library.lead}</p>
  <ul class="home-library__links">
    <li><a href={localizedPath(locale, '/tools')}>{content.library.calculators}</a></li>
    <li><a href={localizedPath(locale, '/guides')}>{content.library.guides}</a></li>
  </ul>
  <p class="home-library__more">
    <strong>{content.library.moreTopics}:</strong>{' '}
    {secondaryTopics.map((topic, index) => (
      <>
        {index > 0 && <span aria-hidden="true"> · </span>}
        <a href={topicHref(locale, topic)}>{topics[topic].name}</a>
      </>
    ))}
  </p>
</section>

<section class="home-guides" aria-labelledby="home-guides-heading">
  <h2 id="home-guides-heading">{content.guidesHeading}</h2>
  <p class="section-lead">{content.guidesLead}</p>
  <div class="guide-grid">
    {content.guides.map((guide) => (
      <article class="guide-card">
        <h3><a href={localizedPath(locale, guide.path)}>{guide.title}</a></h3>
        <p>{guide.description}</p>
        <span>{content.guidesCta} →</span>
      </article>
    ))}
  </div>
  <p class="home-guides__more">
    <a href={localizedPath(locale, '/guides')}>{content.guidesMore} →</a>
  </p>
</section>

<section class="home-trust" aria-labelledby="home-trust-heading">
  <h2 id="home-trust-heading">{trust.heading}</h2>
  <div class="home-trust__grid">
    <div>
      <h3>{trust.methodHeading}</h3>
      <p>{trust.method}</p>
    </div>
    <div>
      <h3>{trust.scopeHeading}</h3>
      <p>{trust.scope}</p>
    </div>
  </div>
  <h3>{content.methodHeading}</h3>
  <p>{content.methodLead}</p>
  <ol>
    {content.methodSteps.map((step) => <li>{step}</li>)}
  </ol>
  {trust.sources && trust.sources.length > 0 && (
    <>
      <h3>{trust.sourcesHeading}</h3>
      <p>{trust.sourcesLead}</p>
      <ul class="home-trust__sources">
        {trust.sources.map((source) => (
          <li><a href={source.href}>{source.label}</a></li>
        ))}
      </ul>
    </>
  )}
  <p class="updated">
    <strong>{trust.reviewedLabel}:</strong>{' '}
    <time datetime={trust.reviewedDate}>{trust.reviewedDisplay}</time>
  </p>
  <p class="home-trust__advice"><strong>{trust.advice}</strong></p>
</section>

<FAQ items={content.faq} heading={content.faqHeading} />

{locale === 'en' && <NewsletterSignup id="home-newsletter-signup" />}
