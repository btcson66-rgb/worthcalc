---
import { LOCALE_LABELS, LOCALES, type ContentLocale } from '../consts';
import { isSoftDeindexed } from '../lib/seo';
import { getLocaleFromUrl, switchLocalePath, useTranslations } from '../i18n/utils';

interface Props {
  locales?: ContentLocale[];
}

const { locales = [...LOCALES] } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
// Only offer a language whose target page is indexable (same test the hreflang
// alternates use). The whole /en/ tree is noindex, so an indexable /zh/ page
// must not link to it: crawlers would be sent to a page that will never be
// indexed. A noindex page may still link out to an indexable sibling, and the
// current locale is always kept so the switcher never lists the page away.
const offered = locales.filter(
  (target) => target === locale || !isSoftDeindexed(switchLocalePath(Astro.url, target)),
);
---

{offered.length > 1 && (
<nav class="language-switch" aria-label={t('lang.switch')}>
  {offered.map((target) => (
    <a
      href={switchLocalePath(Astro.url, target)}
      aria-current={target === locale ? 'true' : undefined}
    >
      {LOCALE_LABELS[target]}
    </a>
  ))}
</nav>
)}
