---
import type { Locale } from '../consts';
import type { BreadcrumbItem } from '../lib/seo';
import { localizedCorePath, useTranslations } from '../i18n/utils';
import { articleJsonLd } from '../lib/seo';
import AdSlot from '../components/AdSlot.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  updated?: string;
  breadcrumb?: BreadcrumbItem[];
  noindex?: boolean;
  alternateLocales?: Locale[];
  seoTitle?: string;
  ogTitle?: string;
  ogDescription?: string;
  image?: string;
  imageAlt?: string;
  robots?: string;
  jsonLd?: object[];
  showTitle?: boolean;
}

const { title, description, locale, updated, breadcrumb, noindex, alternateLocales, seoTitle, ogTitle, ogDescription, image, imageAlt, robots, jsonLd = [], showTitle = true } = Astro.props;
const t = useTranslations(locale);
const crumbs = breadcrumb ?? [
  { name: t('breadcrumb.home'), url: localizedCorePath(locale, '/') },
  { name: title, url: Astro.url.pathname },
];
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  type="article"
  noindex={noindex}
  alternateLocales={alternateLocales}
  seoTitle={seoTitle}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  image={image}
  imageAlt={imageAlt}
  robots={robots}
  jsonLd={jsonLd.length > 0 ? jsonLd : [articleJsonLd({ headline: title, description, url: Astro.url.pathname, locale, dateModified: updated, site: Astro.site })]}
>
  <Breadcrumb items={crumbs} includeJsonLd={jsonLd.length === 0} />
  <article class="prose">
    {showTitle && <h1>{title}</h1>}
    {updated && <p class="updated">{updated}</p>}
    <slot />
  </article>
  <AdSlot />
</BaseLayout>
