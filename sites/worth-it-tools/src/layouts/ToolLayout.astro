---
import type { Locale } from '../consts';
import type { BreadcrumbItem, FaqItem } from '../lib/seo';
import { getCalculatorReview } from '../lib/calculatorReview';
import { softwareAppJsonLd, techArticleJsonLd } from '../lib/seo';
import { TOOL_CONTENT_UPDATED, TOOL_FIRST_PUBLISHED } from '../data/pageDates';
import { TOOL_PRESETS } from '../data/toolPresets';
import { BRIDGE_MAP } from '../data/moneyBridge';
import { localizedCorePath, useTranslations } from '../i18n/utils';
import AdSlot from '../components/AdSlot.astro';
import AffiliateRecs from '../components/AffiliateRecs.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import TrustBlock from '../components/TrustBlock.astro';
import TopicLinks from '../components/TopicLinks.astro';
import BaseLayout from './BaseLayout.astro';
import type { TrustBlockProps } from '../types/trustBlock';
import { fallbackTrustBlock, isoDate } from '../lib/trustBlock';
import AuthorByline from '../components/AuthorByline.astro';
import MoneyBridge from '../components/MoneyBridge.astro';
import ToolPresets from '../components/ToolPresets.astro';

interface RelatedLink {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  locale: Locale;
  tool: { name: string };
  breadcrumb?: BreadcrumbItem[];
  faq?: FaqItem[];
  related?: RelatedLink[];
  noindex?: boolean;
  alternateLocales?: Locale[];
  showReview?: boolean;
  trustBlock?: TrustBlockProps;
  showTrustBlock?: boolean;
}

const {
  title,
  description,
  locale,
  tool,
  breadcrumb,
  faq = [],
  related = [],
  noindex,
  alternateLocales,
  showReview = true,
  trustBlock,
  showTrustBlock = true,
} = Astro.props;
const t = useTranslations(locale);
const crumbs = breadcrumb ?? [
  { name: t('breadcrumb.home'), url: localizedCorePath(locale, '/') },
  { name: tool.name, url: Astro.url.pathname },
];
const slug = Astro.url.pathname.split('/').filter(Boolean).at(-1) ?? '';
// zh calculators with a sourced first-publish date also describe their methodology as a TechArticle.
const datePublished = locale === 'zh' && !noindex ? TOOL_FIRST_PUBLISHED[slug] : undefined;
const addedContent = [
  TOOL_PRESETS[slug] ? '情境範例' : '',
  BRIDGE_MAP[`/tools/${slug}`] ? '延伸試算' : '',
].filter(Boolean).join('與');
const jsonLd = [
  softwareAppJsonLd({
    name: tool.name,
    description,
    url: Astro.url.pathname,
    locale,
    site: Astro.site,
  }),
  ...(datePublished
    ? [techArticleJsonLd({
      headline: title,
      description,
      url: Astro.url.pathname,
      locale,
      datePublished,
      dateModified: TOOL_CONTENT_UPDATED,
      site: Astro.site,
    })]
    : []),
];
const review = getCalculatorReview(slug, locale);
const resolvedTrustBlock = trustBlock ?? fallbackTrustBlock(locale, review?.lastUpdated);
const reviewLabels = {
  en: {
    methodology: 'Methodology',
    assumptions: 'Assumptions',
    example: 'Example calculation',
    limitations: 'Limitations',
    lastUpdated: 'Last updated',
    disclaimer: 'Estimate disclaimer',
  },
  zh: {
      methodology: '計算方法',
      assumptions: '主要假設',
      example: '範例計算',
      limitations: '限制',
      lastUpdated: '最後更新',
      disclaimer: '估算免責聲明',
  },
}[locale];
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  type="website"
  noindex={noindex}
  alternateLocales={alternateLocales}
  jsonLd={jsonLd}
>
  <Breadcrumb items={crumbs} />
  <h1>{title}</h1>
  <AuthorByline locale={locale} lastVerified={isoDate(resolvedTrustBlock.lastReviewed)} />
  {datePublished && (
    <p class="content-dates">
      首次發布 <time datetime={datePublished}>{datePublished}</time>・內容更新 <time datetime={TOOL_CONTENT_UPDATED}>{TOOL_CONTENT_UPDATED}</time>{addedContent ? `（新增${addedContent}）` : ''}
    </p>
  )}
  <AdSlot noindex={noindex} />
  <section class="tool">
    <ToolPresets slug={slug} locale={locale} />
    <slot />
  </section>
  {showReview && review && (
    <section class="calculator-review" aria-labelledby="calculator-review-heading">
      <h2 id="calculator-review-heading">{reviewLabels.methodology}</h2>
      <p>{review.methodology}</p>

      <h2>{reviewLabels.assumptions}</h2>
      <ul>
        {review.assumptions.map((item) => <li>{item}</li>)}
      </ul>

      <h2>{reviewLabels.example}</h2>
      <p>{review.example}</p>

      <h2>{reviewLabels.limitations}</h2>
      <ul>
        {review.limitations.map((item) => <li>{item}</li>)}
      </ul>

      <p class="last-updated">
        <strong>{reviewLabels.lastUpdated}:</strong> {review.lastUpdated}
      </p>
      <p class="estimate-disclaimer">
        <strong>{reviewLabels.disclaimer}:</strong> {review.disclaimer}
      </p>
    </section>
  )}
  {showTrustBlock && <TrustBlock {...resolvedTrustBlock} />}
  <AffiliateRecs toolSlug={slug} locale={locale} />
  {locale === 'en' && <NewsletterSignup id="tool-newsletter-signup" />}
  <p class="privacy-note">{t('tool.privacyNote')}</p>
  <MoneyBridge path={`/tools/${slug}`} locale={locale} />
  <FAQ items={faq} />
  <RelatedLinks links={related} />
  <TopicLinks locale={locale} path={`/tools/${slug}`} />
  <AdSlot noindex={noindex} />
</BaseLayout>

<script>
  // Shared calculator interaction layer (sliders, chart helpers, count-up).
  // Loaded here so every tool page gets it without importing anything.
  import '../lib/calcUi';
</script>

<style>
  .calculator-review {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
    margin-block: 1.5rem;
    padding: 1rem;
  }

  .calculator-review h2 {
    margin-top: 1.2rem;
  }

  .calculator-review h2:first-child {
    margin-top: 0;
  }

  .calculator-review ul {
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
  }

  .calculator-review li + li {
    margin-top: 0.4rem;
  }

  .content-dates {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-block: 0.25rem 0.75rem;
  }

  .last-updated,
  .estimate-disclaimer {
    color: var(--color-muted);
  }
</style>
