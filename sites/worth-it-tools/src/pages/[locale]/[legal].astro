---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import type { ContentLocale } from '../../consts';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { seoPackage001 } from '../../data/seoPackage001';
import { seoPackageGuides } from '../../data/seoPackageRegistry';
import { fallbackTrustBlock } from '../../lib/trustBlock';
import { articleJsonLd, breadcrumbJsonLd } from '../../lib/seo';
import { localizedCorePath, useTranslations } from '../../i18n/utils';
import { GUIDE_DATES } from '../../data/pageDates';
import MoneyBridge from '../../components/MoneyBridge.astro';

export async function getStaticPaths() {
  // Growth articles only. The en and zh legal pages are static files under
  // src/pages/en and src/pages/zh; the es/fr/de legal pages that used to be
  // listed here were deleted with the retired locales (P1b).
  const entries = await getCollection('growthArticles', ({ data }) => !data.draft);
  const localesBySlug = new Map<string, ContentLocale[]>();
  for (const entry of entries) {
    const locales = localesBySlug.get(entry.data.articleSlug) ?? [];
    locales.push(entry.data.locale);
    localesBySlug.set(entry.data.articleSlug, locales);
  }
  const growth = entries.filter((entry) => !seoPackageGuides[entry.data.locale + '/' + entry.data.articleSlug]).map((entry) => ({
    params: { locale: entry.data.locale, legal: entry.data.articleSlug },
    props: { growthEntry: entry, alternateLocales: localesBySlug.get(entry.data.articleSlug) ?? [entry.data.locale] },
  }));
  return growth;
}

const locale = Astro.params.locale as ContentLocale;
const growthEntry = Astro.props.growthEntry as CollectionEntry<'growthArticles'>;
const packageMeta = seoPackage001[`${growthEntry.data.locale}/${growthEntry.data.articleSlug}`];
const packageSchemas = import.meta.glob('../../data/seo-package-001/schema/*.json', { eager: true, import: 'default' }) as Record<string, object>;
const packageSchema = packageMeta
  ? Object.entries(packageSchemas).find(([path]) => path.endsWith(`/${growthEntry.data.locale}__${growthEntry.data.articleSlug}.json`))?.[1]
  : undefined;
const alternateLocales = Astro.props.alternateLocales as ContentLocale[];
const { Content: GrowthContent } = await render(growthEntry);
const reviewedOn = growthEntry.data.lastReviewed.toISOString().slice(0, 10);
const fallbackBlock = fallbackTrustBlock(locale, reviewedOn);
// An article that carries its own sources (see content.config.ts) gets a trust block that lists them.
const trustBlock = growthEntry.data.sources?.length
  ? {
    method: growthEntry.data.method ?? fallbackBlock.method,
    formula: growthEntry.data.formula,
    sources: growthEntry.data.sources,
    limits: growthEntry.data.limits ?? fallbackBlock.limits,
    lastReviewed: reviewedOn,
    locale,
  }
  : undefined;

// Guides with sourced dates (src/data/pageDates.ts) describe themselves as an Article with datePublished and
// dateModified. Passing jsonLd turns off the layout's own breadcrumb node, so it is added here.
const guideDates = locale === 'zh' && !packageSchema ? GUIDE_DATES[growthEntry.data.articleSlug] : undefined;
const t = useTranslations(locale);
const guideJsonLd = guideDates
  ? [
    articleJsonLd({
      headline: growthEntry.data.title,
      description: growthEntry.data.description,
      url: Astro.url.pathname,
      locale,
      datePublished: guideDates.datePublished,
      dateModified: guideDates.dateModified,
      site: Astro.site,
    }),
    breadcrumbJsonLd([
      { name: t('breadcrumb.home'), url: localizedCorePath(locale, '/') },
      { name: growthEntry.data.title, url: Astro.url.pathname },
    ], Astro.site),
  ]
  : undefined;
---
<ArticleLayout
  title={growthEntry.data.title}
  description={growthEntry.data.description}
  locale={locale}
  updated={guideDates?.dateModified ?? reviewedOn}
  trustBlock={trustBlock}
  alternateLocales={alternateLocales}
  seoTitle={packageMeta?.seoTitle}
  ogTitle={packageMeta?.ogTitle}
  ogDescription={packageMeta?.ogDescription}
  robots={packageMeta?.robots}
  image={packageMeta?.ogImage}
  imageAlt={packageMeta?.imageAlt}
  jsonLd={packageSchema ? [packageSchema] : guideJsonLd}
  showTitle={!packageMeta}
>
  <GrowthContent />
  <MoneyBridge path={`/${growthEntry.data.articleSlug}`} locale={locale} />
</ArticleLayout>
