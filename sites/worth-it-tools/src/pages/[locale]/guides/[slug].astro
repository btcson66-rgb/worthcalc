---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { Locale } from '../../../consts';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { seoPackageGuides } from '../../../data/seoPackages002to005';

type Props = {
  growthEntry: CollectionEntry<'growthArticles'>;
  alternateLocales: Locale[];
};

export async function getStaticPaths() {
  const entries = await getCollection('growthArticles', ({ data }) => !data.draft);
  const packageEntries = entries.filter((entry) => seoPackageGuides[entry.data.locale + '/' + entry.data.articleSlug]);
  const localesBySlug = new Map<string, Locale[]>();
  for (const entry of packageEntries) {
    const locales = localesBySlug.get(entry.data.articleSlug) ?? [];
    locales.push(entry.data.locale as Locale);
    localesBySlug.set(entry.data.articleSlug, locales);
  }
  return packageEntries.map((entry) => ({
    params: { locale: entry.data.locale, slug: entry.data.articleSlug },
    props: {
      growthEntry: entry,
      alternateLocales: localesBySlug.get(entry.data.articleSlug) ?? [entry.data.locale as Locale],
    },
  }));
}

const locale = Astro.params.locale as Locale;
const slug = Astro.params.slug!;
const meta = seoPackageGuides[locale + '/' + slug];
const growthEntry = Astro.props.growthEntry as Props['growthEntry'];
if (!meta || !growthEntry) throw new Error('Missing SEO package guide for ' + locale + '/' + slug);

const packageSchemas = import.meta.glob('../../../data/seo-packages-002-005/schema/*.json', {
  eager: true,
  import: 'default',
}) as Record<string, object>;
const packageSchema = Object.entries(packageSchemas).find(([path]) => path.endsWith('/' + meta.schemaFile))?.[1];
if (!packageSchema) throw new Error('Missing schema for ' + meta.key);

const rendered = await render(growthEntry);
const GrowthContent = rendered.Content;
const alternateLocales = Astro.props.alternateLocales as Props['alternateLocales'];
---

<ArticleLayout
  title={meta.title}
  description={meta.metaDescription}
  locale={locale}
  updated={meta.lastReviewed}
  alternateLocales={alternateLocales}
  seoTitle={meta.seoTitle}
  ogTitle={meta.ogTitle}
  ogDescription={meta.ogDescription}
  robots={meta.robots}
  image={meta.ogImage}
  imageAlt={meta.imageAlt}
  jsonLd={[packageSchema]}
  showTitle={false}
>
  <GrowthContent />
</ArticleLayout>
