---
import { LOCALES } from '../../consts';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { trustBlockFromDecisionGuide } from '../../lib/trustBlock';
import DecisionGuide from '../../components/DecisionGuide.astro';
import EVChargingCostCalculator from '../../components/EVChargingCostCalculator.astro';
import TWChargingCostCalculator from '../../components/TWChargingCostCalculator.astro';
import FAQ from '../../components/FAQ.astro';
import { evChargingCostGuides } from '../../data/decisionGuides';
import type { FaqItem } from '../../lib/seo';

type EditorialLocale = 'en' | 'zh';

const articles: Record<EditorialLocale, { title: string; description: string; faq: FaqItem[] }> = {
  en: {
    title: 'Home charging vs public charging: what does an EV really cost per mile?',
    description: 'Calculate EV charging cost per mile from home, public AC and DC fast-charging rates, charging losses, kWh share, subscriptions and session fees.',
    faq: [
      { question: 'How do I calculate EV charging cost per mile?', answer: 'Multiply miles by kWh per 100 miles, add charging loss, then multiply grid kWh by a rate weighted across home, public AC and DC charging. Add memberships and session or idle fees, then divide the annual total by annual miles.' },
      { question: 'Should I use the EV dashboard consumption or electricity from the wall?', answer: 'Dashboard consumption usually represents energy used by the vehicle, while the bill or charger records energy delivered. If you start with dashboard kWh per 100 miles, add charging loss; if you already measured wall-to-wheel consumption, do not add it again.' },
      { question: 'Is DC fast charging always more expensive than charging at home?', answer: 'It is normally priced higher, but the answer depends on the exact utility tariff, network, plan, location and fees. Compare the prices that apply to your account rather than a national average.' },
      { question: 'Do charging subscriptions reduce cost per mile?', answer: 'Only if the per-kWh or session savings across your paid usage exceed the monthly fee. Include the fee for every paid month, including months with little public charging.' },
      { question: 'Does this calculation include buying and installing a home charger?', answer: 'No. It estimates annual charging energy and directly attributable recurring fees. Add equipment, electrical work and financing separately when comparing total vehicle ownership cost.' },
    ],
  },
  zh: {
    title: '充電樁一度電多少錢？家用與公共充電電費怎麼比？',
    description: '查清充電樁一度電多少錢與充電樁電費：用台電帳單、公共 AC／DC 快充費率、充電損耗、度數占比、會員月費與占位費，比較家用充電樁電費。',
    faq: [
      { question: '電動車每公里電費怎麼算？', answer: '先用年里程乘以每 100 公里耗電，再加上充電損耗；接著依家充、公共 AC 與 DC 快充的實際充電度數占比加權電價，加入會員、啟動、停車與占位費後，除以年公里。' },
      { question: '車機顯示的 kWh/100km 可以直接乘電價嗎？', answer: '通常不行。車機多半顯示行駛端耗電，台電或充電業者帳單則是電網供電量，中間還有充電損耗。如果你已用電表度數除以公里，就不要再加一次損耗。' },
      { question: '家用充電一定比公共快充便宜嗎？', answer: '常見情況是家充較低，但仍取決於住宅級距、夏月或時間電價、社區加價，以及公共業者的會員方案。必須用自己的帳單與場站付款畫面查核。' },
      { question: '公共快充只要計算每度電價嗎？', answer: '不一定。部分場站還有啟動費、計時費、停車費、會員月費或充滿後占位費；這些都應按一年實付金額加入。' },
      { question: '家用充電樁工程費有算在每公里成本裡嗎？', answer: '本頁只算充電能源與經常性費用。充電樁、拉線、電力增設及社區工程應在比較電動車總持有成本時另外納入。' },
    ],
  },
};

const calculators = {
  en: {
    currency: 'USD' as const,
    distanceUnit: 'mi' as const,
    defaults: { annualDistance: 12000, efficiency: 30, chargingLoss: 10, homeShare: 70, publicAcShare: 10, publicDcShare: 20, homeRate: 0.16, publicAcRate: 0.30, publicDcRate: 0.55, monthlyMembership: 10, annualSessionFees: 0 },
    copy: {
      heading: 'EV charging cost-per-mile calculator',
      intro: 'Replace the examples with the rate that applies to your bill and account. Shares refer to delivered kWh, in home / public AC / public DC order.',
      annualDistance: 'Annual driving (miles)', efficiency: 'Vehicle use (kWh/100 mi)', chargingLoss: 'Charging loss (%)', homeShare: 'Home share of kWh (%)', publicAcShare: 'Public AC share (%)', publicDcShare: 'DC fast-charge share (%)', homeRate: 'Home electricity ($/kWh)', publicAcRate: 'Public AC ($/kWh)', publicDcRate: 'Public DC ($/kWh)', monthlyMembership: 'Charging membership ($/month)', annualSessionFees: 'Session, parking and idle fees ($/year)', annualCost: 'Annual charging cost', costPerDistance: 'Charging cost per mile', effectiveRate: 'Weighted energy price', batteryEnergy: 'Energy reaching battery', gridEnergy: 'Energy billed by grid/networks', homeOnlyCost: 'Home-only energy benchmark', publicPremium: 'Extra versus home-only benchmark', mixSummary: 'Normalized home / AC / DC mix:', normalizedMix: 'entered shares were normalized to 100%', privacy: 'Educational estimate only. It does not quote a utility or charging network and excludes home-equipment installation. Verify current tariffs and station fees before charging.'
    },
  },
  zh: {
    currency: 'TWD' as const,
    distanceUnit: 'km' as const,
    defaults: { annualDistance: 15000, efficiency: 16.5, chargingLoss: 10, homeShare: 75, publicAcShare: 10, publicDcShare: 15, homeRate: 3.2, publicAcRate: 8, publicDcRate: 12, monthlyMembership: 199, annualSessionFees: 0 },
    copy: {
      heading: '電動車家充／公共快充每公里成本計算器',
      intro: '請換成台電帳單、社區與充電業者實際費率。占比依序為家充／公共 AC／DC 快充的「充電度數」，不是充電次數。',
      annualDistance: '每年行駛公里', efficiency: '車輛耗電（kWh/100km）', chargingLoss: '充電損耗（%）', homeShare: '家充度數占比（%）', publicAcShare: '公共 AC 度數占比（%）', publicDcShare: 'DC 快充度數占比（%）', homeRate: '家充電價（NT$/度）', publicAcRate: '公共 AC（NT$/度）', publicDcRate: 'DC 快充（NT$/度）', monthlyMembership: '充電會員月費（NT$/月）', annualSessionFees: '啟動、停車與占位費（NT$/年）', annualCost: '一年充電總成本', costPerDistance: '每公里充電成本', effectiveRate: '加權能源單價', batteryEnergy: '實際進入電池電量', gridEnergy: '電表／充電網路計費電量', homeOnlyCost: '全部家充能源基準', publicPremium: '相較全部家充多付', mixSummary: '正規化家充／AC／DC 占比：', normalizedMix: '輸入占比已按比例換算為 100%', privacy: '一般教育試算，不代表台電或任何充電業者報價，也不含家充工程。充電前請查核最新帳單、APP 與場站費率。'
    },
  },
};

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as EditorialLocale;
const article = articles[locale];
const guide = evChargingCostGuides[locale]!;
const calculator = calculators[locale];
---

<ArticleLayout title={article.title} description={article.description} locale={locale} updated={locale === 'zh' ? '2026-09-15' : '2026-07-19'} alternateLocales={['en', 'zh']}
  trustBlock={trustBlockFromDecisionGuide(guide, locale)}>
  {locale === 'en' && <>
    <p>“How much does an EV cost per mile?” has no defensible answer until the charging mix is known. A driver who can charge overnight at home and a renter who relies on highway DC stations can own the same car yet pay very different energy costs.</p>
    <p>The useful unit is the price of one mile under a stated mix: vehicle efficiency, charging loss, kWh share by channel and every fee caused by charging. The calculator keeps those assumptions visible so a search or answer engine can quote the conditions with the result.</p>
    <DecisionGuide content={guide} />
    <EVChargingCostCalculator locale={locale} {...calculator} />

    <h2>Use marginal home electricity cost, not an average bill</h2>
    <p>The Department of Energy’s home-charging guidance identifies electricity price and vehicle efficiency as the core cost-per-mile inputs. Read the utility tariff and determine which additional kWh the vehicle will occupy: off-peak time-of-use, a higher consumption tier or a separate EV plan. Taxes or riders that increase with kWh belong in the rate; the fixed household charge usually does not unless the EV causes it.</p>
    <p>Do not use a promotional “from” rate without its hours, season, demand terms and enrollment cost. A smart-charging schedule can move energy to a lower period, but only if the car is actually connected then.</p>

    <h2>Weight public charging by kWh, not by visits</h2>
    <p>A ten-minute DC stop may deliver more energy than several workplace sessions. Export session history when possible and divide annual kWh among home, public AC and DC fast charging. DOE notes that drivers normally pay more at public stations—especially DC fast chargers—than at home, but the exact account price still controls.</p>
    <p>Record membership, connection, parking and idle charges separately. A $10 monthly plan adds $120 even before one kWh is delivered; compare that fee with the discount it actually earns over paid public energy.</p>

    <h2>Keep battery consumption and charging loss on different sides of the meter</h2>
    <p>Rated or dashboard kWh/100 miles commonly describes energy the vehicle uses. The electricity bill measures energy drawn. Cable, power electronics, battery temperature management and standby use create a gap, so this model adds a loss rate once. If your own wall-meter calculation already includes that gap, set loss to zero.</p>
    <p>The base result of $0.093 per mile is not a U.S. average. It is the output of the published $0.16 / $0.30 / $0.55 rates and 70% / 10% / 20% mix. Change any of them before comparing the result with gasoline or a reimbursement rate.</p>

    <h2>Move the charging result into total vehicle cost</h2>
    <p>Energy cost is only one line of ownership. Add charger installation, purchase price, insurance, maintenance, taxes and resale in the <a href="/en/ev-vs-gas-total-cost/">EV versus gas total-cost guide</a>. A cheap mile does not automatically recover a large purchase premium.</p>
    <p class="privacy-note">General educational estimate only. It is not a utility quote, charging-network offer, vehicle recommendation or reimbursement rule.</p>
  </>}

  {locale === 'zh' && <>
    <p>搜尋「充電樁一度電多少錢」「充電樁電費」或「家用充電樁電費」時，最容易看到的錯誤是把一個公共價格當成所有人的答案。真正可比較的結果要公開車輛 kWh/100km、每月里程、家用契約單價與公共業者的實際牌價。</p>
    <TWChargingCostCalculator />
    <p>下方計算機用台電現行電價表與 U-POWER 公開費率作為可編輯起點，不代表你的契約或每一個場站。家充與公共充電的差異，還要把家充設備／工程一次性成本與公共端的停車、占位、會員或啟動費分開看。</p>
    <DecisionGuide content={guide} />

    <h2>家充要看新增用電落在哪個電價，不是全戶平均</h2>
    <p>台電現行簡要電價表標示 2025-10-01 起實施；住宅非時間電價 331–500 度級距為夏月 3.80、非夏月 3.13 元／度。簡易型時間電價的尖峰／離峰為夏月 5.16／2.06、非夏月 4.93／1.99 元／度；夏月定義為 6/1–9/30。請從契約與帳單抓因車增加的每度成本，不要把全戶基本費全算給車。</p>
    <p>集合住宅還要確認管委會是否使用公設電、另收管理費或服務加價，以及充電樁電表能否獨立計量。這些是台灣家充試算比單純翻譯國外文章更重要的欄位。</p>

    <h2>公共充電每度多少錢？先看業者與方案</h2>
    <p>U-POWER 官方 FAQ（查核 2026-09-15）列出會員離峰 6.9、尖峰 13.5、假日 8.5，非會員全時 14 元／度；這是該業者的公開牌價說明，不是全台公共充電平均，也不是每個站點必然適用的價格。</p>
    <p>試算時先看 APP 或場站付款確認畫面，再把一年內的啟動、停車及充滿後占位費加總。不要只比較每度單價，卻漏掉停車一小時、月費或工程成本。</p>

    <h2>占比要按充入幾度電，不是去了幾次</h2>
    <p>一次高速公路快充可能補進 45 度，數次商場慢充合計卻不到 20 度。最準確的方法是匯出充電紀錄，以各通路 kWh 除以全年總充電 kWh；還沒有車時，則用平日可家充的里程與長途里程拆分，再做高快充占比情境。</p>
    <p>下方簡化計算機以每月里程直接換算充電度數，避免把「去了幾次」誤當成用電量。若你的車機數字已經是電表到電池的實測結果，就不要再重複加一層充電損耗；請保留測量邊界。</p>

    <h2>把充電成本帶回整台車的五年帳</h2>
    <p>每公里電費低只代表能源支出，不代表電動車總成本低。家充工程、成交價、保險、牌照稅、保養與轉售仍要放進<a href="/zh/ev-vs-gas-total-cost/">電動車和油車五年總持有成本</a>一起比較。</p>
    <p class="privacy-note">一般教育試算，不是台電、管委會或充電業者報價，也不是購車建議。費率與場站條款會變動，付款前請再次查核。</p>
  </>}




  <FAQ items={article.faq} />
</ArticleLayout>
