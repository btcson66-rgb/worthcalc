---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import FAQ from '../../components/FAQ.astro';
import MembershipUpgradeCalculator from '../../components/MembershipUpgradeCalculator.astro';
import { localizedPath } from '../../i18n/utils';
import { costcoTw, costcoUs, ntd, percent, perMonth, zhDate } from '../../lib/rates';

type L = 'zh' | 'es' | 'fr' | 'de';

const twGold = costcoTw.tiers.gold_star;
const twExecutive = costcoTw.tiers.executive;
const twRewardRate = twExecutive.reward_rate;
const twDelta = costcoTw.upgrade_delta;
const twBreakeven = costcoTw.breakeven_qualified_spend;
const twMonthly = perMonth(twBreakeven);
const usDelta = costcoUs.upgrade_delta;
const usBreakeven = costcoUs.breakeven_qualified_spend;
const usRewardRate = costcoUs.tiers.executive.reward_rate;
// 歐洲語系用當地的千分位寫法引用美國門檻，只是為了說明「這條線不適用」。
const usBreakevenEs = usBreakeven.toLocaleString('de-DE');
const usBreakevenFr = usBreakeven.toLocaleString('fr-FR');
const usBreakevenDe = usBreakeven.toLocaleString('de-DE');

const meta = {
  zh: {
    title: `好市多${twExecutive.name}值得升級嗎？回本門檻與 ${percent(twRewardRate)} 排除項目`,
    description: `用台灣好市多現行年費與 ${percent(twRewardRate)} 回饋規則計算${twExecutive.name}升級門檻，分清合格消費、稅額、加油站與餐飲部排除項目。`,
    faq: [
      { question: `好市多${twExecutive.name}每月刷多少才回本？`, answer: `以${twExecutive.name} ${ntd(twExecutive.annual_fee)}、${twGold.name} ${ntd(twGold.annual_fee)} 計，升級差額 ${ntd(twDelta)} 除以名目 ${percent(twRewardRate)}，理論上需要每年 ${ntd(twBreakeven)}、每月約 ${ntd(twMonthly)} 的合格未稅消費。因官方先扣除政府課稅，且加油站、餐飲部等不列入，信用卡或發票上的總消費門檻會更高。` },
      { question: `加油與好市多餐飲部有 ${percent(twRewardRate)} ${twExecutive.name}回饋嗎？`, answer: `依台灣好市多目前 FAQ，加油站、西式餐飲部、會員費、政府課稅、停車費、部分服務費等不列入 ${percent(twRewardRate)} 消費回饋。請用官方最新排除清單核對，不要把全部刷卡金額乘以 ${percent(twRewardRate)}。` },
      { question: `${twExecutive.name} ${percent(twRewardRate)} 回饋可以在線上或加油站折抵嗎？`, answer: '官方 FAQ 說明回饋金只能在台灣好市多實體賣場結帳時使用，不能在台灣線上購物或加油站折抵；累積與使用是兩件不同的事。' },
      { question: `剛好每月花 ${ntd(twMonthly)} 就一定該升級嗎？`, answer: '不建議只靠剛好打平的預測升級。退貨、排除品項、稅額與結算期間都會降低實際回饋，應以過去正常年度的合格淨消費計算並保留安全邊際。' },
    ],
  },
  es: {
    title: '¿Existe Costco Executive en España? Cuota, 2% y respuesta para 2026',
    description: `Respuesta directa sobre Costco Executive en España: planes locales publicados, por qué no aplica el umbral estadounidense de ${usBreakevenEs} $ y cómo evaluar la afiliación real.`,
    faq: [
      { question: '¿Hay una membresía Costco Executive en España?', answer: 'La página oficial española consultada el 19 de julio de 2026 publica Gold Star por 36,30 € IVA incluido y Business por 30,25 € IVA incluido, pero no presenta una modalidad Executive local con recompensa del 2%. Compruebe la pantalla de alta antes de pagar por si la oferta cambia.' },
      { question: '¿Las compras en Costco España generan el 2% de una Executive de Estados Unidos?', answer: 'Las condiciones oficiales estadounidenses de Executive consultadas incluyen las compras realizadas en España entre las que no se aplican a esa recompensa. Una tarjeta puede permitir acceso internacional sin convertir la compra española en gasto elegible para el 2% estadounidense.' },
      { question: `¿Debo usar el umbral de ${usBreakevenEs} dólares en España?`, answer: `No para una afiliación española. Ese umbral compara ${usDelta} $ de sobrecuota y un ${percent(usRewardRate)} de recompensa del programa estadounidense. España publica otras cuotas y no publica esa mejora local; mezclar monedas, planes y reglas produciría una conclusión falsa.` },
      { question: '¿Cómo sé si Gold Star España compensa?', answer: 'Compare una cesta equivalente con sus tiendas habituales, reste merma y compras no previstas, añada desplazamiento y divida cuota más costes extra por su ahorro medido. La calculadora local de WorthCalc permite modificar todos esos supuestos.' },
    ],
  },
  fr: {
    title: 'La carte Costco Executive existe-t-elle en France ? Réponse et calcul 2026',
    description: 'Vérifiez l’offre Costco France, l’adhésion Privilège à 36 €, l’absence d’un palier Executive local publié et pourquoi le seuil américain ne s’applique pas.',
    faq: [
      { question: 'Costco propose-t-il une carte Executive en France ?', answer: 'L’offre officielle française vérifiée le 19 juillet 2026 publie notamment l’adhésion annuelle Membre Privilège à 36 € TTC, sans présenter un palier Executive français assorti d’une récompense de 2 %. Vérifiez toujours l’écran d’adhésion au moment de souscrire.' },
      { question: 'Les achats en France comptent-ils pour le 2 % Executive américain ?', answer: 'Les règles officielles américaines consultées indiquent que les achats effectués en France ne s’appliquent pas à cette récompense Executive. L’accès international d’une carte ne signifie donc pas que chaque achat étranger est admissible au 2 %.' },
      { question: `Le seuil de ${usBreakevenFr} dollars est-il valable en France ?`, answer: `Non pour une adhésion française. Il résulte de ${usDelta} $ de surcotisation divisés par ${percent(usRewardRate)} dans le programme américain. Sans surcotisation Executive locale et sans récompense locale publiée, recopier ce seuil en euros serait trompeur.` },
      { question: 'Comment tester la rentabilité de l’adhésion Privilège ?', answer: 'Mesurez l’écart sur un panier réellement comparable, retirez pertes et achats supplémentaires, puis ajoutez trajet, péage et stockage. Le calculateur Costco France de WorthCalc sépare ces éléments au lieu de supposer un pourcentage d’économie universel.' },
    ],
  },
  de: {
    title: 'Gibt es Costco Executive in Deutschland? Standorte und 2%-Bonus 2026',
    description: 'Klare Antwort zu Costco Executive Deutschland: keine deutschen Lagerhäuser im offiziellen Standortbericht, kein lokaler Executive-Tarif und keine falsche Euro-Umrechnung.',
    faq: [
      { question: 'Gibt es Costco-Filialen in Deutschland?', answer: 'In Costcos offiziellem Standortbericht vom Mai 2026 wird Deutschland nicht als Land mit einem Lagerhaus aufgeführt. Die Liste nennt unter anderem fünf Standorte in Spanien und drei in Frankreich. Prüfen Sie den aktuellen Standortfinder erneut, bevor Sie eine Reise planen.' },
      { question: 'Kann man Costco Executive in Deutschland abschließen?', answer: 'Mangels deutschem Costco-Angebot gibt es derzeit auch keinen veröffentlichten deutschen Executive-Tarif mit 2%-Bonus. Eine US-Mitgliedschaft ist ein ausländischer Vertrag und darf nicht als lokal verfügbares deutsches Produkt beschrieben werden.' },
      { question: `Gilt die US-Schwelle von ${usBreakevenDe} Dollar in Deutschland?`, answer: `Nein. Sie entsteht aus ${usDelta} US-Dollar Mehrbeitrag geteilt durch ${percent(usRewardRate)} im US-Programm. Ohne deutschen Mehrbeitrag, lokalen Bonussatz und deutsche berechtigte Umsätze liefert eine Umrechnung in Euro nur Scheingenauigkeit.` },
      { question: 'Wann kann sich eine Costco-Mitgliedschaft für Deutsche trotzdem lohnen?', answer: 'Nur bei einer realistischen Auslandsnutzung. Rechnen Sie Mitgliedsbeitrag, komplette Zusatzfahrt, Maut, Zeit, Lagerung und Verderb gegen den gemessenen Preisvorteil ohnehin geplanter Käufe. Eine Einkaufsreise, die erst durch den Bonus ausgelöst wird, ist kein Vorteil.' },
    ],
  },
} satisfies Record<L, { title: string; description: string; faq: { question: string; answer: string }[] }>;

export function getStaticPaths() { return (['zh', 'es', 'fr', 'de'] as const).map((locale) => ({ params: { locale } })); }
const locale = Astro.params.locale as L;
const page = meta[locale];
---

<ArticleLayout title={page.title} description={page.description} locale={locale} updated="2026-07-19" alternateLocales={['en', 'zh', 'es', 'fr', 'de']}>
  {locale === 'zh' && (
    <>
      <p class="direct-answer"><strong>直接答案：</strong>以台灣好市多官網目前刊載年費計算，{twExecutive.name}比{twGold.name}多 {ntd(twDelta)}；名目 {percent(twRewardRate)} 的理論升級門檻是每年 {ntd(twBreakeven)}、每月約 {ntd(twMonthly)} 的<strong>合格未稅消費</strong>。加油站、餐飲部、會員費、稅額等不列入，所以發票總額要高於這條線才可能真正回本。</p>

      <MembershipUpgradeCalculator
        locale="zh-TW"
        currency="TWD"
        extraFee={twDelta}
        monthlySpend={7000}
        rewardRate={twRewardRate * 100}
        copy={{
          heading: `${twExecutive.name}升級回本計算機`, intro: `只填可累積 ${percent(twRewardRate)} 的未稅淨消費；不要把加油、餐飲部、會員費、退貨與官方排除項目算進去。`,
          extraFee: '每年升級差額', extraFeeHelp: `${twExecutive.name}年費減去你原本會續的基本會員年費。`, monthlySpend: '每月合格未稅消費', monthlySpendHelp: '以正常年度估算，扣除退貨、政府課稅與官方排除項目。',
          rewardRate: '增量回饋率（%）', rewardRateHelp: `目前名目回饋為 ${percent(twRewardRate)}，條款可能調整。`, extraBenefits: '其他可量化年價值', extraBenefitsHelp: '只有原本會付費使用、且能提出金額的升級專屬權益才填入。',
          verdictLabel: '升級判斷', annualReward: '估計年度回饋', netValue: '扣除升級費後淨值', breakEven: '每月合格消費門檻', favorable: '依這組數字，升級一年多出 {net}；仍要確認結算期與最新排除項目。', unfavorable: '依這組數字，升級一年少 {net}；約需每月 {threshold} 合格消費才打平。',
        }}
      />

      <h2>為什麼 {ntd(twMonthly)} 只是理論下限</h2>
      <p>公式是「升級差額 ÷ 增量回饋率」。{ntd(twDelta)} ÷ {percent(twRewardRate)} = {ntd(twBreakeven)}，再除以 12 得約 {ntd(twMonthly)}。但台灣好市多說明，{percent(twRewardRate)} 回饋要先扣除政府課稅；會員費、加油站、西式餐飲部、停車、運費與部分服務也被排除。因此請從 App 或消費紀錄整理真正合格的淨額，而不是拿聯名卡帳單總額直接乘 {percent(twRewardRate)}。</p>
      <table>
        <thead><tr><th>每月合格未稅消費</th><th>名目年回饋</th><th>扣除 {ntd(twDelta)} 升級差額</th></tr></thead>
        <tbody>
          {[twMonthly * 0.6, twMonthly, twMonthly * 1.6].map((monthly) => {
            const reward = monthly * 12 * twRewardRate;
            const net = reward - twDelta;
            return (
              <tr>
                <td>{ntd(monthly)}</td>
                <td>{ntd(reward)}</td>
                <td>{Math.abs(net) < 1 ? '打平' : `${net > 0 ? '+' : '-'}${ntd(Math.abs(net))}`}</td>
              </tr>
            );
          })}
        </tbody>
      </table>

      <h2>先分開「會員值得」與「升級值得」</h2>
      <p>{twGold.name}本身值不值得，要比較年費、車程、耗損與相同商品在其他通路的實際價差；{twExecutive.name}值不值得，則只比較多付的年費與多得到的回饋。先用<a href={localizedPath(locale, '/costco-math')}>好市多會員數學指南</a>判斷基本會員，再用本頁計算升級，才能避免把同一份省錢效益算兩次。</p>

      <h2>升級前的四項查核</h2>
      <ol><li>用完整正常年度，不把家電或節慶採購直接年化。</li><li>扣掉退貨、稅額與官方排除品項，並對照你的回饋結算期間。</li><li>門檻附近視為打平；至少測一次消費少 20% 的情境。</li><li>不要為了 {percent(twRewardRate)} 多買：多花 {ntd(1000)} 只多 {ntd(1000 * twRewardRate)} 回饋，現金仍少 {ntd(1000 * (1 - twRewardRate))}。</li></ol>

      <h2>資料來源</h2>
      <ul class="source-list"><li><a href={costcoTw.source}>台灣好市多—{twGold.name}與{twExecutive.name}方案、官網刊載年費</a></li><li><a href="https://www.costco.com.tw/CustomerServiceFAQExecutiveMembership2">台灣好市多—2% 回饋算法、排除項目、結算與使用方式</a></li></ul>
      <p class="last-verified"><small>最後查核：{zhDate(costcoTw.checked)}。費率、上限、結算期與排除項目可能調整，續卡或升級前請再看官方頁面。</small></p>
    </>
  )}

  {locale === 'es' && (
    <>
      <p class="direct-answer"><strong>Respuesta directa:</strong> la oferta oficial de Costco España consultada el 19 de julio de 2026 muestra Gold Star por 36,30 € IVA incluido y Business por 30,25 € IVA incluido, pero no una modalidad Executive española con recompensa del 2 %. Por tanto, el umbral estadounidense de {usBreakevenEs} $ no sirve para decidir una afiliación local.</p>

      <h2>Qué publica Costco España ahora</h2>
      <table><thead><tr><th>Modalidad publicada</th><th>Cuota anual</th><th>Uso indicado</th></tr></thead><tbody><tr><td>Gold Star</td><td>36,30 € IVA incluido</td><td>Uso individual; tarjeta adicional gratuita</td></tr><tr><td>Business</td><td>30,25 € IVA incluido</td><td>Negocios y empresas; requisitos aplicables</td></tr><tr><td>Executive con 2%</td><td>No publicada localmente</td><td>No inventar una cuota o recompensa española</td></tr></tbody></table>
      <p>Business no es una «Executive barata»: responde a otra elegibilidad y finalidad. La decisión correcta compara el plan que realmente puede contratar con el valor que obtiene, no el nombre de una tarjeta de otro país.</p>

      <h2>Por qué {usBreakevenEs} dólares no se convierten a euros</h2>
      <p class="formula"><strong>Umbral de una mejora = sobrecuota anual ÷ recompensa incremental.</strong></p>
      <p>En Estados Unidos, {usDelta} $ ÷ {percent(usRewardRate)} produce {usBreakevenEs} $ de gasto elegible. España no publica esa sobrecuota ni ese {percent(usRewardRate)} local, por lo que cambiar el símbolo de dólar por euro no arregla el problema. Además, las condiciones estadounidenses de Executive indican que las compras efectuadas en España no se aplican a su recompensa del 2%. Acceso mundial y acumulación de recompensa son derechos distintos.</p>

      <h2>La pregunta útil para un residente en España</h2>
      <p>Pregunte si Gold Star recupera 36,30 € con compras que ya estaban previstas. Prepare una cesta ponderada con marcas, formatos y unidades comparables; reste desperdicio y compras impulsivas; añada combustible, peaje y almacenamiento. Después pruebe un ahorro menor. La <a href={localizedPath(locale, '/tools/costco-membership')}>calculadora Costco España</a> parte de la cuota local y deja editar todos esos factores.</p>
      <ol><li>No cuente como ahorro una unidad que caduca o que no habría comprado.</li><li>No use precios promocionales de una sola visita como promedio anual.</li><li>Si vive lejos de uno de los cinco almacenes publicados, valore todo el desplazamiento.</li><li>Un resultado pequeño es un empate práctico: disponibilidad y tiempo pueden dominarlo.</li></ol>

      <h2>Fuentes</h2>
      <ul class="source-list"><li><a href="https://www.costco.es/sobre-nosotros">Costco España—modalidades Gold Star y Business, cuotas y almacenes</a></li><li><a href="https://customerservice.costco.com/app/answers/detail/a_id/1205/">Costco EE. UU.—condiciones Executive, recompensa y compras extranjeras no elegibles</a></li></ul>
      <p class="last-verified"><small>Última comprobación: 19 de julio de 2026. Verifique la oferta y las condiciones visibles al contratar o renovar; esta página no afirma que una modalidad ausente hoy nunca pueda lanzarse.</small></p>
    </>
  )}

  {locale === 'fr' && (
    <>
      <p class="direct-answer"><strong>Réponse directe :</strong> l’offre Costco France vérifiée le 19 juillet 2026 publie l’adhésion annuelle Membre Privilège à 36 € TTC, mais pas un palier Executive français avec récompense de 2 %. Le seuil américain de {usBreakevenFr} $ ne doit donc ni être converti en euros ni présenté comme une règle française.</p>

      <h2>Ce que l’offre française permet réellement de comparer</h2>
      <table><thead><tr><th>Élément</th><th>Situation publiée</th><th>Conséquence</th></tr></thead><tbody><tr><td>Membre Privilège</td><td>36 € TTC par an</td><td>Tester la valeur de l’accès et des économies réelles</td></tr><tr><td>Adhésion professionnelle</td><td>Offre destinée aux achats professionnels</td><td>Ne pas la confondre avec une montée en gamme à 2%</td></tr><tr><td>Executive France</td><td>Palier local à 2% non publié</td><td>Aucune surcotisation locale à amortir</td></tr></tbody></table>
      <p>Une carte valable dans plusieurs pays peut donner accès à un club sans reprendre chaque avantage du pays d’origine. Les conditions Executive américaines consultées excluent notamment les achats réalisés en France du calcul de leur récompense de 2 %.</p>

      <h2>Pourquoi le calcul américain ne répond pas à la question française</h2>
      <p class="formula"><strong>Seuil d’une montée en gamme = surcotisation annuelle ÷ taux de récompense supplémentaire.</strong></p>
      <p>Le chiffre de {usBreakevenFr} $ vient de {usDelta} $ divisés par {percent(usRewardRate)} aux États-Unis. En France, ni cette surcotisation ni ce taux Executive local ne sont publiés. Convertir uniquement la devise fabriquerait une précision sans produit correspondant. Si une nouvelle formule apparaît un jour, reprenez sa vraie différence de cotisation, ses exclusions et sa période de calcul.</p>

      <h2>Tester plutôt la rentabilité de l’adhésion Privilège</h2>
      <p>Comparez un panier strictement équivalent avec les enseignes que vous auriez utilisées. Ajoutez carburant, péage, temps, stockage et pertes sur grands formats. La <a href={localizedPath(locale, '/tools/costco-membership')}>calculatrice Costco France</a> utilise la cotisation locale comme point de départ et permet de réduire le taux d’économie au lieu de supposer un avantage uniforme.</p>
      <ol><li>Mesurez les prix à l’unité sur des produits réellement consommés.</li><li>Retirez retours, pertes et achats déclenchés par la visite.</li><li>Avec peu de clubs-entrepôts, chiffrez le déplacement complet.</li><li>Refaites le test avec une économie plus faible ; une petite marge n’est pas robuste.</li></ol>

      <h2>Sources</h2>
      <ul class="source-list"><li><a href="https://www.costco.fr/c/GOLDSTAR-PRIMARY-CARD/p/9999999">Costco France—adhésion annuelle Membre Privilège à 36 € TTC</a></li><li><a href="https://customerservice.costco.com/app/answers/detail/a_id/1205/">Costco États-Unis—conditions Executive, récompense et achats étrangers non admissibles</a></li></ul>
      <p class="last-verified"><small>Dernière vérification : 19 juillet 2026. Contrôlez le tarif et les conditions affichés lors de l’adhésion ou du renouvellement ; l’absence constatée aujourd’hui n’exclut pas une future évolution de l’offre.</small></p>
    </>
  )}

  {locale === 'de' && (
    <>
      <p class="direct-answer"><strong>Direkte Antwort:</strong> Costco führt Deutschland im offiziellen Standortbericht vom Mai 2026 nicht als Land mit einem Lagerhaus. Entsprechend gibt es keinen veröffentlichten deutschen Executive-Tarif mit 2%-Bonus. Die US-Schwelle von {usBreakevenDe} Dollar ist deshalb keine deutsche Kaufempfehlung und darf nicht einfach in Euro umgerechnet werden.</p>

      <h2>Der aktuelle Status für Deutschland</h2>
      <table><thead><tr><th>Frage</th><th>Veröffentlichter Stand</th><th>Folge für die Rechnung</th></tr></thead><tbody><tr><td>Costco-Lagerhaus in Deutschland</td><td>Keines in der offiziellen Länderliste</td><td>Keine lokale Einkaufsbasis unterstellen</td></tr><tr><td>Executive Deutschland</td><td>Kein lokaler Tarif veröffentlicht</td><td>Keinen deutschen Beitrag oder 2%-Bonus erfinden</td></tr><tr><td>US Executive</td><td>Ausländischer Tarif mit eigenen Regeln</td><td>Nur nach tatsächlichem Vertrag und berechtigten Käufen rechnen</td></tr></tbody></table>
      <p>Costco-Mitgliedskarten können internationale Zugangsrechte haben. Das schafft aber weder ein deutsches Lagerhaus noch einen deutschen Executive-Vertrag. Zugang, Bonusberechtigung und wirtschaftlicher Vorteil sind drei getrennte Fragen.</p>

      <h2>Warum {usBreakevenDe} Dollar keine deutsche Schwelle sind</h2>
      <p class="formula"><strong>Upgrade-Schwelle = zusätzlicher Jahresbeitrag ÷ zusätzlicher Bonussatz.</strong></p>
      <p>Im US-Modell ergeben {usDelta} US-Dollar Mehrbeitrag geteilt durch {percent(usRewardRate)} genau {usBreakevenDe} US-Dollar berechtigten Jahresumsatz. Für Deutschland fehlen beide lokalen Eingaben: Es gibt weder einen veröffentlichten Executive-Mehrbeitrag in Euro noch einen deutschen 2%-Tarif. Eine Wechselkursumrechnung würde Währung, Vertrag, Steuerbehandlung und berechtigte Kauforte vermischen.</p>

      <h2>Die sinnvolle Rechnung bei einer Auslandsfahrt</h2>
      <p>Wer aus Deutschland zu einem Costco in einem anderen Land fährt, sollte den gesamten Zusatzaufwand ansetzen. Die <a href={localizedPath(locale, '/tools/costco-membership')}>deutsche Einkaufsklub-Rechnung</a> berücksichtigt Beitrag, geplanten Monatsumsatz, gemessenen Preisvorteil sowie Fahrt-, Maut-, Lager- und Verderbskosten. Für die Reise gilt:</p>
      <ol><li>Nur ohnehin geplante und tatsächlich verbrauchte Waren zählen als Vergleichsbasis.</li><li>Hin- und Rückfahrt, Maut und zusätzlicher Zeitaufwand vollständig erfassen.</li><li>Preise derselben Marke, Packungsgröße und Mengeneinheit vergleichen.</li><li>Mit niedrigerem Preisvorteil und weniger Fahrten einen Belastungstest rechnen.</li></ol>
      <p>Ist das Ergebnis nur knapp positiv, ist es praktisch ein Gleichstand. Wechselkurse, Sortimentsunterschiede, Rückgaben und eine zusätzliche Fahrt können den kleinen Vorteil aufzehren. Einen Bonus durch Mehrkäufe zu „erreichen“ lohnt nie: 100 Euro zusätzliche Ausgabe für 2 Euro Bonus lassen 98 Euro weniger übrig.</p>

      <h2>Wann der Upgrade-Rechner künftig anwendbar wäre</h2>
      <p>Erst wenn Costco einen deutschen Tarif mit veröffentlichtem Grundbeitrag, höherem Mitgliedsbeitrag, Bonussatz, Ausschlüssen und Abrechnungszeitraum anbietet, lässt sich eine lokale Schwelle berechnen. Dann werden ausschließlich der echte Mehrbeitrag und der Bonus auf berechtigte Nettokäufe verwendet. Bis dahin beantwortet die <a href={localizedPath(locale, '/costco-math')}>Costco-Deutschland-Kostenanalyse</a> die reale Frage besser als ein fiktiver Executive-Rechner.</p>

