---
import GrowthCalculator from '../../../components/GrowthCalculator.astro';
import TWCreditCardCalculator from '../../../components/TWCreditCardCalculator.astro';
import TWMortgageCalculator from '../../../components/TWMortgageCalculator.astro';
import TWDbrCalculator from '../../../components/TWDbrCalculator.astro';
import TWHomeAffordCalculator from '../../../components/TWHomeAffordCalculator.astro';
import TWSalaryCalculator from '../../../components/TWSalaryCalculator.astro';
import TWDebtCalculator from '../../../components/TWDebtCalculator.astro';
import TWCarCalculator from '../../../components/TWCarCalculator.astro';
import TWBudgetCalculator from '../../../components/TWBudgetCalculator.astro';
import { getGrowthToolDefinition, type GrowthToolSlug } from '../../../data/growthToolDefinitions';
import { fallbackTrustBlock } from '../../../lib/trustBlock';
import ToolLayout from '../../../layouts/ToolLayout.astro';
import PaidProductPanel from '../../../components/PaidProductPanel.astro';
import type { Locale } from '../../../consts';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  // Growth tools only. The en and zh core tools are static files under
  // src/pages/en/tools and src/pages/zh/tools; the es/fr/de core-tool routes that
  // used to be listed here were deleted with the retired locales (P1b).
  const growth = (await getCollection('growthTools', ({ data }) => !data.draft)).map((entry) => ({
    params: { locale: entry.data.locale, tool: entry.data.toolSlug },
    props: { growthEntry: entry },
  }));
  return growth;
}

const locale = Astro.params.locale as Locale;
const slug = Astro.params.tool!;
const growthEntry = Astro.props.growthEntry as CollectionEntry<'growthTools'>;
const { Content: GrowthContent } = await render(growthEntry);
const growthDefinition = getGrowthToolDefinition(locale, slug as GrowthToolSlug);
const growthReview = {
  en: { heading: 'Methodology and Limitations', updated: 'Last updated', disclaimer: 'Estimate disclaimer', text: 'Educational scenario estimate only; verify current contracts, rates, taxes and official rules before acting.' },
  zh: { heading: '計算方法與限制', updated: '最後更新', disclaimer: '估算免責聲明', text: '僅供一般教育與情境試算；行動前請核對最新契約、利率、稅費與官方規定。' },
}[locale];
const growthLastReviewed = growthEntry.data.lastReviewed.toISOString().slice(0, 10);
const fallbackBlock = fallbackTrustBlock(locale, growthLastReviewed);
// A tool that carries its own sources (see content.config.ts) gets a trust block
// that lists them; the others keep the generic fallback.
const trustBlock = growthEntry.data.sources?.length
  ? {
    method: growthEntry.data.method ?? fallbackBlock.method,
    formula: growthEntry.data.formula,
    sources: growthEntry.data.sources,
    limits: growthEntry.data.limits ?? fallbackBlock.limits,
    lastReviewed: growthLastReviewed,
    locale,
  }
  : fallbackBlock;
// Taiwan's revolving-interest rules differ from the generic payoff model (15% cap,
// no compounding, a statutory minimum-payment composition), so the zh page runs
// its own calculator.
const useTwCreditCard = locale === 'zh' && slug === 'credit-card-payoff';
// Likewise the mortgage page: 本息/本金平均攤還, 寬限期, 違約金 and the 房貸支出占收入 guide.
const useTwMortgage = locale === 'zh' && slug === 'mortgage-payoff';
// P2 batch 10 (2026-10-18): the US front-end / back-end DTI model is replaced by the two Taiwanese ratios
// (DBR 22 倍 and 房貸月付占收入 1/3, 1/5); en keeps the shared calculator.
const useTwDbr = locale === 'zh' && slug === 'dti-calculator';
// ...and the home-affordability page: 央行 loan ratios, 寬限期 rule, 1/3 line (no PMI, no US DTI).
const useTwHome = locale === 'zh' && slug === 'home-affordability';
// P2 batch 11 (2026-10-18): 勞基法 normal hours, 勞動部 月薪 ÷ 30 ÷ 8, 第 24 條 overtime multiples, 115 年基本工資.
const useTwSalary = locale === 'zh' && slug === 'salary-converter';
// ...and the debt-strategy page: balances, rates and minimum payments from the bills, 銀行法 第 47-1 條 15% flag.
const useTwDebt = locale === 'zh' && slug === 'debt-strategy';
// ...and car-affordability: 使用牌照稅, 公路養管費 and 強制險 from the published tables; no sales tax or registration fee.
const useTwCar = locale === 'zh' && slug === 'car-affordability';
// ...and budget-builder: plain arithmetic on the reader's incomes and annual bills; no rate or bracket built in.
const useTwBudget = locale === 'zh' && slug === 'budget-builder';
---

<ToolLayout
  title={growthEntry.data.title}
  description={growthEntry.data.description}
  locale={locale}
  tool={{ name: growthEntry.data.title }}
  faq={[]}
  related={growthEntry.data.related}
  alternateLocales={['en', 'zh']}
  showReview={false}
  trustBlock={trustBlock}
>
  {useTwCreditCard ? <TWCreditCardCalculator /> : useTwMortgage ? <TWMortgageCalculator /> : useTwDbr ? <TWDbrCalculator /> : useTwHome ? <TWHomeAffordCalculator /> : useTwSalary ? <TWSalaryCalculator /> : useTwDebt ? <TWDebtCalculator /> : useTwCar ? <TWCarCalculator /> : useTwBudget ? <TWBudgetCalculator /> : <GrowthCalculator locale={locale} definition={growthDefinition} />}
  <section class="calculator-review">
    <h2>{growthReview.heading}</h2>
    <p class="last-updated"><strong>{growthReview.updated}:</strong> {growthLastReviewed}</p>
    <p class="estimate-disclaimer"><strong>{growthReview.disclaimer}:</strong> {growthReview.text}</p>
    <div class="prose"><GrowthContent /></div>
  </section>
  {slug === 'salary-converter' && (
    <PaidProductPanel productId="PRODUCT-003" locale={locale} placement={`worthcalc_${locale}_salary_converter`} />
  )}
</ToolLayout>
