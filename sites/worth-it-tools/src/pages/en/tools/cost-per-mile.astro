---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { localizedPath } from '../../../i18n/utils';

const locale = 'en';
const title = 'Cost Per Mile Calculator: Total Car Cost, Not Just Fuel';
const description = 'Calculate total car cost per mile or kilometer, including fuel or electricity, depreciation, maintenance, tires, insurance, fees, and finance interest.';
const faq = [
  {
    question: 'How do I calculate the total cost of driving per mile?',
    answer: 'Add annual depreciation, insurance, registration, finance interest, maintenance, tires, and fuel or electricity, then divide the annual total by annual distance. This calculator keeps the energy-only rate visible beside the all-in rate.',
  },
  {
    question: 'Is fuel cost per mile the same as car cost per mile?',
    answer: 'No. Fuel cost per mile is only fuel price divided by MPG in imperial units, or liters per 100 kilometers multiplied by price per liter and divided by 100 in metric units. Total cost also includes ownership and other running costs.',
  },
  {
    question: 'How is depreciation per mile calculated?',
    answer: 'The calculator subtracts expected resale value from purchase price, divides that loss by years kept, then divides the annual depreciation by annual distance. A higher resale value or longer holding period lowers the modeled annual depreciation.',
  },
  {
    question: 'Can I calculate electric-car cost per mile?',
    answer: 'Yes. Choose electric and enter kWh per 100 miles or kilometers plus price per kWh. The ownership-cost fields still apply, so the result is not limited to charging energy.',
  },
  {
    question: 'Why does driving more lower the total cost per mile?',
    answer: 'Annual fixed costs are spread over more miles or kilometers. Energy cost per distance does not fall in the model, but depreciation, insurance, registration, and finance interest contribute less to each mile as annual distance rises.',
  },
  {
    question: 'Is this a commute cost calculator?',
    answer: 'No. This page estimates one vehicle’s general annual ownership cost per mile or kilometer. It does not model workdays, parking, tolls, transit alternatives, or commute time.',
  },
];
const related = [
  { title: 'Commute Cost Calculator', href: localizedPath(locale, '/tools/commute-cost') },
  { title: 'EV vs Gas Car TCO Calculator', href: localizedPath(locale, '/tools/ev-vs-gas') },
];
---

<ToolLayout title={title} description={description} locale={locale} tool={{ name: title }} faq={faq} related={related} alternateLocales={['en', 'zh']}>
  <p class="intro">
    Find the cost of driving one vehicle per mile or kilometer, including the costs that a fuel-only answer misses. Every value below is editable. The defaults are an illustration of the arithmetic, not current prices, typical costs, or a recommendation for any vehicle.
  </p>

  <div class="calculator-grid">
    <section class="input-panel" aria-labelledby="cost-inputs">
      <h2 id="cost-inputs">Vehicle and annual-cost inputs</h2>

      <fieldset class="switcher">
        <legend>Measurement system</legend>
        <div class="switch-options">
          <label><input id="unit-imperial" type="radio" name="unit-choice" value="imperial" checked /> Imperial <span>(miles, gallons)</span></label>
          <label><input id="unit-metric" type="radio" name="unit-choice" value="metric" /> Metric <span>(kilometers, liters)</span></label>
        </div>
      </fieldset>
      <input id="unit-system" type="hidden" value="imperial" />

      <div class="field primary-field">
        <label for="annual-distance">Annual distance driven (<span class="distance-plural">miles</span>)</label>
        <input id="annual-distance" type="number" inputmode="decimal" min="0" step="100" value="12000" />
      </div>

      <fieldset class="switcher">
        <legend>Powertrain</legend>
        <div class="switch-options">
          <label><input id="powertrain-fuel" type="radio" name="powertrain-choice" value="fuel" checked /> Petrol or diesel</label>
          <label><input id="powertrain-electric" type="radio" name="powertrain-choice" value="electric" /> Electric</label>
        </div>
      </fieldset>
      <input id="powertrain" type="hidden" value="fuel" />

      <div id="fuel-fields" class="input-grid mode-fields">
        <div class="field">
          <label for="fuel-efficiency"><span id="fuel-efficiency-label">Fuel economy (MPG)</span></label>
          <input id="fuel-efficiency" type="number" inputmode="decimal" min="0" step="0.1" value="30" />
        </div>
        <div class="field">
          <label for="fuel-price">Fuel price per <span id="fuel-volume-unit">gallon</span></label>
          <input id="fuel-price" type="number" inputmode="decimal" min="0" step="0.01" value="3.50" />
        </div>
      </div>

      <div id="electric-fields" class="input-grid mode-fields" hidden>
        <div class="field">
          <label for="energy-use">Energy use (kWh per 100 <span class="distance-plural">miles</span>)</label>
          <input id="energy-use" type="number" inputmode="decimal" min="0" step="0.1" value="30" />
        </div>
        <div class="field">
          <label for="electricity-price">Electricity price per kWh</label>
          <input id="electricity-price" type="number" inputmode="decimal" min="0" step="0.01" value="0.16" />
        </div>
      </div>

      <p class="defaults-note">Energy efficiency and prices are editable example defaults only. Enter figures from your vehicle, bills, receipts, and quotes.</p>

      <h3>Annual running costs</h3>
      <div class="input-grid">
        <div class="field">
          <label for="maintenance">Maintenance and repairs per year</label>
          <input id="maintenance" type="number" inputmode="decimal" min="0" step="50" value="800" />
        </div>
        <div class="field">
          <label for="tyres">Tires per year</label>
          <input id="tyres" type="number" inputmode="decimal" min="0" step="25" value="250" />
        </div>
      </div>

      <h3>Annual fixed costs</h3>
      <div class="input-grid">
        <div class="field">
          <label for="insurance">Insurance per year</label>
          <input id="insurance" type="number" inputmode="decimal" min="0" step="50" value="1800" />
        </div>
        <div class="field">
          <label for="registration">Registration, road tax, and inspection per year</label>
          <input id="registration" type="number" inputmode="decimal" min="0" step="25" value="250" />
        </div>
        <div class="field">
          <label for="finance-interest">Finance interest per year (optional)</label>
          <input id="finance-interest" type="number" inputmode="decimal" min="0" step="50" value="0" />
        </div>
      </div>

      <h3>Depreciation</h3>
      <div class="input-grid">
        <div class="field">
          <label for="purchase-price">Purchase price</label>
          <input id="purchase-price" type="number" inputmode="decimal" min="0" step="500" value="32000" />
        </div>
        <div class="field">
          <label for="resale-value">Expected resale value</label>
          <input id="resale-value" type="number" inputmode="decimal" min="0" step="500" value="14000" />
        </div>
        <div class="field">
          <label for="years-kept">Years kept</label>
          <input id="years-kept" type="number" inputmode="decimal" min="0" step="0.5" value="6" />
        </div>
      </div>
    </section>

    <section class="result-panel" aria-live="polite" aria-labelledby="headline-result">
      <p class="eyebrow">Total cost per <span class="distance-singular">mile</span></p>
      <p id="headline-result" class="headline-result">$0.00 per mile</p>
      <p id="fixed-share" class="insight">Enter annual distance and costs to see how fixed costs affect each mile.</p>

      <div class="metric-grid">
        <p class="metric energy-metric">
          <span id="energy-label">Fuel cost per mile</span>
          <strong id="energy-rate">$0.00</strong>
          <small id="energy-formula">Fuel price ÷ MPG</small>
        </p>
        <p class="metric">
          <span>Annual total</span>
          <strong id="annual-total">$0</strong>
          <small>Fixed cost + running cost</small>
        </p>
        <p class="metric">
          <span>Annual fixed cost</span>
          <strong id="fixed-total">$0</strong>
          <small>Depreciation, insurance, registration, finance</small>
        </p>
        <p class="metric">
          <span>Annual running cost</span>
          <strong id="running-total">$0</strong>
          <small>Energy, maintenance, tires</small>
        </p>
        <p class="metric">
          <span>Annual depreciation</span>
          <strong id="depreciation-total">$0</strong>
          <small id="depreciation-formula">(Purchase − resale) ÷ years kept</small>
        </p>
      </div>
      <p id="input-warning" class="warning" hidden></p>
    </section>
  </div>

  <section class="explanation" aria-labelledby="fuel-is-not-total">
    <h2 id="fuel-is-not-total">Why fuel cost per mile is not total cost per mile</h2>
    <p>
      Fuel is only one line. In imperial mode, fuel cost per mile equals price per gallon divided by MPG. For example, if the editable inputs were 3.50 per gallon and 30 MPG, the energy line would be 3.50 ÷ 30 = about 0.117 per mile. That arithmetic says nothing about depreciation, insurance, registration, finance interest, maintenance, or tires. This calculator therefore shows the fuel or electricity rate separately and builds the headline rate from every annual cost you enter.
    </p>
    <p>
      The full formula is: annual fixed cost + annual running cost, divided by annual distance. Fixed cost contains depreciation, insurance, registration or road tax and inspection, and finance interest. Running cost contains fuel or electricity, maintenance and repairs, and tires. Keep each input on the same annual basis. Do not add a loan principal payment as a cost when purchase-price depreciation already represents the vehicle value consumed; only enter the annual interest you want counted.
    </p>

    <h2>How depreciation per mile is derived</h2>
    <p>
      Depreciation is the purchase price minus the resale value you expect to recover, divided by years kept. Depreciation per mile then divides that annual loss by annual miles. It is often the largest single line because buying a vehicle turns cash into an asset that usually loses value, and ignoring that loss makes driving look artificially cheap. The estimate is sensitive to resale value and holding period, so test a conservative resale value and more than one ownership length instead of treating one forecast as certain.
    </p>

    <h2>Why annual distance changes the answer</h2>
    <p>
      A vehicle driven 5,000 miles a year and the same vehicle driven 20,000 miles a year can have very different total costs per mile even when insurance, registration, and annual depreciation are unchanged. At 20,000 miles, those fixed dollars are spread over four times as many miles. Fuel or electricity still grows with distance, and real maintenance or resale may also change with use, but the fixed-cost contribution to each mile falls. The generated sentence above reports your current fixed-cost share so this effect is visible rather than buried in the total.
    </p>

    <h2>What changes for an electric vehicle</h2>
    <p>
      Electric mode replaces gallons and MPG with kWh per 100 miles or kilometers and price per kWh. Energy cost per distance is kWh per 100 distance multiplied by the electricity price, divided by 100. Purchase price, resale value, insurance, registration, finance, maintenance, and tires remain editable because an EV still has ownership costs. This page deliberately excludes parking, tolls, commute time, tax incentives, emissions, inflation, the opportunity cost of cash, charger installation, and battery replacement unless you deliberately include an expected amount in one of your own cost inputs.
    </p>

    <h2>Choose the calculator that matches the question</h2>
    <p>
      Use this page when the question is “what does this vehicle cost per mile?” It models one vehicle over a year and does not assume workdays or a particular trip. For the cost of getting to work—including workdays, parking, tolls, transit, rideshare, cycling, and optional time value—use the <a href={localizedPath(locale, '/tools/commute-cost')}>commute cost calculator</a>. To compare two different vehicles across purchase price, incentives, resale, and a multi-year ownership period, use the <a href={localizedPath(locale, '/tools/ev-vs-gas')}>EV vs gas total-cost calculator</a>. Keeping those questions separate avoids counting a general ownership cost as if it were only a commuting expense.
    </p>
  </section>

  <style>
    .intro,
    .defaults-note,
    .explanation,
    .metric small {
      color: var(--color-muted);
    }

    .calculator-grid,
    .input-grid,
    .metric-grid {
      display: grid;
      gap: 1rem;
    }

    .input-panel,
    .result-panel,
    .explanation {
      min-width: 0;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      background: var(--color-surface);
      padding: 1rem;
      box-shadow: var(--shadow-soft);
    }

    .input-panel h3 {
      margin: 1.4rem 0 0.7rem;
    }

    .switcher {
      min-width: 0;
      margin: 0 0 1rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: 0.75rem;
    }

    .switcher legend,
    .field label {
      font-weight: 650;
    }

    .switch-options {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .switch-options label {
      display: inline-flex;
      flex: 1 1 12rem;
      align-items: center;
      gap: 0.4rem;
      min-height: 2.75rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      background: var(--color-bg);
      padding: 0.5rem 0.75rem;
      cursor: pointer;
    }

    .switch-options label:has(input:checked) {
      border-color: var(--color-primary);
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-primary) 20%, transparent);
    }

    .switch-options input {
      width: 1.1rem;
      height: 1.1rem;
      margin: 0;
    }

    .field label {
      display: block;
      margin-bottom: 0.3rem;
    }

    .primary-field,
    .mode-fields,
    .defaults-note {
      margin-bottom: 1rem;
    }

    .defaults-note {
      margin-top: -0.35rem;
      font-size: 0.9rem;
    }

    .result-panel {
      position: sticky;
      top: 1rem;
    }

    .eyebrow {
      margin: 0;
      color: var(--color-muted);
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .headline-result {
      margin: 0.2rem 0 0.8rem;
      color: var(--color-primary);
      font-size: clamp(1.8rem, 7vw, 2.7rem);
      font-weight: 800;
      line-height: 1.1;
      overflow-wrap: anywhere;
    }

    .insight,
    .warning {
      border-left: 4px solid var(--color-primary);
      border-radius: var(--radius);
      background: var(--color-bg);
      padding: 0.75rem;
    }

    .metric {
      margin: 0;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      background: var(--color-bg);
      padding: 0.75rem;
    }

    .metric span,
    .metric strong,
    .metric small {
      display: block;
    }

    .metric span,
    .metric small {
      font-size: 0.9rem;
    }

    .metric strong {
      font-size: 1.15rem;
    }

    .energy-metric {
      border-color: var(--color-primary);
    }

    .warning {
      border-left-color: #b45309;
    }

    @media (min-width: 760px) {
      .calculator-grid {
        grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
        align-items: start;
      }

      .input-grid,
      .metric-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 420px) {
      .switch-options,
      .switch-options label {
        width: 100%;
      }

      .result-panel {
        position: static;
      }
    }
  </style>

  <script>
    import { bindPersistentField } from '../../../lib/storage';

    type UnitSystem = 'imperial' | 'metric';
    type Powertrain = 'fuel' | 'electric';

    const kilometersPerMile = 1.609344;
    const litersPerGallon = 3.785411784;
    const efficiencyConversion = 235.214583;
    const ids = [
      'unit-system',
      'powertrain',
      'annual-distance',
      'fuel-efficiency',
      'fuel-price',
      'energy-use',
      'electricity-price',
      'maintenance',
      'tyres',
      'insurance',
      'registration',
      'purchase-price',
      'resale-value',
      'years-kept',
      'finance-interest',
    ];
    const inputs = ids.map((id) => byId<HTMLInputElement>(id));
    const unitField = byId<HTMLInputElement>('unit-system');
    const powertrainField = byId<HTMLInputElement>('powertrain');
    const unitRadios = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="unit-choice"]'));
    const powertrainRadios = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="powertrain-choice"]'));

    function byId<T extends HTMLElement>(id: string): T {
      const element = document.getElementById(id);
      if (!element) throw new Error(`Missing #${id}`);
      return element as T;
    }

    function value(id: string): number {
      const parsed = Number(byId<HTMLInputElement>(id).value);
      return Number.isFinite(parsed) ? parsed : 0;
    }

    function positive(id: string): number {
      return Math.max(0, value(id));
    }

    function currentUnit(): UnitSystem {
      return unitField.value === 'metric' ? 'metric' : 'imperial';
    }

    function currentPowertrain(): Powertrain {
      return powertrainField.value === 'electric' ? 'electric' : 'fuel';
    }

    function setValue(id: string, nextValue: number, fractionDigits = 2): void {
      const input = byId<HTMLInputElement>(id);
      const formatted = Number.isFinite(nextValue) ? nextValue.toFixed(fractionDigits).replace(/\.?0+$/, '') : '0';
      input.value = formatted || '0';
      input.dispatchEvent(new Event('input'));
    }

    function formatMoney(amount: number, fractionDigits = 0): string {
      return new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        minimumFractionDigits: fractionDigits,
        maximumFractionDigits: fractionDigits,
      }).format(Number.isFinite(amount) ? amount : 0);
    }

    function formatNumber(amount: number, fractionDigits = 0): string {
      return new Intl.NumberFormat('en-US', {
        minimumFractionDigits: fractionDigits,
        maximumFractionDigits: fractionDigits,
      }).format(Number.isFinite(amount) ? amount : 0);
    }

    function energyRate(): number {
      if (currentPowertrain() === 'electric') {
        return (positive('energy-use') * positive('electricity-price')) / 100;
      }
      const efficiency = positive('fuel-efficiency');
      if (efficiency <= 0) return 0;
      return currentUnit() === 'imperial'
        ? positive('fuel-price') / efficiency
        : (efficiency * positive('fuel-price')) / 100;
    }

    function applyPowertrain(): void {
      const powertrain = currentPowertrain();
      (['fuel', 'electric'] as Powertrain[]).forEach((candidate) => {
        const container = byId<HTMLElement>(`${candidate}-fields`);
        const active = candidate === powertrain;
        container.hidden = !active;
        container.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
          input.disabled = !active;
        });
      });
      powertrainRadios.forEach((radio) => {
        radio.checked = radio.value === powertrain;
      });
    }

    function applyUnitLabels(): void {
      const unit = currentUnit();
      const singular = unit === 'imperial' ? 'mile' : 'kilometer';
      const plural = unit === 'imperial' ? 'miles' : 'kilometers';
      document.querySelectorAll<HTMLElement>('.distance-singular').forEach((element) => {
        element.textContent = singular;
      });
      document.querySelectorAll<HTMLElement>('.distance-plural').forEach((element) => {
        element.textContent = plural;
      });
      byId<HTMLElement>('fuel-efficiency-label').textContent = unit === 'imperial'
        ? 'Fuel economy (MPG)'
        : 'Fuel use (L/100 km)';
      byId<HTMLElement>('fuel-volume-unit').textContent = unit === 'imperial' ? 'gallon' : 'liter';
      unitRadios.forEach((radio) => {
        radio.checked = radio.value === unit;
      });
    }

    function convertUnit(from: UnitSystem, to: UnitSystem): void {
      if (from === to) return;
      const toMetric = to === 'metric';
      setValue('annual-distance', toMetric ? positive('annual-distance') * kilometersPerMile : positive('annual-distance') / kilometersPerMile, 0);
      const fuelEfficiency = positive('fuel-efficiency');
      setValue('fuel-efficiency', fuelEfficiency > 0 ? efficiencyConversion / fuelEfficiency : 0, 2);
      setValue('fuel-price', toMetric ? positive('fuel-price') / litersPerGallon : positive('fuel-price') * litersPerGallon, 3);
      setValue('energy-use', toMetric ? positive('energy-use') / kilometersPerMile : positive('energy-use') * kilometersPerMile, 2);
    }

    function update(): void {
      const unit = currentUnit();
      const powertrain = currentPowertrain();
      const distance = positive('annual-distance');
      const distanceName = unit === 'imperial' ? 'mile' : 'kilometer';
      const distancePlural = unit === 'imperial' ? 'miles' : 'kilometers';
      const rate = energyRate();
      const years = positive('years-kept');
      const depreciableAmount = Math.max(0, positive('purchase-price') - positive('resale-value'));
      const depreciation = years > 0 ? depreciableAmount / years : 0;
      const fixed = depreciation + positive('insurance') + positive('registration') + positive('finance-interest');
      const energyAnnual = rate * distance;
      const running = energyAnnual + positive('maintenance') + positive('tyres');
      const annual = fixed + running;
      const totalRate = distance > 0 ? annual / distance : 0;
      const fixedShare = annual > 0 ? (fixed / annual) * 100 : 0;
      const fixedPerDistance = distance > 0 ? fixed / distance : 0;

      byId<HTMLElement>('headline-result').textContent = `${formatMoney(totalRate, 2)} per ${distanceName}`;
      byId<HTMLElement>('energy-label').textContent = `${powertrain === 'electric' ? 'Energy' : 'Fuel'} cost per ${distanceName}`;
      byId<HTMLElement>('energy-rate').textContent = `${formatMoney(rate, 3)} per ${distanceName}`;
      byId<HTMLElement>('annual-total').textContent = formatMoney(annual);
      byId<HTMLElement>('fixed-total').textContent = formatMoney(fixed);
      byId<HTMLElement>('running-total').textContent = formatMoney(running);
      byId<HTMLElement>('depreciation-total').textContent = formatMoney(depreciation);
      byId<HTMLElement>('depreciation-formula').textContent = years > 0
        ? `${formatMoney(depreciableAmount)} value loss ÷ ${formatNumber(years, years % 1 === 0 ? 0 : 1)} years`
        : 'Enter years kept above zero';

      if (powertrain === 'electric') {
        byId<HTMLElement>('energy-formula').textContent = `${formatNumber(positive('energy-use'), 1)} kWh/100 ${distancePlural} × ${formatMoney(positive('electricity-price'), 3)} ÷ 100`;
      } else if (unit === 'imperial') {
        byId<HTMLElement>('energy-formula').textContent = `${formatMoney(positive('fuel-price'), 3)} per gallon ÷ ${formatNumber(positive('fuel-efficiency'), 1)} MPG`;
      } else {
        byId<HTMLElement>('energy-formula').textContent = `${formatNumber(positive('fuel-efficiency'), 1)} L/100 km × ${formatMoney(positive('fuel-price'), 3)} per liter ÷ 100`;
      }

      const insight = byId<HTMLElement>('fixed-share');
      insight.textContent = distance > 0 && annual > 0
        ? `At ${formatNumber(distance)} ${distancePlural} per year, fixed costs are ${formatNumber(fixedShare, 1)}% of the annual total and contribute ${formatMoney(fixedPerDistance, 2)} to each ${distanceName}. More distance spreads that fixed amount across more ${distancePlural}; it does not make energy free.`
        : `Enter annual distance and costs to see how fixed costs affect each ${distanceName}.`;

      const warning = byId<HTMLElement>('input-warning');
      const messages: string[] = [];
      if (distance <= 0) messages.push('Annual distance must be above zero for a per-distance result.');
      if (years <= 0) messages.push('Years kept must be above zero to calculate depreciation.');
      if (positive('resale-value') > positive('purchase-price')) messages.push('Resale value exceeds purchase price, so modeled depreciation is capped at zero.');
      if (powertrain === 'fuel' && positive('fuel-efficiency') <= 0) messages.push('Fuel economy must be above zero to calculate fuel cost.');
      warning.hidden = messages.length === 0;
      warning.textContent = messages.join(' ');
    }

    inputs.forEach((input) => {
      bindPersistentField(input, `cost-per-mile:v1:${input.id}`);
      input.addEventListener('input', update);
    });

    unitField.value = currentUnit();
    powertrainField.value = currentPowertrain();
    applyUnitLabels();
    applyPowertrain();

    unitRadios.forEach((radio) => {
      radio.addEventListener('change', () => {
        if (!radio.checked) return;
        const previousUnit = currentUnit();
        const nextUnit: UnitSystem = radio.value === 'metric' ? 'metric' : 'imperial';
        convertUnit(previousUnit, nextUnit);
        unitField.value = nextUnit;
        unitField.dispatchEvent(new Event('input'));
        applyUnitLabels();
        update();
      });
    });

    powertrainRadios.forEach((radio) => {
      radio.addEventListener('change', () => {
        if (!radio.checked) return;
        powertrainField.value = radio.value === 'electric' ? 'electric' : 'fuel';
        powertrainField.dispatchEvent(new Event('input'));
        applyPowertrain();
        update();
      });
    });

    update();
  </script>
</ToolLayout>
