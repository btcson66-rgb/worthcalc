---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { localizedPath } from '../../../i18n/utils';

const locale = 'en';
const title = 'Costco Membership Calculator: Gold Star vs Executive';
const description = 'Compare Gold Star and Executive with a Costco membership calculator that shows the eligible-spend break-even, reward cap, exclusions, and tier math.';
const faq = [
  {
    question: 'How does this Costco Executive membership calculator find the break-even spend?',
    answer: 'It subtracts the Gold Star fee from the Executive fee, then divides that extra fee by the reward rate you enter. The result is eligible annual spend, not total Costco spend. The calculator also checks whether the entered reward cap is high enough for the upgrade ever to recover its extra fee.',
  },
  {
    question: 'Which purchases count toward the Executive reward?',
    answer: 'Under the U.S. terms verified August 5, 2026, the reward is approximately 2% of qualifying pre-tax purchases after refunds. Most merchandise bought through eligible U.S. and Canadian Costco channels can count for U.S. and Canadian residents, but only purchases by the Primary and active Primary Household Cardholder apply. Check the current terms because exclusions can change.',
  },
  {
    question: 'What does not count toward the Costco Executive reward?',
    answer: 'Current U.S. exclusions include gasoline, food-court purchases, membership fees, Costco Shop Cards, shipping, sales tax and other listed fees. Tobacco, alcohol and prescriptions have location-specific exclusions; several third-party services and travel charges are also excluded. Enter only spending that qualifies under your own membership terms.',
  },
  {
    question: 'Is there an annual cap on the Executive reward?',
    answer: 'Yes. Costco\'s U.S. terms verified August 5, 2026 state that the annual 2% Reward is capped at $1,250 in a 12-month period. That published cap is the calculator default, but it remains editable so the math does not silently assume that every market or future membership year uses the same limit.',
  },
  {
    question: 'What if my reward is less than the Executive upgrade fee?',
    answer: 'Costco says the reward is not guaranteed to cover the upgrade fee. Under the U.S. terms verified August 5, 2026, receiving a refund for the current Executive upgrade fee requires canceling or downgrading to Gold Star or Business Membership. Any reward already issued or accrued is subtracted from the refund, and reward above the refund amount is forfeited. Confirm the amount and process with Costco before acting.',
  },
  {
    question: 'Does Executive always beat Gold Star?',
    answer: 'No. The upgrade wins this calculator only when its capped reward exceeds the difference between the two entered fees. Shopping savings affect whether either membership beats having no membership, but they do not make the Executive reward larger.',
  },
];
const related = [
  { title: 'Subscription Audit Calculator', href: localizedPath(locale, '/tools/subscription-audit') },
  { title: 'Cashback Break-even Calculator', href: localizedPath(locale, '/tools/cashback-breakeven') },
  { title: 'Commute Cost Calculator', href: localizedPath(locale, '/tools/commute-cost') },
  { title: 'Latte Factor Calculator', href: localizedPath(locale, '/tools/latte-factor') },
  { title: 'The math of warehouse memberships', href: localizedPath(locale, '/costco-math') },
  { title: 'Is Costco Executive worth it?', href: localizedPath(locale, '/is-costco-executive-membership-worth-it') },
];
---

<ToolLayout title={title} description={description} locale={locale} tool={{ name: title }} faq={faq} related={related} alternateLocales={['en', 'zh', 'es', 'fr', 'de']}>
  <p class="intro">
    A Costco membership decision has two different break-even tests. First, do the price savings on purchases you already planned cover the basic membership fee? Second, does the Executive reward on <em>eligible</em> purchases cover the extra fee over Gold Star? This calculator keeps those questions separate and shows every step.
  </p>

  <aside class="terms-note" aria-label="Published U.S. terms used as calculator defaults">
    <strong>U.S. defaults, verified August 5, 2026:</strong> Gold Star $65 a year, Executive $130 a year, an approximately 2% reward on qualifying purchases, and a $1,250 reward cap per 12-month period. Fees can be subject to sales tax. Every figure remains editable; use the renewal offer and rules that apply to your membership.
  </aside>

  <div class="calculator-grid">
    <section class="input-panel" aria-labelledby="costco-inputs">
      <h2 id="costco-inputs">Enter your fees and spending</h2>
      <div class="input-grid">
        <div class="field">
          <label for="monthly-spend">Total monthly Costco spend</label>
          <input id="monthly-spend" type="number" inputmode="decimal" min="0" step="10" value="250" />
          <p class="helper">Include only purchases you would make anyway. This drives the separate shopping-savings estimate.</p>
        </div>
        <div class="field">
          <label for="eligible-annual-spend">Reward-eligible annual spend</label>
          <input id="eligible-annual-spend" type="number" inputmode="decimal" min="0" step="100" placeholder="Enter eligible spend" />
          <p class="helper">Start with receipts or your account estimate, then remove excluded purchases. Do not copy total spend here automatically.</p>
        </div>
        <div class="field">
          <label for="gold-fee">Gold Star annual fee</label>
          <input id="gold-fee" type="number" inputmode="decimal" min="0" step="1" value="65" />
          <p class="helper">Published U.S. fee verified August 5, 2026; replace it if your renewal amount differs.</p>
        </div>
        <div class="field">
          <label for="executive-fee">Executive annual fee</label>
          <input id="executive-fee" type="number" inputmode="decimal" min="0" step="1" value="130" />
          <p class="helper">Published U.S. fee verified August 5, 2026; the calculator derives the upgrade fee difference.</p>
        </div>
        <div class="field">
          <label for="savings-rate">Assumed savings vs other stores (%)</label>
          <input id="savings-rate" type="number" inputmode="decimal" min="0" step="0.1" value="15" />
          <p class="helper">An editable planning assumption from the existing calculator, not a Costco price claim.</p>
        </div>
        <div class="field">
          <label for="reward-rate">Executive reward rate (%)</label>
          <input id="reward-rate" type="number" inputmode="decimal" min="0" step="0.1" value="2" />
          <p class="helper">Current U.S. published rate verified August 5, 2026; apply it only to eligible spend.</p>
        </div>
        <div class="field">
          <label for="reward-cap">Annual reward cap</label>
          <input id="reward-cap" type="number" inputmode="decimal" min="0" step="50" value="1250" />
          <p class="helper">Current U.S. published cap for a 12-month period, verified August 5, 2026.</p>
        </div>
      </div>
    </section>

    <section class="result-panel" aria-live="polite" aria-labelledby="costco-result">
      <p class="eyebrow">Tier comparison</p>
      <p id="costco-result" class="verdict">Enter eligible annual spend to compare Gold Star and Executive.</p>
      <div class="metric-grid">
        <p class="metric"><span>Extra Executive fee</span><strong id="upgrade-fee">$0</strong></p>
        <p class="metric"><span>Upgrade break-even eligible spend</span><strong id="upgrade-break-even">$0/year</strong></p>
        <p class="metric"><span>Your capped Executive reward</span><strong id="reward">$0</strong></p>
        <p class="metric"><span>Reward minus upgrade fee</span><strong id="upgrade-value">$0</strong></p>
        <p class="metric"><span>Gold Star net benefit</span><strong id="gold-net">$0</strong></p>
        <p class="metric"><span>Executive net benefit</span><strong id="executive-net">$0</strong></p>
        <p class="metric"><span>Basic break-even annual spend</span><strong id="basic-break-even">$0/year</strong></p>
        <p class="metric"><span>Eligible spend that reaches cap</span><strong id="cap-threshold">$0/year</strong></p>
      </div>
    </section>
  </div>

  <section class="explanation" aria-labelledby="costco-math">
    <h2 id="costco-math">The calculation, line by line</h2>
    <ol class="formula-list">
      <li><strong>Extra Executive fee</strong> = Executive annual fee − Gold Star annual fee.</li>
      <li><strong>Upgrade break-even eligible spend</strong> = extra Executive fee ÷ entered reward rate.</li>
      <li><strong>Executive reward</strong> = the lower of eligible annual spend × reward rate, or the entered annual cap.</li>
      <li><strong>Executive advantage over Gold Star</strong> = capped reward − extra Executive fee.</li>
      <li><strong>Basic membership break-even</strong> = Gold Star fee ÷ your assumed shopping-savings rate.</li>
    </ol>
    <p>
      Shopping savings are applied to total planned spend when estimating whether either tier beats no membership. The Executive comparison uses only reward-eligible spend. Keeping those bases separate prevents excluded gas, food-court, fee, tax, or third-party purchases from making the upgrade look better than it is.
    </p>
  </section>

  <section class="explanation" aria-labelledby="costco-eligible">
    <h2 id="costco-eligible">What belongs in eligible annual spend</h2>
    <p>
      Under the U.S. terms checked on August 5, 2026, the reward is approximately 2% of qualifying pre-tax purchases after refunds. Most eligible merchandise bought through Costco warehouse registers and Costco websites in the U.S. and Canada can count for U.S. and Canadian residents, along with qualifying Costco Travel purchases after travel is completed. Only purchases by the Primary and active Primary Household Cardholder apply.
    </p>
    <p>
      Do not include gasoline, food-court purchases, membership fees, Costco Shop Cards, shipping, sales tax, listed deposits or other excluded fees. Restrictions also apply to tobacco, alcohol in named states, prescriptions in certain states, third-party services, and several travel charges. Purchases made before the Executive upgrade do not earn the reward. Use Costco's current full exclusion list rather than treating this summary as exhaustive.
    </p>
  </section>

  <section class="explanation" aria-labelledby="costco-cap-refund">
    <h2 id="costco-cap-refund">How the cap and downgrade path affect the decision</h2>
    <p>
      The cap limits the reward, not the eligible purchases themselves. Once the modeled reward reaches the entered cap, more eligible spend adds no Executive reward in this calculation. If the cap is below the extra Executive fee, the calculator marks the upgrade break-even as unreachable under those inputs.
    </p>
    <p>
      A reward below the upgrade fee does not produce an automatic payment. Costco's U.S. terms say a refund of the current Executive upgrade fee requires canceling or downgrading to Gold Star or Business Membership. Any issued or accrued reward is subtracted from that refund, and reward exceeding the refund is forfeited. Ask Costco to confirm the actual refund before relying on it; the calculator does not add a refund to projected value.
    </p>
  </section>

  <section class="explanation" aria-labelledby="costco-checklist">
    <h2 id="costco-checklist">Before choosing a tier</h2>
    <ul>
      <li>Use the fee shown on your own join or renewal screen, including any applicable tax.</li>
      <li>Separate planned purchases from spending caused by the membership, bulk waste, storage costs, and extra travel.</li>
      <li>Build eligible spend from qualifying transactions, not from the warehouse total on a card statement.</li>
      <li>Compare the calculator's reward with Costco's signed-in reward estimate when available.</li>
      <li>Recheck the official terms before upgrading, renewing, downgrading, or requesting a refund.</li>
    </ul>
  </section>

  <section class="sources" aria-labelledby="costco-sources">
    <h2 id="costco-sources">Official sources</h2>
    <ul>
      <li><a href="https://customerservice.costco.com/app/answers/answer_view/a_id/1008254/loc/en_US">Costco Customer Service — Executive 2% Reward FAQs</a></li>
      <li><a href="https://customerservice.costco.com/app/answers/detail/a_id/1205/~/what-is-an-executive-membership">Costco Customer Service — What is an Executive Membership?</a></li>
      <li><a href="https://www.costco.com/f/-/executive-rewards">Costco — Executive Rewards terms and exclusions</a></li>
    </ul>
    <p class="source-date">Terms and figures on this page were last checked August 5, 2026. Costco can change fees, eligibility, exclusions, caps, and refund procedures.</p>
  </section>

  <style>
    .intro,
    .helper,
    .explanation,
    .source-date {
      color: var(--color-muted);
    }

    .terms-note,
    .input-panel,
    .result-panel,
    .explanation,
    .sources {
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      background: var(--color-surface);
      padding: 1rem;
      box-shadow: var(--shadow-soft);
    }

    .terms-note {
      margin: 1rem 0;
      border-left: 4px solid var(--color-accent);
    }

    .calculator-grid,
    .input-grid,
    .metric-grid {
      display: grid;
      gap: 1rem;
    }

    .explanation,
    .sources {
      margin-top: 1rem;
    }

    .field label {
      display: block;
      margin-bottom: 0.3rem;
      font-weight: 650;
    }

    .helper {
      margin: 0.25rem 0 0;
      font-size: 0.92rem;
    }

    .result-panel {
      position: sticky;
      top: 1rem;
    }

    .eyebrow {
      margin: 0;
      color: var(--color-muted);
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .verdict {
      margin: 0.25rem 0 1rem;
      font-size: 1.25rem;
      font-weight: 750;
      line-height: 1.3;
    }

    .metric {
      margin: 0;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      background: var(--color-bg);
      padding: 0.75rem;
    }

    .metric span,
    .metric strong {
      display: block;
    }

    .metric span {
      color: var(--color-muted);
      font-size: 0.9rem;
    }

    .metric strong {
      font-size: 1.05rem;
    }

    .formula-list li + li,
    .explanation li + li,
    .sources li + li {
      margin-top: 0.55rem;
    }

    @media (min-width: 760px) {
      .calculator-grid {
        grid-template-columns: minmax(0, 1fr) minmax(320px, 0.85fr);
        align-items: start;
      }

      .input-grid,
      .metric-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
  </style>

  <script>
    import { formatCurrency } from '../../../lib/money';
    import { bindPersistentField } from '../../../lib/storage';

    const locale = 'en';
    const totalMonthlySpend = byId<HTMLInputElement>('monthly-spend');
    const eligibleAnnualSpend = byId<HTMLInputElement>('eligible-annual-spend');
    const goldFee = byId<HTMLInputElement>('gold-fee');
    const executiveFee = byId<HTMLInputElement>('executive-fee');
    const savingsRate = byId<HTMLInputElement>('savings-rate');
    const rewardRate = byId<HTMLInputElement>('reward-rate');
    const rewardCap = byId<HTMLInputElement>('reward-cap');
    const inputs = [totalMonthlySpend, eligibleAnnualSpend, goldFee, executiveFee, savingsRate, rewardRate, rewardCap];
    const verdict = byId<HTMLElement>('costco-result');
    const upgradeFeeOutput = byId<HTMLElement>('upgrade-fee');
    const upgradeBreakEvenOutput = byId<HTMLElement>('upgrade-break-even');
    const rewardOutput = byId<HTMLElement>('reward');
    const upgradeValueOutput = byId<HTMLElement>('upgrade-value');
    const goldNetOutput = byId<HTMLElement>('gold-net');
    const executiveNetOutput = byId<HTMLElement>('executive-net');
    const basicBreakEvenOutput = byId<HTMLElement>('basic-break-even');
    const capThresholdOutput = byId<HTMLElement>('cap-threshold');

    function byId<T extends HTMLElement>(id: string): T {
      const element = document.getElementById(id);
      if (!element) throw new Error(`Missing #${id}`);
      return element as T;
    }

    function readNonNegative(input: HTMLInputElement): number {
      const parsed = Number(input.value);
      return Number.isFinite(parsed) ? Math.max(0, parsed) : 0;
    }

    function annualCurrency(value: number): string {
      return Number.isFinite(value) ? `${formatCurrency(value, locale)}/year` : 'Not reachable';
    }

    function update(): void {
      const monthlySpend = readNonNegative(totalMonthlySpend);
      const eligibleSpend = readNonNegative(eligibleAnnualSpend);
      const goldAnnualFee = readNonNegative(goldFee);
      const executiveAnnualFee = readNonNegative(executiveFee);
      const savingsDecimal = readNonNegative(savingsRate) / 100;
      const rewardDecimal = readNonNegative(rewardRate) / 100;
      const cap = readNonNegative(rewardCap);
      const extraFee = Math.max(0, executiveAnnualFee - goldAnnualFee);
      const annualShoppingSavings = monthlySpend * 12 * savingsDecimal;
      const modeledReward = Math.min(eligibleSpend * rewardDecimal, cap);
      const upgradeValue = modeledReward - extraFee;
      const goldNet = annualShoppingSavings - goldAnnualFee;
      const executiveNet = annualShoppingSavings + modeledReward - executiveAnnualFee;
      const upgradeBreakEven = rewardDecimal > 0 && cap >= extraFee ? extraFee / rewardDecimal : Number.POSITIVE_INFINITY;
      const basicBreakEven = savingsDecimal > 0 ? goldAnnualFee / savingsDecimal : Number.POSITIVE_INFINITY;
      const capThreshold = rewardDecimal > 0 ? cap / rewardDecimal : Number.POSITIVE_INFINITY;

      upgradeFeeOutput.textContent = formatCurrency(extraFee, locale);
      upgradeBreakEvenOutput.textContent = annualCurrency(upgradeBreakEven);
      rewardOutput.textContent = formatCurrency(modeledReward, locale);
      upgradeValueOutput.textContent = formatCurrency(upgradeValue, locale);
      goldNetOutput.textContent = formatCurrency(goldNet, locale);
      executiveNetOutput.textContent = formatCurrency(executiveNet, locale);
      basicBreakEvenOutput.textContent = annualCurrency(basicBreakEven);
      capThresholdOutput.textContent = annualCurrency(capThreshold);

      if (!eligibleAnnualSpend.value.trim()) {
        verdict.textContent = 'Enter reward-eligible annual spend to compare the tiers. Total warehouse spend is not a safe substitute.';
      } else if (!Number.isFinite(upgradeBreakEven)) {
        verdict.textContent = 'Executive cannot recover its extra fee with the reward rate and cap entered.';
      } else if (upgradeValue >= 0) {
        verdict.textContent = `Executive leads Gold Star by ${formatCurrency(upgradeValue, locale)} in this model because the capped reward covers the extra fee.`;
      } else {
        verdict.textContent = `Gold Star leads Executive by ${formatCurrency(Math.abs(upgradeValue), locale)} in this model because the capped reward does not cover the extra fee.`;
      }
    }

    inputs.forEach((input) => {
      bindPersistentField(input, `costco-membership:${input.id}`);
      input.addEventListener('input', update);
    });
    update();
  </script>
</ToolLayout>
