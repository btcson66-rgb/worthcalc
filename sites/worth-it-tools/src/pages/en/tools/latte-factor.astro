---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { localizedPath } from '../../../i18n/utils';

const locale = 'en';
const title = 'Latte Factor Calculator: Daily Coffee Cost & Savings';
const description = 'Use this latte factor calculator to see annual coffee cost, compare a realistic alternative, and inspect the contributions and growth behind future value.';
const faq = [
  {
    question: 'What is the latte factor?',
    answer: 'It is a way to make the annual and long-term cost of a repeated small purchase visible. The idea does not prove that the purchase is wasteful; it simply puts the habit and a realistic alternative on the same basis.',
  },
  {
    question: 'How does this latte factor calculator work?',
    answer: 'It multiplies cost per purchase by purchases per week and 52 weeks for annual spend. It runs the same calculation for the alternative, subtracts the two annual costs, and shows both the amount redirected over the chosen period and a modeled future value.',
  },
  {
    question: 'What should I use as the alternative cost?',
    answer: 'Use the full cost of what you would actually do instead. For home coffee, that can include beans or pods, milk, filters, and a reasonable share of equipment cost. Enter zero only if skipping the purchase is genuinely the alternative.',
  },
  {
    question: 'How is future value calculated?',
    answer: 'The annual difference is divided into equal end-of-month contributions and compounded at the annual return you enter. It is a simplified scenario, not an investment forecast, and it does not deduct taxes, account fees, or inflation.',
  },
  {
    question: 'Does the calculator mean I should stop buying coffee?',
    answer: 'No. It separates the money cost from the value you receive. A purchase can fit your budget and still be worthwhile; the useful question is whether the enjoyment is worth more to you than the realistic alternative and the other goal the difference could fund.',
  },
  {
    question: 'Can I use it for something other than lattes?',
    answer: 'Yes. Replace the labels mentally with any repeated purchase, such as a snack, delivery fee, paid drink, or convenience purchase. Keep the comparison honest by matching the same frequency and including the alternative\'s full cost.',
  },
];
const related = [
  { title: 'Subscription Audit Calculator', href: localizedPath(locale, '/tools/subscription-audit') },
  { title: 'Commute Cost Calculator', href: localizedPath(locale, '/tools/commute-cost') },
  { title: 'Cashback Break-even Calculator', href: localizedPath(locale, '/tools/cashback-breakeven') },
];
---

<ToolLayout title={title} description={description} locale={locale} tool={{ name: title }} faq={faq} related={related} alternateLocales={['en', 'zh', 'es', 'fr', 'de']}>
  <p class="intro">
    This latte factor calculator follows the dollars instead of judging the coffee. Enter what the habit costs, how often it happens, and what you would realistically do instead. You will see annual spending, the actual difference between the two choices, and how much of a projected future value is your own redirected money versus modeled growth.
  </p>

  <div class="calculator-grid">
    <section class="input-panel" aria-labelledby="latte-inputs">
      <h2 id="latte-inputs">Describe the habit and alternative</h2>
      <div class="input-grid">
        <div class="field">
          <label for="habit-cost">Cost each time</label>
          <input id="habit-cost" type="number" inputmode="decimal" min="0" step="0.25" value="6" />
          <p class="helper">The existing calculator's editable example is $6; replace it with the price you actually pay.</p>
        </div>
        <div class="field">
          <label for="times-week">Times per week</label>
          <input id="times-week" type="number" inputmode="decimal" min="0" step="1" value="5" />
          <p class="helper">Use an average from recent weeks rather than an ideal week.</p>
        </div>
        <div class="field">
          <label for="alternative-cost">Alternative cost each time</label>
          <input id="alternative-cost" type="number" inputmode="decimal" min="0" step="0.25" value="1.5" />
          <p class="helper">The editable $1.50 example should include the full cost of the substitute you would really choose.</p>
        </div>
        <div class="field">
          <label for="years">Comparison period (years)</label>
          <input id="years" type="number" inputmode="numeric" min="1" step="1" value="10" />
          <p class="helper">The existing 10-year example is adjustable; a shorter period relies on fewer assumptions.</p>
        </div>
        <div class="field">
          <label for="return-rate">Modeled annual return (%)</label>
          <input id="return-rate" type="number" inputmode="decimal" step="0.1" value="5" />
          <p class="helper">The existing 5% example is a user-controlled scenario, not a promised return.</p>
        </div>
      </div>
    </section>

    <section class="result-panel" aria-live="polite" aria-labelledby="latte-result">
      <p class="eyebrow">Habit comparison</p>
      <p id="latte-result" class="verdict">Enter a repeated purchase to compare it with your alternative.</p>
      <div class="metric-grid">
        <p class="metric"><span>Purchases per year</span><strong id="annual-uses">0</strong></p>
        <p class="metric"><span>Yearly habit spend</span><strong id="yearly-spend">$0</strong></p>
        <p class="metric"><span>Yearly alternative spend</span><strong id="alternative-spend">$0</strong></p>
        <p class="metric"><span>Yearly difference</span><strong id="yearly-savings">$0</strong></p>
        <p class="metric"><span>Habit spend over period</span><strong id="total-spend">$0</strong></p>
        <p class="metric"><span>Money redirected over period</span><strong id="contributions">$0</strong></p>
        <p class="metric"><span>Modeled investment gain/loss</span><strong id="growth">$0</strong></p>
        <p class="metric"><span>Modeled future value</span><strong id="future-value">$0</strong></p>
      </div>
    </section>
  </div>

  <section class="explanation" aria-labelledby="latte-formula">
    <h2 id="latte-formula">The calculation you can audit</h2>
    <ol>
      <li><strong>Purchases per year</strong> = times per week × 52.</li>
      <li><strong>Yearly habit spend</strong> = cost each time × purchases per year.</li>
      <li><strong>Yearly alternative spend</strong> = alternative cost each time × the same purchase count.</li>
      <li><strong>Yearly difference</strong> = habit spend − alternative spend, with no negative “savings” claimed when the alternative costs more.</li>
      <li><strong>Money redirected</strong> = yearly difference × years. This is your contribution principal, not investment growth.</li>
      <li><strong>Future value</strong> models the yearly difference as equal contributions made at the end of each month, compounded at the entered annual return.</li>
    </ol>
  </section>

  <section class="explanation" aria-labelledby="latte-fair-comparison">
    <h2 id="latte-fair-comparison">Make the comparison match real life</h2>
    <p>
      Compare like with like. If buying coffee includes a tip or delivery fee, include it in the habit price. If the alternative is home coffee, include consumables and any equipment you would buy. If you would still purchase café coffee on some days, lower the weekly frequency instead of pretending the habit disappears completely.
    </p>
    <p>
      Frequency is often the most important uncertainty. Check a normal month of transactions, convert it to a weekly average, and rerun the calculator with a lower and higher count. A result that changes your decision after one extra purchase per week is a fragile estimate, not a command.
    </p>
  </section>

  <section class="explanation" aria-labelledby="latte-future-value">
    <h2 id="latte-future-value">Read future value without fooling yourself</h2>
    <p>
      The future-value total assumes you actually redirect the difference every month and leave it invested for the entire period. The “money redirected” result shows what came from your own cash; “modeled investment growth” is only the remainder under the return assumption. Market returns can be negative, and taxes, fees, inflation, missed contributions, and changing coffee prices are not modeled.
    </p>
    <p>
      If you would spend the difference elsewhere, the investment result is not your opportunity cost. In that case, use yearly difference as the useful number and decide whether the habit's convenience, ritual, or enjoyment earns its place in your budget.
    </p>
  </section>

  <style>
    .intro,
    .helper,
    .explanation {
      color: var(--color-muted);
    }

    .calculator-grid,
    .input-grid,
    .metric-grid {
      display: grid;
      gap: 1rem;
    }

    .input-panel,
    .result-panel,
    .explanation {
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      background: var(--color-surface);
      padding: 1rem;
      box-shadow: var(--shadow-soft);
    }

    .explanation {
      margin-top: 1rem;
    }

    .field label {
      display: block;
      margin-bottom: 0.3rem;
      font-weight: 650;
    }

    .helper {
      margin: 0.25rem 0 0;
      font-size: 0.92rem;
    }

    .result-panel {
      position: sticky;
      top: 1rem;
    }

    .eyebrow {
      margin: 0;
      color: var(--color-muted);
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .verdict {
      margin: 0.25rem 0 1rem;
      font-size: 1.25rem;
      font-weight: 750;
      line-height: 1.3;
    }

    .metric {
      margin: 0;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      background: var(--color-bg);
      padding: 0.75rem;
    }

    .metric span,
    .metric strong {
      display: block;
    }

    .metric span {
      color: var(--color-muted);
      font-size: 0.9rem;
    }

    .metric strong {
      font-size: 1.05rem;
    }

    .explanation li + li {
      margin-top: 0.55rem;
    }

    @media (min-width: 760px) {
      .calculator-grid {
        grid-template-columns: minmax(0, 1fr) minmax(320px, 0.85fr);
        align-items: start;
      }

      .input-grid,
      .metric-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
  </style>

  <script>
    import { formatCurrency, futureValue } from '../../../lib/money';
    import { bindPersistentField } from '../../../lib/storage';

    const locale = 'en';
    const inputs = ['habit-cost', 'times-week', 'years', 'alternative-cost', 'return-rate'].map((id) => byId<HTMLInputElement>(id));
    const verdict = byId<HTMLElement>('latte-result');
    const annualUsesOutput = byId<HTMLElement>('annual-uses');
    const yearlySpendOutput = byId<HTMLElement>('yearly-spend');
    const alternativeSpendOutput = byId<HTMLElement>('alternative-spend');
    const yearlySavingsOutput = byId<HTMLElement>('yearly-savings');
    const totalSpendOutput = byId<HTMLElement>('total-spend');
    const contributionsOutput = byId<HTMLElement>('contributions');
    const growthOutput = byId<HTMLElement>('growth');
    const futureValueOutput = byId<HTMLElement>('future-value');

    function byId<T extends HTMLElement>(id: string): T {
      const element = document.getElementById(id);
      if (!element) throw new Error(`Missing #${id}`);
      return element as T;
    }

    function value(id: string): number {
      const parsed = Number(byId<HTMLInputElement>(id).value);
      return Number.isFinite(parsed) ? parsed : 0;
    }

    function update(): void {
      const cost = Math.max(0, value('habit-cost'));
      const alternative = Math.max(0, value('alternative-cost'));
      const times = Math.max(0, value('times-week'));
      const years = Math.max(1, value('years'));
      const annualUses = times * 52;
      const yearlySpend = cost * annualUses;
      const yearlyAlternative = alternative * annualUses;
      const yearlyDifference = Math.max(0, yearlySpend - yearlyAlternative);
      const totalSpend = yearlySpend * years;
      const contributions = yearlyDifference * years;
      const future = futureValue(yearlyDifference / 12, value('return-rate'), years);
      const growth = future - contributions;

      annualUsesOutput.textContent = new Intl.NumberFormat('en-US', { maximumFractionDigits: 1 }).format(annualUses);
      yearlySpendOutput.textContent = formatCurrency(yearlySpend, locale);
      alternativeSpendOutput.textContent = formatCurrency(yearlyAlternative, locale);
      yearlySavingsOutput.textContent = formatCurrency(yearlyDifference, locale);
      totalSpendOutput.textContent = formatCurrency(totalSpend, locale);
      contributionsOutput.textContent = formatCurrency(contributions, locale);
      growthOutput.textContent = formatCurrency(growth, locale);
      futureValueOutput.textContent = formatCurrency(future, locale);

      if (yearlyDifference > 0) {
        verdict.textContent = `The alternative costs ${formatCurrency(yearlyDifference, locale)} less per year. Over ${years.toFixed(0)} years, ${formatCurrency(contributions, locale)} would be your redirected money and ${formatCurrency(growth, locale)} would be modeled growth.`;
      } else if (yearlySpend < yearlyAlternative) {
        verdict.textContent = 'The entered alternative costs more than the habit, so this model shows no savings from switching.';
      } else {
        verdict.textContent = 'The habit and alternative cost the same under these inputs.';
      }
    }

    inputs.forEach((input) => {
      bindPersistentField(input, `latte-factor:${input.id}`);
      input.addEventListener('input', update);
    });
    update();
  </script>
</ToolLayout>
