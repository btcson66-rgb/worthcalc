---
import HomePage from '../../components/HomePage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { homeContent, homeJsonLd } from '../../lib/home';

const locale = 'zh';
const content = homeContent[locale];
---

<BaseLayout title={content.title} description={content.description} locale={locale} jsonLd={homeJsonLd(locale, Astro.site)} entity={content.entity}>
  <HomePage locale={locale} />
</BaseLayout>
