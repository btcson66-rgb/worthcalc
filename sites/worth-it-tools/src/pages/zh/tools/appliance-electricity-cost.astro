---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import ApplianceCostCalculator from '../../../components/ApplianceCostCalculator.astro';
import TWTariffExplainer from '../../../components/TWTariffExplainer.astro';
import { localizedPath } from '../../../i18n/utils';
import type { TrustBlockProps } from '../../../types/trustBlock';

const locale = 'zh';
const title = '家電一天用多少電？每小時、每月電費怎麼算？';
const description = '家電一天用多少電、每月電費多少？輸入瓦數與使用時數，可依台電住宅累進電價（夏月／非夏月，114 年 10 月 1 日起實施）算出這台實際多付多少，電價表可修改。';
const faq = [
  { question: '家電電費公式怎麼算？', answer: '瓦數先除以 1,000 換成 kW，再乘使用時數與你輸入的每度電價：W ÷ 1,000 × 小時 × 電價。每月用 30 天、每年用 365 天。' },
  { question: '清單裡的瓦數是哪來的？是產品平均嗎？', answer: '冰箱、除濕機、單體式冷氣（窗型／移動式）與顯示器四項，是用經濟部能源署公開的能源效率標示登錄資料算出的中位數，清單會寫出資料集名稱與款數；其他家電的能源署資料沒有公布可換算成瓦數的欄位，所以是標明「示範值」的算例，不是產品平均。兩者都請用機身標籤、智慧插座或插座電表的讀值替換。' },
  { question: '可以比較家裡哪台電器最耗電嗎？', answer: '可以先用同一個每度電價比較，但排序使用每列預設每日時數。換成你家的使用時數後，才是較有意義的規劃結果。' },
  { question: '台電基本費、維修與購買成本有算嗎？', answer: '沒有。本頁估算新增用電的邊際能源費；固定基本費、維修、耗材、購買成本與保固應另外列。' },
  { question: '家電電費為什麼不能直接用平均電價乘？', answer: '台電住宅電價是累進的，這台家電的度數疊在全戶原本用電的後面，落在哪一段就用哪一段的單價。勾選計算機的累進電價模式、填全戶每月度數，就會算有這台和沒有這台兩張帳單的差。' },
  { question: '兩個月一期的帳單度數要怎麼填？', answer: '台電電價表註明兩個月抄表收費一次時各段度數加倍計算，所以把帳單上的度數除以 2 當每月度數再填入；整期都在同一季節才能這樣換算，橫跨 6 月 1 日或 9 月 30 日的帳單請以台電帳單為準。' },
  { question: '電價表是哪一版？以後調整了怎麼辦？', answer: '預設是台電 114 年 10 月 1 日起實施的住宅用非時間電價；經濟部能源署揭露專區到 2026-10-17 列出的最新一版仍是這一版，12 月審議可能改變。計算機的電價表每一格都能改，台電公布新表時把新單價填進去即可。' },
  { question: '台灣時間電價可以怎麼填？', answer: '可從台電方案起點選夏月／非夏月與簡易型時間電價的尖峰／離峰，再把數字改成你的契約與電費單。這些是可編輯起點，不是對每個家庭的適用判定。' },
];
const related = [
  { title: '家用與公共充電樁電費比較', href: localizedPath(locale, '/home-vs-public-ev-charging-cost') },
  { title: '通勤成本計算機', href: localizedPath(locale, '/tools/commute-cost') },
];
const trustBlock: TrustBlockProps = {
  method: '本頁先把瓦數換成 kW，再套用可見的使用時數與每度電價，估算新增用電的邊際成本。啟用累進電價模式時，改算「有這台的帳單 − 沒有這台的帳單」，各級距只對落在該級距的度數計價。',
  formula: 'W ÷ 1,000 × 小時 × 每度電價；累進模式：帳單（原本度數 + 這台度數） − 帳單（原本度數）',
  sources: [
    {
      label: '台灣電力公司 — 調整後各類用戶電價表（中華民國 114 年 10 月 1 日起實施；住宅用非時間電價各級距與夏月定義、兩個月帳單各段度數加倍的註記。查核日為單價逐列核對那天；2026-10-17 台電網站回應 403，無法再開一次）',
      url: 'https://www.taipower.com.tw/media/05klpxyd/1140930_114%E5%B9%B410%E6%9C%88%E9%9B%BB%E5%83%B9%E5%85%AC%E5%91%8A.pdf?mediaDL=true',
      verifiedDate: '2026-09-23',
    },
    {
      label: '經濟部能源署 — 電價及費率審議資訊揭露專區：電價表（最新一版為「台灣電力公司114年下半年電價表」，2025-10-03 公布）',
      url: 'https://www3.moeaea.gov.tw/ele102/Content/Messagess/contents.aspx?&MmmID=654246034110677254&MSID=1343206640732631102',
      verifiedDate: '2026-10-17',
    },
    {
      label: '經濟部能源署 — 審議會決議優先爭取政府撥補預算，本次電價調整暫不決定（2026-09-18；2026-03-27 的第 1 次審議會決議電價不調整）',
      url: 'https://www3.moeaea.gov.tw/ele102/Content/NewsLetter/contents.aspx?&SiteID=654246032665636316&MmmID=654246033427256710&SSize=10&MSID=1345445725427633170',
      verifiedDate: '2026-10-17',
    },
    {
      label: '台電簡要電價表（2025-10-01 起實施；簡易型時間電價的預設單價）',
      url: 'https://www.taipower.com.tw/media/dhuhrppu/%E7%B0%A1%E8%A6%81%E9%9B%BB%E5%83%B9%E8%A1%A8.pdf?mediaDL=true',
      verifiedDate: '2026-09-15',
    },
    {
      label: '經濟部能源署能源效率分級標示管理系統 — 政府資料開放：電冰箱（107 年新分級基準）、除濕機（115 年新分級基準）、無風管空氣調節機（114 年）登錄資訊 CSV，2026-10-17 下載並重算',
      url: 'https://ea03.moeaea.gov.tw/e0410/03/gen/opendata/list.aspx',
      verifiedDate: '2026-10-17',
    },
    {
      label: '經濟部能源署節能標章 — Open Data：顯示器節能標章有效獲證資訊 CSV（開機模式平均消耗功率），2026-10-17 下載並重算',
      url: 'https://ea03.moeaea.gov.tw/e0410/01/other/opendata/list.aspx',
      verifiedDate: '2026-10-17',
    },
  ],
  limits: [
    '試算僅供參考，以台電帳單與台電、主管機關公告為準。',
    '電價表預設為台電 114 年 10 月 1 日起實施的住宅用非時間電價，只算每度電的流動電費；經濟部審議會預計 12 月再討論電價，之後可能調整，請用最新公告修改計算機的單價。',
    '清單中只有冰箱、除濕機、單體式冷氣與顯示器四項的瓦數來自能源署資料（中位數；標示值是標準測試條件或額定能力下的數字，實際用電會不同）；其他 39 項與所有的每日使用時數都是標明「示範值」的假設，不是產品平均。',
    '能源署公開清單含登錄錯誤（例如一台冷氣被列為 2,115 kW），所以只用中位數與第 25～75 百分位，不用最小或最大值。',
    '本頁只納入列出的輸入，其他成本、條款、稅費與個人情況不在計算範圍。',
  ],
  lastReviewed: '2026-10-17',
  locale,
};
---

<ToolLayout title={title} description={description} locale={locale} tool={{ name: title }} faq={faq} related={related} alternateLocales={['zh']} trustBlock={trustBlock}>
  <ApplianceCostCalculator locale={locale} />
  <TWTariffExplainer />
</ToolLayout>
