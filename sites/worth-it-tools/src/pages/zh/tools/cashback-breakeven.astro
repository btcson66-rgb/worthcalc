---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { localizedPath } from '../../../i18n/utils';
import { evaluateCashback } from '../../../lib/twCashbackMath.mjs';

const locale = 'zh';
const title = '信用卡年費回本與回饋打平計算機';
const description = '輸入信用卡年費、首刷禮與餐飲／網購／一般消費回饋率，對照 1% 免年費基準卡，算出年度淨價值與回本所需的每月刷卡金額。';
const faq = [
  {
    question: '怎麼判斷年費信用卡值不值得？',
    answer: '把年度回饋、首刷禮和年費相加減，再和免年費 1% 回饋卡比較。如果年費卡扣除成本後仍勝出，就比較可能值得。',
  },
  {
    question: '回饋打平月消費是什麼？',
    answer: '它是依照你目前的消費類別比例，估算年費卡要花到多少月消費，才會補回年費並勝過 1% 免年費卡。',
  },
  {
    question: '首刷禮要算進去嗎？',
    answer: '如果你能在不增加額外消費的情況下拿到，可以算進第一年。評估長期價值時，建議把首刷禮設為 0 再算一次。',
  },
  {
    question: '為什麼要和 1% 免年費卡比較？',
    answer: '因為免年費卡是你的機會成本。年費卡不只要有回饋，還要比簡單免費選項更好。',
  },
  {
    question: '點數轉哩程或高價值兌換有算嗎？',
    answer: '沒有。此工具把回饋視為現金百分比。如果點數對你價值更高或更低，請換算成等效回饋率。',
  },
];

// Worked tables. Same function as the calculator script below (src/lib/twCashbackMath.mjs); every input is stated in
// the caption, none of it is a real card's terms. Mix = the page's default spending mix and rates.
const workedMix = { spends: [12000, 8000, 10000], rates: [0.03, 0.02, 0.012] };
const nt = (n: number) => `NT$${Math.round(n).toLocaleString('en-US')}`;
const signedNt = (n: number) => `${n >= 0 ? '+' : '−'}${nt(Math.abs(n))}`;
const scaleRows = [0.5, 1, 1.5, 2].map((k) => {
  const r = evaluateCashback({ fee: 3000, bonus: 0, spends: workedMix.spends.map((x) => x * k), rates: workedMix.rates });
  return { monthly: r.monthlySpend, gross: r.gross, net: r.net, baseline: r.baseline, incremental: r.incremental };
});
const feeRows = [1200, 3000, 6000].map((fee) => {
  const noBonus = evaluateCashback({ fee, bonus: 0, spends: workedMix.spends, rates: workedMix.rates });
  const withBonus = evaluateCashback({ fee, bonus: 1000, spends: workedMix.spends, rates: workedMix.rates });
  return { fee, noBonus: noBonus.needed, withBonus: withBonus.needed };
});
const weightedPct = (evaluateCashback({ fee: 0, bonus: 0, spends: workedMix.spends, rates: workedMix.rates }).weightedRate * 100).toFixed(2);
const related = [
  { title: '信用卡分期試算', href: localizedPath(locale, '/tools/installment-true-apr') },
  { title: '訂閱支出健檢計算機', href: localizedPath(locale, '/tools/subscription-audit') },
  { title: 'Costco 會員值不值得計算機', href: localizedPath(locale, '/tools/costco-membership') },
  { title: '年費卡損益兩平完整指南', href: localizedPath(locale, '/annual-fee-card-breakeven') },
  { title: '信用卡回饋上限與真正回饋率試算', href: localizedPath(locale, '/cashback-caps-real-reward-rate') },
];
---

<ToolLayout title={title} description={description} locale={locale} tool={{ name: title }} faq={faq} related={related} alternateLocales={['zh']}>
  <p class="intro">
    這個信用卡回饋打平計算機會比較分類回饋、首刷禮、年費和免年費 1% 基準卡。辦年費卡前，先看你的月消費是否足夠補回年費。
  </p>

  <div class="calculator-grid">
    <section class="input-panel" aria-labelledby="cashback-inputs">
      <h2 id="cashback-inputs">輸入資料</h2>
      <div class="input-grid">
        <div class="field">
          <label for="annual-fee">年費</label>
          <input id="annual-fee" type="number" inputmode="decimal" min="0" step="100" value="3000" data-range data-range-min="0" data-range-max="400" data-range-step="5" />
        </div>
        <div class="field">
          <label for="welcome-bonus">首刷禮價值</label>
          <input id="welcome-bonus" type="number" inputmode="decimal" min="0" step="100" value="1000" />
        </div>
        <div class="field">
          <label for="category-one-spend">餐飲每月消費</label>
          <input id="category-one-spend" type="number" inputmode="decimal" min="0" step="500" value="12000" />
        </div>
        <div class="field">
          <label for="category-one-rate">餐飲回饋 (%)</label>
          <input id="category-one-rate" type="number" inputmode="decimal" min="0" step="0.1" value="3" />
        </div>
        <div class="field">
          <label for="category-two-spend">網購每月消費</label>
          <input id="category-two-spend" type="number" inputmode="decimal" min="0" step="500" value="8000" />
        </div>
        <div class="field">
          <label for="category-two-rate">網購回饋 (%)</label>
          <input id="category-two-rate" type="number" inputmode="decimal" min="0" step="0.1" value="2" />
        </div>
        <div class="field">
          <label for="category-three-spend">一般消費每月</label>
          <input id="category-three-spend" type="number" inputmode="decimal" min="0" step="500" value="10000" />
        </div>
        <div class="field">
          <label for="category-three-rate">一般消費回饋 (%)</label>
          <input id="category-three-rate" type="number" inputmode="decimal" min="0" step="0.1" value="1.2" />
        </div>
      </div>
    </section>

    <section class="result-panel" aria-live="polite" aria-labelledby="cashback-result">
      <p class="eyebrow">判斷</p>
      <p id="cashback-result" class="verdict">輸入消費與回饋率後會比較信用卡。</p>
      <div class="metric-grid">
        <p class="metric"><span>年度回饋</span><strong id="annual-cashback">NT$0</strong></p>
        <p class="metric"><span>年度淨價值</span><strong id="net-value">NT$0</strong></p>
        <p class="metric"><span>免年費 1% 基準</span><strong id="baseline">NT$0</strong></p>
        <p class="metric"><span>打平月消費</span><strong id="break-even">NT$0</strong></p>
      </div>
    </section>
  </div>

  <section class="explanation" aria-labelledby="cashback-how">
    <h2 id="cashback-how">計算方式</h2>
    <p>
      計算機會把每個分類的月消費乘以 12，再乘以該分類回饋率。年度淨價值等於年度回饋加首刷禮，再扣掉年費。
    </p>
    <p>
      判斷會把這個淨價值和免年費 1% 卡比較。打平月消費則依照你目前的消費類別比例，估算年費卡需要多少月消費才會勝出。
    </p>
  </section>

  <section class="worked-tables" aria-labelledby="cashback-worked">
    <h2 id="cashback-worked">驗算案例：多少月消費才打平年費？</h2>
    <p>
      以下兩張表用上面的計算機同一條公式算出，輸入都寫在表頭，是示範用的假想卡片，不是任何銀行信用卡的實際條件。
      消費組合沿用本頁預設：餐飲 12,000 元回饋 3%、網購 8,000 元回饋 2%、一般消費 10,000 元回饋 1.2%，加權回饋率約 {weightedPct}%（每月合計 30,000 元），與免年費 1% 基準卡比較。
    </p>
    <table>
      <caption>表一：年費 3,000 元、無首刷禮，消費組合比例不變、只改變每月總消費</caption>
      <thead>
        <tr><th scope="col">每月總消費</th><th scope="col">年度回饋</th><th scope="col">扣年費後淨值</th><th scope="col">1% 基準卡回饋</th><th scope="col">比基準卡多（少）</th></tr>
      </thead>
      <tbody>
        {scaleRows.map((row) => (
          <tr>
            <th scope="row">{nt(row.monthly)}</th>
            <td>{nt(row.gross)}</td>
            <td>{nt(row.net)}</td>
            <td>{nt(row.baseline)}</td>
            <td>{signedNt(row.incremental)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <table>
      <caption>表二：同樣的消費組合，不同年費下的打平月消費</caption>
      <thead>
        <tr><th scope="col">年費</th><th scope="col">首刷禮 0 元：打平月消費</th><th scope="col">首刷禮 1,000 元（僅第一年）：打平月消費</th></tr>
      </thead>
      <tbody>
        {feeRows.map((row) => (
          <tr>
            <th scope="row">{nt(row.fee)}</th>
            <td>{nt(row.noBonus)}／月</td>
            <td>{nt(row.withBonus)}／月</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p>
      算式：打平月消費 =（年費 − 首刷禮）÷（加權回饋率 − 1%）÷ 12。年費 3,000 元、無首刷禮時，{nt(3000)} ÷（{weightedPct}% − 1%）÷ 12 ≈ {nt(feeRows[1].noBonus)}；
      每月消費低於這個數字，免年費 1% 卡反而回饋較多。回饋率若不高於 1%，年費卡不論刷多少都無法打平。
    </p>
  </section>

  <section class="official-refs" aria-labelledby="cashback-refs">
    <h2 id="cashback-refs">官方規範參考</h2>
    <p>
      回饋條件、年費與各項費用以發卡銀行的書面約定為準。主管機關對發卡機構的揭露與利率規定，可查全國法規資料庫的原文（2026-11-08 查核，連結可開啟）：
    </p>
    <ul>
      <li>
        <a href="https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=G0380055" rel="noopener" target="_blank">信用卡業務機構管理辦法</a>：第 40 條要求發卡機構申請時以書面或電子文件告知年費、各項手續費、循環信用利率等計算方式與可能負擔的一切費用；第 45 條要求年費、各項費用、優惠或服務等資訊在刊物或網路刊登。
      </li>
      <li>
        <a href="https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=G0380001&flno=47-1" rel="noopener" target="_blank">銀行法第 47-1 條</a>：信用卡循環信用利率不得超過年利率 15%。有循環利息時，利息成本會先吃掉回饋；本頁的計算假設你每期都繳清帳款。
      </li>
    </ul>
  </section>
  <script>
    import { formatCurrency } from '../../../lib/money';
    import { evaluateCashback } from '../../../lib/twCashbackMath.mjs';
    import { bindPersistentField } from '../../../lib/storage';

    const locale = 'zh';
    const ids = [
      'annual-fee',
      'welcome-bonus',
      'category-one-spend',
      'category-one-rate',
      'category-two-spend',
      'category-two-rate',
      'category-three-spend',
      'category-three-rate',
    ];
    const inputs = ids.map((id) => byId<HTMLInputElement>(id));
    const verdict = byId<HTMLElement>('cashback-result');
    const annualCashback = byId<HTMLElement>('annual-cashback');
    const netValue = byId<HTMLElement>('net-value');
    const baseline = byId<HTMLElement>('baseline');
    const breakEven = byId<HTMLElement>('break-even');

    function byId<T extends HTMLElement>(id: string): T {
      const element = document.getElementById(id);
      if (!element) throw new Error(`Missing #${id}`);
      return element as T;
    }

    function value(id: string): number {
      const parsed = Number(byId<HTMLInputElement>(id).value);
      return Number.isFinite(parsed) ? parsed : 0;
    }

    function update(): void {
      const fee = Math.max(0, value('annual-fee'));
      const bonus = Math.max(0, value('welcome-bonus'));
      const spends = [
        Math.max(0, value('category-one-spend')),
        Math.max(0, value('category-two-spend')),
        Math.max(0, value('category-three-spend')),
      ];
      const rates = [
        Math.max(0, value('category-one-rate')) / 100,
        Math.max(0, value('category-two-rate')) / 100,
        Math.max(0, value('category-three-rate')) / 100,
      ];
      const { gross: grossCashback, baseline: baselineValue, net, incremental, needed } = evaluateCashback({ fee, bonus, spends, rates });

      annualCashback.textContent = formatCurrency(grossCashback, locale);
      netValue.textContent = formatCurrency(net, locale);
      baseline.textContent = formatCurrency(baselineValue, locale);
      breakEven.textContent = Number.isFinite(needed) ? `${formatCurrency(needed, locale)}/月` : '無法打平';

      if (incremental > 0) {
        verdict.textContent = `值得考慮：這張卡今年比免年費 1% 卡多 ${formatCurrency(incremental, locale)}。`;
      } else {
        verdict.textContent = `目前不划算：免年費 1% 卡今年多 ${formatCurrency(Math.abs(incremental), locale)}。`;
      }
    }

    inputs.forEach((input) => {
      bindPersistentField(input, `cashback-breakeven:${input.id}:zh`);
      input.addEventListener('input', update);
    });
    update();
  </script>
</ToolLayout>
