---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import DecisionGuide from '../../../components/DecisionGuide.astro';
import { commuteGuides } from '../../../data/decisionGuides';
import { localizedPath } from '../../../i18n/utils';

const locale = 'zh';
const decisionGuide = commuteGuides.zh;
if (!decisionGuide) throw new Error('Missing Traditional Chinese commute guide');
const title = '通勤成本計算機：每公里、每月與全年車馬費';
const description = '計算汽車、電動車、機車、大眾運輸、叫車與單車的每公里、每月及全年通勤成本，可分開比較燃料、停車、過路費與時間成本。';
const faq = [
  {
    question: '可以比較哪些通勤方式？',
    answer: '可以比較汽車或電動車、機車、大眾運輸或 TPASS、Uber 或計程車，以及單車。每種方式都會顯示每月、全年與每公里成本。',
  },
  {
    question: '汽車通勤成本怎麼算？',
    answer: '可直接輸入每公里或每英里成本，也可用油耗加油價，或用電耗加每度電價推算。工具再依來回距離與通勤天數計算，並加入停車、過路費及選填的時間成本。',
  },
  {
    question: '每公里油錢就是完整的開車成本嗎？',
    answer: '不是。燃油或電費模式不包含保養、輪胎、折舊、保險、貸款、稅費等持有成本。若要比較完整車馬費，請整理自己的用車紀錄後使用直接成本模式。',
  },
  {
    question: '機車如何放進通勤比較？',
    answer: '填入機車每公里成本、每月停車費與單程時間即可。每公里成本由你決定包含油錢、電費、保養或折舊中的哪些項目。',
  },
  {
    question: '時間成本是什麼？',
    answer: '填入時薪後，工具會把每種方式的來回通勤分鐘換算為金額並加入比較。若只想看現金支出，把時薪設為 0。',
  },
  {
    question: '英里和公里可以切換嗎？',
    answer: '可以。英制使用英里、加侖、MPG 與每 100 英里耗電；公制使用公里、公升、L/100 km 與每 100 公里耗電。切換時會轉換已輸入的距離、單位成本與效率。',
  },
];
const related = [
  { title: '電動車 vs 燃油車總成本計算機', href: localizedPath(locale, '/tools/ev-vs-gas') },
  { title: '租屋 vs 買房計算機', href: localizedPath(locale, '/tools/rent-vs-buy') },
  { title: 'Costco 會員回本計算機', href: localizedPath(locale, '/tools/costco-membership') },
  { title: '拿鐵因子計算機', href: localizedPath(locale, '/tools/latte-factor') },
];
---

<ToolLayout title={title} description={description} locale={locale} tool={{ name: title }} faq={faq} related={related} alternateLocales={['en', 'zh', 'es', 'fr', 'de']}>
  <p class="intro">
    這個通勤成本計算機以台灣常見的公里、公升與新台幣為預設，讓汽車、電動車、機車、TPASS 或其他大眾運輸、Uber 或計程車、單車放在同一個車馬費比較表。畫面中的數值只是可修改的試算預設，不是油價、電價或車馬費行情；請換成自己的里程、帳單、加油紀錄與票價。
  </p>

  <div class="calculator-grid">
    <section class="input-panel" aria-labelledby="commute-inputs">
      <h2 id="commute-inputs">通勤資料</h2>

      <fieldset class="switcher">
        <legend>計量單位</legend>
        <div class="switch-options">
          <label><input id="unit-metric" type="radio" name="unit-choice" value="metric" checked /> 公制 <span>（公里、公升）</span></label>
          <label><input id="unit-imperial" type="radio" name="unit-choice" value="imperial" /> 英制 <span>（英里、加侖）</span></label>
        </div>
      </fieldset>
      <input id="unit-system" type="hidden" value="metric" />

      <div class="input-grid core-inputs">
        <div class="field">
          <label for="distance">單程距離（<span id="distance-unit">公里</span>）</label>
          <input id="distance" type="number" inputmode="decimal" min="0" step="0.1" value="12" />
        </div>
        <div class="field">
          <label for="workdays">每月通勤天數</label>
          <input id="workdays" type="number" inputmode="numeric" min="0" step="1" value="22" />
        </div>
      </div>

      <fieldset class="switcher car-method">
        <legend>汽車能源或持有成本怎麼輸入？</legend>
        <div class="switch-options mode-options">
          <label><input id="mode-direct" type="radio" name="car-mode-choice" value="direct" checked /> 直接填每<span class="distance-name">公里</span>成本</label>
          <label><input id="mode-fuel" type="radio" name="car-mode-choice" value="fuel" /> 燃油車</label>
          <label><input id="mode-ev" type="radio" name="car-mode-choice" value="ev" /> 電動車</label>
        </div>
      </fieldset>
      <input id="car-mode" type="hidden" value="direct" />

      <div id="direct-fields" class="mode-fields">
        <div class="field">
          <label for="car-cost">汽車每<span class="distance-name">公里</span>直接成本</label>
          <input id="car-cost" type="number" inputmode="decimal" min="0" step="0.1" value="8" />
          <p class="helper">可填只因通勤增加的成本，也可填包含折舊等項目的完整成本；工具不會替你假設包含範圍。</p>
        </div>
      </div>

      <div id="fuel-fields" class="mode-fields input-grid" hidden>
        <div class="field">
          <label for="fuel-efficiency"><span id="fuel-efficiency-label">每 100 公里耗油（L/100 km）</span></label>
          <input id="fuel-efficiency" type="number" inputmode="decimal" min="0" step="0.1" value="8" />
        </div>
        <div class="field">
          <label for="fuel-price">每<span id="fuel-volume-unit">公升</span>油價</label>
          <input id="fuel-price" type="number" inputmode="decimal" min="0" step="0.1" value="30" />
          <p class="helper">可依你實際加油的油種，輸入收據或中油加油站牌價；工具不提供當期牌價。</p>
        </div>
      </div>

      <div id="ev-fields" class="mode-fields input-grid" hidden>
        <div class="field">
          <label for="ev-efficiency">電動車每 100 <span class="distance-name">公里</span>耗電（kWh）</label>
          <input id="ev-efficiency" type="number" inputmode="decimal" min="0" step="0.1" value="18" />
        </div>
        <div class="field">
          <label for="electricity-price">每度電價格（每 kWh）</label>
          <input id="electricity-price" type="number" inputmode="decimal" min="0" step="0.1" value="3" />
        </div>
      </div>

      <div class="derived-box" aria-live="polite">
        <span>推算出的汽車能源或持有成本</span>
        <strong id="derived-rate">NT$0.00／公里</strong>
        <small id="derived-detail">採用你直接輸入的單位成本。</small>
        <small id="fuel-warning">油錢或電費不等於完整持有成本。</small>
      </div>

      <p class="defaults-note">油耗、電耗、油價與電價都是可修改的試算預設，不代表現在的市場價格或官方費率。</p>

      <div class="input-grid">
        <div class="field">
          <label for="scooter-cost">機車每<span class="distance-name">公里</span>成本</label>
          <input id="scooter-cost" type="number" inputmode="decimal" min="0" step="0.1" value="2" />
          <p class="helper">自行決定是否納入油電、保養、輪胎與折舊。</p>
        </div>
        <div class="field">
          <label for="scooter-parking">機車每月停車費</label>
          <input id="scooter-parking" type="number" inputmode="decimal" min="0" step="50" value="300" />
        </div>
        <div class="field">
          <label for="transit-pass">大眾運輸或 TPASS 月支出</label>
          <input id="transit-pass" type="number" inputmode="decimal" min="0" step="50" value="1200" />
        </div>
        <div class="field">
          <label for="rideshare">Uber 或計程車單程車資</label>
          <input id="rideshare" type="number" inputmode="decimal" min="0" step="10" value="250" />
        </div>
        <div class="field">
          <label for="bike-cost">單車每月成本</label>
          <input id="bike-cost" type="number" inputmode="decimal" min="0" step="50" value="300" />
        </div>
        <div class="field">
          <label for="parking">汽車每月停車費</label>
          <input id="parking" type="number" inputmode="decimal" min="0" step="100" value="2000" />
        </div>
        <div class="field">
          <label for="tolls">汽車每月過路費</label>
          <input id="tolls" type="number" inputmode="decimal" min="0" step="50" value="0" />
        </div>
        <div class="field">
          <label for="hourly-wage">選填的時間成本時薪</label>
          <input id="hourly-wage" type="number" inputmode="decimal" min="0" step="10" value="250" />
        </div>
        <div class="field">
          <label for="car-minutes">汽車或電動車單程分鐘</label>
          <input id="car-minutes" type="number" inputmode="numeric" min="0" step="1" value="35" />
        </div>
        <div class="field">
          <label for="scooter-minutes">機車單程分鐘</label>
          <input id="scooter-minutes" type="number" inputmode="numeric" min="0" step="1" value="30" />
        </div>
        <div class="field">
          <label for="transit-minutes">大眾運輸單程分鐘</label>
          <input id="transit-minutes" type="number" inputmode="numeric" min="0" step="1" value="45" />
        </div>
        <div class="field">
          <label for="rideshare-minutes">叫車單程分鐘</label>
          <input id="rideshare-minutes" type="number" inputmode="numeric" min="0" step="1" value="35" />
        </div>
        <div class="field">
          <label for="bike-minutes">單車單程分鐘</label>
          <input id="bike-minutes" type="number" inputmode="numeric" min="0" step="1" value="50" />
        </div>
      </div>
    </section>

    <section class="result-panel" aria-live="polite" aria-labelledby="commute-result">
      <p class="eyebrow">比較結果</p>
      <p id="commute-result" class="verdict">輸入通勤條件後會比較各種方式。</p>
      <p id="hour-cost" class="time-summary">時薪 NT$0 時，一小時通勤的試算時間成本為 NT$0。</p>
      <p class="result-note">時薪大於 0 時，下列每月、全年與每距離總額都會包含選填的時間成本。</p>
      <div class="metric-grid">
        <p class="metric cheapest-metric"><span>最低成本方式</span><strong id="cheapest">無</strong></p>
        <p class="metric">
          <span>汽車或電動車</span><strong id="car-total">NT$0／月</strong>
          <small id="car-year">NT$0／年</small><small id="car-rate">NT$0.00／公里</small>
        </p>
        <p class="metric">
          <span>機車</span><strong id="scooter-total">NT$0／月</strong>
          <small id="scooter-year">NT$0／年</small><small id="scooter-rate">NT$0.00／公里</small>
        </p>
        <p class="metric">
          <span>大眾運輸</span><strong id="transit-total">NT$0／月</strong>
          <small id="transit-year">NT$0／年</small><small id="transit-rate">NT$0.00／公里</small>
        </p>
        <p class="metric">
          <span>Uber 或計程車</span><strong id="rideshare-total">NT$0／月</strong>
          <small id="rideshare-year">NT$0／年</small><small id="rideshare-rate">NT$0.00／公里</small>
        </p>
        <p class="metric">
          <span>單車</span><strong id="bike-total">NT$0／月</strong>
          <small id="bike-year">NT$0／年</small><small id="bike-rate">NT$0.00／公里</small>
        </p>
      </div>
    </section>
  </div>

  <section class="explanation" aria-labelledby="per-distance-method">
    <h2 id="per-distance-method">每公里成本怎麼算：油錢不等於開車總成本</h2>
    <p>
      直接成本模式採用你輸入的每公里或每英里金額。燃油模式在公制下用「每 100 公里耗油公升數 × 每公升油價 ÷ 100」得到每公里油錢；切到英制後，則以每加侖價格除以 MPG 得到每英里油錢。你可以把實際加油收據，或準備加油時看到的中油牌價填進欄位，但本頁不聲稱任何預設值是當期牌價。電動車模式則用每 100 公里或英里的 kWh 數乘上每度電價，再除以 100。
    </p>
    <p>
      油錢、電費只是行駛能源支出，不是完整的開車每公里成本。保養、輪胎、折舊、保險、車貸、稅費，以及為充電或加油繞路的成本，都不在能源模式內。汽車停車費和過路費會另外加入。若你要估真正的車馬費，應先用自己的帳單與里程整理完整單位成本，再放進直接成本模式，不能把油錢結果當成全部。
    </p>

    <h2>一年通勤會累積多少車馬費</h2>
    <p>
      全年結果是每月試算乘以 12。最容易讓數字改變的輸入包括來回距離、每月實際進辦公室天數、每公里成本、停車費、過路費、車資，以及你是否把時間換成金額。混合辦公、輪班或淡旺季工作者，可把每月通勤天數改成具代表性的月平均。這比直接套用一個所謂的車馬費行情更貼近個人狀況，也能看出搬家、換工作地點或改搭大眾運輸後的差距。
    </p>

    <h2>電動車與機車比較怎麼運作</h2>
    <p>
      電動車模式只把車輛電耗與每度電價換成單位能源成本，再套用相同的距離、通勤天數、汽車停車、過路費與時間公式。它刻意排除購車價、貸款、折舊、保險差異、維修、家用充電設備與未反映在輸入電價中的公共充電費，因此不是完整的油電車總持有成本比較；需要更完整的決策時，可使用<a href={localizedPath(locale, '/tools/ev-vs-gas')}>電動車 vs 燃油車總成本計算機</a>。
    </p>
    <p>
      機車在台灣通勤不是附註選項，所以本工具讓它有獨立的每公里成本、停車費、通勤時間、月成本、年成本與單位成本。機車單位成本由你自行定義：可以只放油電，也可以把保養、輪胎和折舊估進去。汽車的停車與過路費不會自動套到機車，避免把兩種交通方式的費用混在一起。
    </p>

    <h2>時薪時間成本代表什麼、不代表什麼</h2>
    <p>
      結果區會明確顯示「一小時通勤值多少」，金額就是你輸入的時薪。每種交通方式仍沿用原本公式：單程分鐘乘以二、每月通勤天數與時薪，再除以 60。時薪填 0，就只比較現金支出。這個數字是用來思考時間取捨，不代表雇主應支付同額車馬費，也不表示每一分鐘都能轉成有薪工作。若你能在火車或捷運上休息或處理事情，體感價值可能與開車不同，工具不替你判斷這部分。
    </p>
    <p>
      大眾運輸採每月實付票價，叫車採單程車資乘以每日兩趟與通勤天數，單車採每月自填成本。各方式的每公里或每英里結果，都用同一段通勤里程去除月總額，方便橫向比較；它不表示月票本身是按公里計價。若加油折扣需要會員費或特別繞路，可另外用<a href={localizedPath(locale, '/tools/costco-membership')}>會員回本計算機</a>測試，不要直接把廣告折扣全算成通勤節省。
    </p>
  </section>

  <DecisionGuide content={decisionGuide} />

  <style>
    .intro,
    .explanation,
    .helper,
    .defaults-note,
    .result-note {
      color: var(--color-muted);
    }

    .calculator-grid,
    .input-grid,
    .metric-grid {
      display: grid;
      gap: 1rem;
    }

    .input-panel,
    .result-panel,
    .explanation {
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      background: var(--color-surface);
      padding: 1rem;
      box-shadow: var(--shadow-soft);
    }

    .switcher {
      min-width: 0;
      margin: 0 0 1rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: 0.75rem;
    }

    .switcher legend,
    .field label {
      font-weight: 650;
    }

    .switch-options {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .switch-options label {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      min-height: 2.75rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      background: var(--color-bg);
      padding: 0.5rem 0.75rem;
      cursor: pointer;
    }

    .switch-options label:has(input:checked) {
      border-color: var(--color-primary);
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-primary) 20%, transparent);
    }

    .switch-options input {
      width: 1.1rem;
      height: 1.1rem;
      margin: 0;
    }

    .mode-options label {
      flex: 1 1 9rem;
    }

    .core-inputs,
    .car-method,
    .mode-fields,
    .derived-box,
    .defaults-note {
      margin-bottom: 1rem;
    }

    .field label {
      display: block;
      margin-bottom: 0.3rem;
    }

    .helper,
    .defaults-note,
    .result-note {
      margin: 0.4rem 0 0;
      font-size: 0.9rem;
    }

    .derived-box,
    .time-summary {
      border-left: 4px solid var(--color-primary);
      border-radius: var(--radius);
      background: var(--color-bg);
      padding: 0.75rem;
    }

    .derived-box span,
    .derived-box strong,
    .derived-box small,
    .metric span,
    .metric strong,
    .metric small {
      display: block;
    }

    .derived-box strong {
      margin: 0.2rem 0;
      font-size: 1.15rem;
    }

    .derived-box small + small,
    .metric small + small {
      margin-top: 0.2rem;
    }

    .result-panel {
      position: sticky;
      top: 1rem;
    }

    .eyebrow {
      margin: 0;
      color: var(--color-muted);
      font-size: 0.85rem;
      font-weight: 700;
    }

    .verdict {
      margin: 0.25rem 0 1rem;
      font-size: 1.35rem;
      font-weight: 750;
      line-height: 1.25;
    }

    .time-summary {
      margin: 0 0 1rem;
      font-weight: 650;
    }

    .metric {
      margin: 0;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      background: var(--color-bg);
      padding: 0.75rem;
    }

    .metric span,
    .metric small {
      color: var(--color-muted);
      font-size: 0.9rem;
    }

    .metric strong {
      font-size: 1.1rem;
    }

    .cheapest-metric {
      border-color: var(--color-primary);
    }

    @media (min-width: 760px) {
      .calculator-grid {
        grid-template-columns: minmax(0, 1fr) minmax(300px, 0.85fr);
        align-items: start;
      }

      .input-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 420px) {
      .switch-options,
      .switch-options label {
        width: 100%;
      }
    }
  </style>

  <script>
    import { formatCurrency } from '../../../lib/money';
    import { bindPersistentField } from '../../../lib/storage';

    type UnitSystem = 'imperial' | 'metric';
    type CarMode = 'direct' | 'fuel' | 'ev';

    interface ModeCost {
      name: string;
      direct: number;
      time: number;
      total: number;
    }

    const locale = 'zh';
    const kilometersPerMile = 1.609344;
    const litersPerGallon = 3.785411784;
    const efficiencyConversion = 235.214583;
    const ids = [
      'unit-system',
      'car-mode',
      'distance',
      'workdays',
      'car-cost',
      'fuel-efficiency',
      'fuel-price',
      'ev-efficiency',
      'electricity-price',
      'scooter-cost',
      'scooter-parking',
      'transit-pass',
      'rideshare',
      'bike-cost',
      'parking',
      'tolls',
      'hourly-wage',
      'car-minutes',
      'scooter-minutes',
      'transit-minutes',
      'rideshare-minutes',
      'bike-minutes',
    ];
    const inputs = ids.map((id) => byId<HTMLInputElement>(id));
    const unitField = byId<HTMLInputElement>('unit-system');
    const carModeField = byId<HTMLInputElement>('car-mode');
    const unitRadios = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="unit-choice"]'));
    const carModeRadios = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="car-mode-choice"]'));
    const verdict = byId<HTMLElement>('commute-result');
    const cheapest = byId<HTMLElement>('cheapest');
    const hourCost = byId<HTMLElement>('hour-cost');
    const derivedRate = byId<HTMLElement>('derived-rate');
    const derivedDetail = byId<HTMLElement>('derived-detail');
    const fuelWarning = byId<HTMLElement>('fuel-warning');

    function byId<T extends HTMLElement>(id: string): T {
      const element = document.getElementById(id);
      if (!element) throw new Error(`Missing #${id}`);
      return element as T;
    }

    function value(id: string): number {
      const parsed = Number(byId<HTMLInputElement>(id).value);
      return Number.isFinite(parsed) ? parsed : 0;
    }

    function positive(id: string): number {
      return Math.max(0, value(id));
    }

    function currentUnit(): UnitSystem {
      return unitField.value === 'imperial' ? 'imperial' : 'metric';
    }

    function currentCarMode(): CarMode {
      return carModeField.value === 'fuel' || carModeField.value === 'ev' ? carModeField.value : 'direct';
    }

    function setValue(id: string, nextValue: number, fractionDigits = 2): void {
      const input = byId<HTMLInputElement>(id);
      const formatted = Number.isFinite(nextValue) ? nextValue.toFixed(fractionDigits).replace(/\.?0+$/, '') : '0';
      input.value = formatted || '0';
      input.dispatchEvent(new Event('input'));
    }

    function formatRate(amount: number): string {
      return new Intl.NumberFormat('zh-TW', {
        style: 'currency',
        currency: 'TWD',
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      }).format(Number.isFinite(amount) ? amount : 0);
    }

    function timeCost(minutesOneWay: number, workdays: number, wage: number): number {
      return wage > 0 ? (Math.max(0, minutesOneWay) * 2 * workdays * wage) / 60 : 0;
    }

    function drivingRate(unit: UnitSystem, mode: CarMode): number {
      if (mode === 'direct') return positive('car-cost');
      if (mode === 'fuel') {
        const efficiency = positive('fuel-efficiency');
        if (efficiency <= 0) return 0;
        return unit === 'imperial'
          ? positive('fuel-price') / efficiency
          : (efficiency * positive('fuel-price')) / 100;
      }
      return (positive('ev-efficiency') * positive('electricity-price')) / 100;
    }

    function applyMode(): void {
      const mode = currentCarMode();
      (['direct', 'fuel', 'ev'] as CarMode[]).forEach((candidate) => {
        const container = byId<HTMLElement>(`${candidate}-fields`);
        const active = candidate === mode;
        container.hidden = !active;
        container.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
          input.disabled = !active;
        });
      });
      carModeRadios.forEach((radio) => {
        radio.checked = radio.value === mode;
      });
    }

    function applyUnitLabels(): void {
      const unit = currentUnit();
      const singular = unit === 'imperial' ? '英里' : '公里';
      byId<HTMLElement>('distance-unit').textContent = singular;
      document.querySelectorAll<HTMLElement>('.distance-name').forEach((element) => {
        element.textContent = singular;
      });
      byId<HTMLElement>('fuel-efficiency-label').textContent = unit === 'imperial' ? '每加侖英里數（MPG）' : '每 100 公里耗油（L/100 km）';
      byId<HTMLElement>('fuel-volume-unit').textContent = unit === 'imperial' ? '加侖' : '公升';
      unitRadios.forEach((radio) => {
        radio.checked = radio.value === unit;
      });
    }

    function convertUnit(from: UnitSystem, to: UnitSystem): void {
      if (from === to) return;
      const toMetric = to === 'metric';
      setValue('distance', toMetric ? positive('distance') * kilometersPerMile : positive('distance') / kilometersPerMile, 2);
      setValue('car-cost', toMetric ? positive('car-cost') / kilometersPerMile : positive('car-cost') * kilometersPerMile, 3);
      setValue('scooter-cost', toMetric ? positive('scooter-cost') / kilometersPerMile : positive('scooter-cost') * kilometersPerMile, 3);
      const fuelEfficiency = positive('fuel-efficiency');
      setValue('fuel-efficiency', fuelEfficiency > 0 ? efficiencyConversion / fuelEfficiency : 0, 2);
      setValue('fuel-price', toMetric ? positive('fuel-price') / litersPerGallon : positive('fuel-price') * litersPerGallon, 3);
      setValue('ev-efficiency', toMetric ? positive('ev-efficiency') / kilometersPerMile : positive('ev-efficiency') * kilometersPerMile, 2);
    }

    function renderMode(mode: ModeCost, prefix: string, monthlyDistance: number, unit: UnitSystem): void {
      const distanceName = unit === 'imperial' ? '英里' : '公里';
      byId<HTMLElement>(`${prefix}-total`).textContent = `${formatCurrency(mode.total, locale)}／月`;
      byId<HTMLElement>(`${prefix}-year`).textContent = `${formatCurrency(mode.total * 12, locale)}／年`;
      byId<HTMLElement>(`${prefix}-rate`).textContent = `${formatRate(monthlyDistance > 0 ? mode.total / monthlyDistance : 0)}／${distanceName}`;
    }

    function update(): void {
      const unit = currentUnit();
      const carMode = currentCarMode();
      const distance = positive('distance');
      const workdays = positive('workdays');
      const wage = positive('hourly-wage');
      const monthlyDistance = distance * 2 * workdays;
      const rate = drivingRate(unit, carMode);
      const distanceName = unit === 'imperial' ? '英里' : '公里';
      const modes: ModeCost[] = [
        {
          name: carMode === 'ev' ? '電動車' : '汽車',
          direct: monthlyDistance * rate + positive('parking') + positive('tolls'),
          time: timeCost(value('car-minutes'), workdays, wage),
          total: 0,
        },
        {
          name: '機車',
          direct: monthlyDistance * positive('scooter-cost') + positive('scooter-parking'),
          time: timeCost(value('scooter-minutes'), workdays, wage),
          total: 0,
        },
        {
          name: '大眾運輸',
          direct: positive('transit-pass'),
          time: timeCost(value('transit-minutes'), workdays, wage),
          total: 0,
        },
        {
          name: 'Uber／計程車',
          direct: positive('rideshare') * 2 * workdays,
          time: timeCost(value('rideshare-minutes'), workdays, wage),
          total: 0,
        },
        {
          name: '單車',
          direct: positive('bike-cost'),
          time: timeCost(value('bike-minutes'), workdays, wage),
          total: 0,
        },
      ].map((mode) => ({ ...mode, total: mode.direct + mode.time }));
      const winner = modes.reduce((best, mode) => (mode.total < best.total ? mode : best));
      const highest = modes.reduce((max, mode) => Math.max(max, mode.total), 0);

      derivedRate.textContent = `${formatRate(rate)}／${distanceName}`;
      if (carMode === 'fuel') {
        derivedDetail.textContent = unit === 'imperial'
          ? `每加侖 ${formatRate(positive('fuel-price'))} ÷ ${positive('fuel-efficiency').toFixed(1)} MPG。`
          : `${positive('fuel-efficiency').toFixed(1)} L/100 km × 每公升 ${formatRate(positive('fuel-price'))} ÷ 100。`;
        fuelWarning.textContent = '僅含燃油：不含保養、輪胎、折舊、保險、貸款與稅費。';
      } else if (carMode === 'ev') {
        derivedDetail.textContent = `每 100 ${distanceName} ${positive('ev-efficiency').toFixed(1)} kWh × 每度 ${formatRate(positive('electricity-price'))} ÷ 100。`;
        fuelWarning.textContent = '僅含電費：不含車價、充電設備、保養、保險與折舊。';
      } else {
        derivedDetail.textContent = '採用你直接輸入的單位成本，包含哪些項目由你決定。';
        fuelWarning.textContent = '工具不會假設這是油錢、增量成本或完整持有成本。';
      }

      cheapest.textContent = `${winner.name}（${formatCurrency(winner.total, locale)}／月）`;
      renderMode(modes[0], 'car', monthlyDistance, unit);
      renderMode(modes[1], 'scooter', monthlyDistance, unit);
      renderMode(modes[2], 'transit', monthlyDistance, unit);
      renderMode(modes[3], 'rideshare', monthlyDistance, unit);
      renderMode(modes[4], 'bike', monthlyDistance, unit);
      verdict.textContent = `${winner.name}成本最低，每月約 ${formatCurrency(winner.total, locale)}，比最高成本方式最多少 ${formatCurrency(highest - winner.total, locale)}。`;
      const roundTripMinutes = positive('car-minutes') * 2;
      hourCost.textContent = `時薪 ${formatCurrency(wage, locale)} 時，一小時通勤的試算時間成本是 ${formatCurrency(wage, locale)}；汽車或電動車來回 ${roundTripMinutes.toFixed(0)} 分鐘，相當於 ${formatCurrency((roundTripMinutes * wage) / 60, locale)} 的時間。`;
    }

    inputs.forEach((input) => {
      bindPersistentField(input, `commute-cost:v2:${input.id}:zh`);
      input.addEventListener('input', update);
    });

    unitField.value = currentUnit();
    carModeField.value = currentCarMode();
    applyUnitLabels();
    applyMode();

    unitRadios.forEach((radio) => {
      radio.addEventListener('change', () => {
        if (!radio.checked) return;
        const previousUnit = currentUnit();
        const nextUnit: UnitSystem = radio.value === 'imperial' ? 'imperial' : 'metric';
        convertUnit(previousUnit, nextUnit);
        unitField.value = nextUnit;
        unitField.dispatchEvent(new Event('input'));
        applyUnitLabels();
        update();
      });
    });

    carModeRadios.forEach((radio) => {
      radio.addEventListener('change', () => {
        if (!radio.checked) return;
        carModeField.value = radio.value;
        carModeField.dispatchEvent(new Event('input'));
        applyMode();
        update();
      });
    });

    update();
  </script>
