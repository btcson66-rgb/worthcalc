---
/*
 * 信用卡分期試算 (P2 batch 2, 2026-10-17). Upgrade of the old generic 分期付款真實 APR page.
 *
 * Every number in the prose is computed below from src/lib/twInstallmentMath.mjs, the same
 * module the calculator runs, so the page cannot disagree with its own tool. The numbers are
 * also pinned in tests/tw-installment-math.test.mjs. Fees and rates in the worked examples
 * are assumptions chosen to show the arithmetic; none of them is any issuer's actual rate.
 */
import ToolLayout from '../../../layouts/ToolLayout.astro';
import TWInstallmentCalculator from '../../../components/TWInstallmentCalculator.astro';
import TWBillInstallmentCalculator from '../../../components/TWBillInstallmentCalculator.astro';
import { localizedPath } from '../../../i18n/utils';
import { ANNOUNCED_EARLY_FEES, annuityFactor, aprOfOneTimeFee, billEarlySettlement, earlySettlement, evaluateBillInstallment, evaluatePlan, irrMonthly, nominalFromMonthly } from '../../../lib/twInstallmentMath.mjs';

const locale = 'zh' as const;
const title = '信用卡分期試算：手續費換算年利率、零利率陷阱與帳單分期';
const description = '信用卡分期試算：輸入分期金額、期數、手續費與利率，算出總費用年百分率；另有帳單分期模式，附三家銀行公告對照、提前結清違約金與是否影響信用。';
const checked = '2026-10-17';

const n0 = (n: number) => Math.round(n).toLocaleString('en-US');
const p2 = (n: number) => n.toFixed(2);

// 算例一：30,000 元、零利率、12 期、一次性手續費 600 元加在第 1 期帳單
const ex1 = evaluatePlan({ listPrice: 30000, n: 12, oneTimeFee: 600 });
const ex1Up = evaluatePlan({ listPrice: 30000, n: 12, oneTimeFee: 600, feeTiming: 'upfront' });
const ex1Spread = irrMonthly([30000, ...Array(12).fill(-2550)]);
const ex1Rest = ex1.schedule.rows[1].payment;
const avgBalanceShare = 13 / 24;
// 每期手續費 100 元
const ex1Each = evaluatePlan({ listPrice: 30000, n: 12, perPeriodFee: 100 });
// 算例二：60,000 元、24 期、年利率為假設值
const ex2 = [6, 8, 10].map((rate) => ({ rate, ...evaluatePlan({ listPrice: 60000, n: 24, aprPct: rate }) }));
const ex2Eq = evaluatePlan({ listPrice: 60000, n: 24, aprPct: 8, method: 'equalPrincipal' });
const ex2Fee = evaluatePlan({ listPrice: 60000, n: 24, aprPct: 8, perPeriodFee: 50 });
const ex2Main = ex2[1];
// 算例三：現金價 28,800、分期標價 30,000 零利率零手續費
const ex3 = evaluatePlan({ listPrice: 30000, cashPrice: 28800, n: 12 });
// 算例四：算例一提前結清
const earlyKs = [1, 3, 6, 9, 11];
const early = earlyKs.map((k) => ({ ...earlySettlement({ listPrice: 30000, n: 12, oneTimeFee: 600 }, k, 0)! }));
// 對照表
const feePcts = [1, 2, 3, 5];
const periods = [3, 6, 12, 24];
// 3 期短期分期：金額小但年百分率高
const short = evaluatePlan({ listPrice: 30000, n: 3, oneTimeFee: 900 });

// ---- 帳單分期（P2 第 4 批）----
// 算例五：帳單 30,000、最低應繳 3,000（示範值）、先繳 3,000、分期 27,000、12 期、年利率 10%（示範值，落在三家公告的範圍內）
const billIn = { statementTotal: 30000, minimumDue: 3000, paidNow: 3000, n: 12, aprPct: 10, revolvingAprPct: 15 };
const bill = evaluateBillInstallment(billIn);
const billPlan = bill.plan!;
const billRev = bill.revolving!;
const billRev10 = evaluateBillInstallment({ ...billIn, revolvingAprPct: 12 }).revolving!;
const billByN = [6, 12, 18, 24, 30].map((n) => ({ n, ...evaluatePlan({ listPrice: bill.financed, n, aprPct: 10 }) }));
const billFactor = annuityFactor(0.1 / 12, 12);
// 富邦公告的對照表（帳單分期 10,000 元、利率 3.9%~15%），用同一個函式重算
const fubonPublished: Record<number, [number, number]> = { 3: [3355, 3417], 6: [1686, 1740], 12: [851, 903], 18: [573, 624], 24: [434, 485], 30: [350, 402] };
const fubonTable = [3, 6, 12, 18, 24, 30].map((n) => ({
  n,
  low: evaluatePlan({ listPrice: 10000, n, aprPct: 3.9 }).firstPayment,
  high: evaluatePlan({ listPrice: 10000, n, aprPct: 15 }).firstPayment,
  published: fubonPublished[n],
}));
// 算例六：提前結清（27,000、12 期、10%），三家公告的違約金／作業費
const billEarlyKs = [1, 3, 6, 9, 11];
const billEarly = billEarlyKs.map((k) => {
  const base = billEarlySettlement({ financed: bill.financed, n: 12, aprPct: 10 }, k, 0)!;
  const fees = { taishin: ANNOUNCED_EARLY_FEES.taishin(k, 12) as number, fubon: ANNOUNCED_EARLY_FEES.fubon(k, 12) as number, dbs: ANNOUNCED_EARLY_FEES.dbs(k, 12) as number };
  return { k, remaining: base.remaining, avoided: base.interestAvoided, fees };
});
const money0 = (n: number) => `${n < 0 ? '−' : ''}${n0(Math.abs(n))}`;

const sources = [
  { label: '全國法規資料庫 — 銀行業暨保險業辦理消費者信用交易廣告應揭示總費用範圍及年百分率計算方式標準（第 2、5、6、7、8 條）', url: 'https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=G0380176', verifiedDate: checked },
  { label: '中華民國銀行公會 — 各發卡機構信用卡分期付款手續費收費標準彙整表（快照：彙整日期 115 年 7 月 22 日 = 2026-07-22）', url: 'https://www.ba.org.tw/consumerCash/details?id=11', verifiedDate: checked },
  { label: '合作金庫商業銀行 — 青安貸款「總費用年百分率範例」（驗證年百分率是月 IRR × 12）', url: 'https://www.tcb-bank.com.tw/personal-banking/loan/mortgage/house-loan-overview/policy-loan-01', verifiedDate: checked },
  { label: '臺灣土地銀行 — 貸款還款方式說明（本息平均攤還與本金平均攤還的公式）', url: 'https://www.landbank.com.tw/Calculate/Repayment', verifiedDate: checked },
  { label: '金管會 — 信用卡定型化契約範本（第 14 條還款抵充順序；全文沒有分期提前清償或分期手續費條文）', url: 'https://law.fsc.gov.tw/LawContent.aspx?id=FL049932', verifiedDate: checked },
  { label: '台北富邦銀行 — 信用卡帳單分期（申請資格、期數、年金法、分期利率上限 15%、提前清償違約金 160／150／140 元；頁面未標發布日期，範例以 115 年 9 月 1 日為計算基準日）', url: 'https://www.fubon.com/banking/personal/credit_card/rte02/rte02.htm', verifiedDate: checked },
  { label: '台新銀行 — 信用卡分期功能申請說明及注意事項（頁面日期 2022/05/25：年利率 6.25%~15%、無其他手續費、提前清償作業費 300／200／免收）', url: 'https://www.taishinbank.com.tw/TSB/personal/common/legal-disclaimers/TSBankPublicDisclosure-000117/', verifiedDate: checked },
  { label: '星展銀行 — 信用卡分期付款約定條款及注意事項（帳單輕鬆分；年利率 2.99%~14.99%、年金法、提前清償違約金 300／150 元；檔名 SBI_TC_20250322，年百分率範例計算基準日 2023-02-10）', url: 'https://dbs.com.tw/iwov-resources/pdf/cards/SBI_TC_20250322.pdf', verifiedDate: checked },
  { label: '金管會 — 最低應繳金額令（金管銀票字第 10340001781 號，104-07-01 生效；每期至少包含「每期應付之分期本金及利息」）', url: 'https://law.fsc.gov.tw/LawContent.aspx?id=GL001164', verifiedDate: checked },
  { label: '財團法人金融聯合徵信中心 — 個人信用評分組成', url: 'https://www.jcic.org.tw/main_ch/docDetail.aspx?uid=1555&pid=1555&docid=629', verifiedDate: checked },
  { label: '財團法人金融聯合徵信中心 — 常見問答（DBR 22 倍：計入信用卡分期付款餘額）', url: 'https://www.jcic.org.tw/main_ch/faq.aspx', verifiedDate: checked },
];

const trustBlock = {
  method: '把現金價當成你今天借到的錢，把每一期帳單（含手續費）當成還款，解出讓兩邊現值相等的月內部報酬率（月 IRR），再乘 12 得到總費用年百分率。有利率時，每期本息依年金法（本息平均攤還）或本金平均攤還計算。',
  formula: '現金價 = Σ［第 k 期應繳 ÷ (1 + 月 IRR)^k］；年百分率 = 月 IRR × 12；本息平均攤還每期 = 本金 × i(1+i)^n ÷ ((1+i)^n − 1)，i = 年利率 ÷ 12',
  sources,
  limits: [
    '試算結果僅供參考，以發卡銀行的分期付款約定書與帳單為準。',
    '利率與手續費都是你輸入的數字；本頁算例用的 600 元、8% 等都是為了示範的假設值，不是任何銀行的費率。',
    '簡化：月利率 = 年利率 ÷ 12、每期取整到元且最後一期補差額、分期從購買後一個月開始、一次性手續費加在第 1 期帳單（或購買當下）、提前結清時已繳手續費不退。各發卡機構的實際算法不同，可用「帳單上每期實際金額」欄位直接輸入。',
    '年百分率依標準只計利息與手續費，逾期違約金不計入；「放棄現金折扣」「放棄回饋」是本頁另外列出的機會成本，不是標準定義的年百分率。',
    '帳單分期模式的利率與違約金是你輸入的數字；三家銀行的公告各自不同（利率怎麼訂、提前結清費用、可分期門檻），公告可能隨時更新，台新頁面日期為 2022/05/25，使用前請以你的帳單與約定書為準。',
    '官方資料查不到的事不寫：分期提前結清的費用、已繳手續費退不退，信用卡定型化契約範本沒有規定，要看你的約定書。',
  ],
  lastReviewed: checked,
  locale,
};

const faq = [
  {
    question: '信用卡分期手續費 2% 等於年利率 2% 嗎？',
    answer: `不等於。分期的本金每個月都在減少，12 期的平均欠款只有標價的 ${p2(avgBalanceShare * 100)}% 左右，手續費卻按全額收。標價 30,000 元、12 期、手續費 600 元（2%）換算後，總費用年百分率是 ${p2(ex1.aprPct)}%。`,
  },
  {
    question: '零利率分期真的沒有成本嗎？',
    answer: '要分開看。「零利率」只說沒有利息，不代表沒有手續費；現金價比分期標價低時，價差就是隱含的利息（算例三：現金價 28,800 元、分期 12 期共 30,000 元，隱含年百分率約 ' + p2(ex3.aprRealPct) + '%）；分期期間是否還有信用卡回饋，要看活動辦法。',
  },
  {
    question: '帳單分期怎麼算？跟一般刷卡分期有什麼不同？',
    answer: `帳單分期是把「這一期帳單還沒繳的餘額」拆成分期：分期金額 = 當期帳單應繳總額 − 你這期先繳的金額，而且至少要先繳足最低應繳，申請才會生效（富邦、星展公告）。之後每期本息併入最低應繳金額。本頁算例：帳單 30,000 元、最低應繳 3,000 元（示範值）、先繳 3,000 元，分期 ${n0(bill.financed)} 元、12 期、年利率 10%（示範值）→ 每期約 ${n0(billPlan.firstPayment)} 元、總利息 ${n0(billPlan.totalInterest)} 元。`,
  },
  {
    question: '帳單分期的利率是多少？',
    answer: '各銀行不同，而且依信用評等調整：台新頁面（2022/05/25）寫年利率 6.25%~15%；星展約定條款寫 2.99%~14.99%；富邦的分期利率 = 指數型房貸基準利率 + 加碼，上限 15%，實際利率印在每期帳單的「帳單分期利率」欄。三家都寫明總費用年百分率等於分期利率。請填你自己帳單上的數字。',
  },
  {
    question: '帳單分期可以提前繳清嗎？要付違約金嗎？',
    answer: '可以，但銀行可能收費，而且多繳不等於提前清償：星展約定條款寫溢繳款不會提前清償分期專案的剩餘本金，要主動申請。三家公告的收費不同（台新 300／200 元或免收、富邦 160／150／140 元、星展 300／150 元），算例見上方「算例六」；省下的利息大於違約金才划算。',
  },
  {
    question: '分期提前繳清，手續費會退嗎？',
    answer: '信用卡定型化契約範本沒有分期提前清償與手續費退費的條文（2026-10-17 查核），所以要看你簽的分期付款約定書。請先問清楚：有沒有提前結清作業費、已繳手續費退不退、結清金額怎麼算。本頁的提前結清試算假設已繳手續費不退。',
  },
  {
    question: '信用卡分期會影響信用評分嗎？',
    answer: '聯徵中心的「個人信用評分組成」頁面列出繳款行為與負債類資料，沒有提到「分期」；因此本頁不下「會扣分」或「不會扣分」的結論。能確定的是：還款是否準時屬於繳款行為；另外聯徵中心常見問答寫明，信用卡未付清的分期付款餘額會計入 DBR 22 倍（無擔保債務總餘額除以平均月收入）的計算。',
  },
  {
    question: '手續費「每期」收和「一次」收，哪個比較貴？',
    answer: `看總額和年百分率，不要看單一數字。同樣標價 30,000 元、12 期：一次收 600 元，年百分率 ${p2(ex1.aprPct)}%；每期收 100 元（共 1,200 元），年百分率 ${p2(ex1Each.aprPct)}%。每期 100 元看起來少，總額其實多一倍。`,
  },
];

const related = [
  { title: '信用卡循環利息計算器：日息、15% 上限與最低應繳', href: localizedPath(locale, '/tools/credit-card-payoff') },
  { title: '先買後付 vs 信用卡分期：用總成本與扣款時間比較', href: localizedPath(locale, '/bnpl-vs-credit-card-installments') },
  { title: '開辦費與手續費如何墊高分期成本', href: localizedPath(locale, '/upfront-fees-financing-cost') },
];
---

<ToolLayout title={title} description={description} locale={locale} tool={{ name: title }} faq={faq} related={related} alternateLocales={['en', 'zh']} showReview={false} trustBlock={trustBlock}>
  <div class="mode-switch" role="group" aria-label="試算模式">
    <button type="button" data-mode="item" aria-pressed="true">刷卡分期／手續費換算年利率</button>
    <button type="button" data-mode="bill" aria-pressed="false">帳單分期（把這期帳單拆開）</button>
  </div>
  <div data-mode-panel="item"><TWInstallmentCalculator /></div>
  <div data-mode-panel="bill" id="bill-installment"><TWBillInstallmentCalculator /></div>

  <section class="calculator-review">
    <div class="prose">
      <p>
        信用卡分期的廣告常寫「零利率」「手續費 2%」，但這些數字不能直接比較：本金每個月都在還，手續費卻是按全額收。把所有付款換成<strong>總費用年百分率</strong>，才有辦法和別的資金成本放在一起看。上面的計算機做的就是這件事；下面說明公式、兩個完整算例、零利率分期的成本藏在哪裡，以及提前結清與信用的問題。
      </p>

      <aside class="method-note" aria-label="本頁年百分率的算法與驗證依據">
        <p>
          <strong>本頁的「總費用年百分率」怎麼算：</strong>先解出月 IRR（讓每期付款折現後剛好等於現金價的月利率），再<strong>乘以 12</strong>。標準條文（{checked} 查核）只規定「內部報酬率法」、四捨五入到小數點後第二位、期數以十二個月計，沒有寫出「乘 12」或「複利換算」；所以本頁用合作金庫青安貸款頁公開的總費用年百分率範例反推，月 IRR × 12 得 2.30%、與該行揭露的「2.30%起」一致，複利換算得 2.33%，不一致。這個驗證只涵蓋一家銀行的一個範例，不代表每家發卡機構的內部算法；以帳單或約定書揭露的年百分率為準。
        </p>
      </aside>

      <h2>分期手續費怎麼換算成年利率</h2>
      <p>
        金管會主管的標準（<a href="https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=G0380176">銀行業暨保險業辦理消費者信用交易廣告應揭示總費用範圍及年百分率計算方式標準</a>，{checked} 查核）要求銀行業在行銷廣告揭示「所有應付總費用之年百分率」（第 2 條），並規定算法（第 8 條）：
      </p>
      <ul>
        <li>採<strong>內部報酬率法</strong>：把你收到的錢和你付出的每一筆錢（每期本息加手續費）折現，讓兩邊現值相等的那個利率，就是年百分率。</li>
        <li>年百分率<strong>四捨五入到小數點後第二位</strong>；還款期數「以一年（三百六十五天）、五十二週或十二個月計算」，月繳就是一年 12 期。</li>
        <li>還款金額依序先抵沖借款費用，再沖利息，最後才沖本金。</li>
        <li>消費者自己違約產生的費用（例如逾期還款違約金）不計入總費用（第 7 條）。</li>
      </ul>
      <p>
        月繳的做法是先解出<strong>月 IRR</strong>（讓下式成立的 m），再換成年：
      </p>
      <pre><code>現金價 = 第 1 期應繳 ÷ (1+m) + 第 2 期應繳 ÷ (1+m)^2 + … + 第 n 期應繳 ÷ (1+m)^n
年百分率 = m × 12</code></pre>
      <p>
        標準的條文沒有寫「月 IRR 乘 12」還是「複利換算」。本頁用公開的範例對照：<a href="https://www.tcb-bank.com.tw/personal-banking/loan/mortgage/house-loan-overview/policy-loan-01">合作金庫青安貸款頁的總費用年百分率範例</a>（200 萬元、20 年、利率 2.275%、年金法、費用 5,300 元，揭露「2.30%起」，{checked} 查核）。用這組數字，月 IRR × 12 得 2.30%，複利換算 (1+m)^12 − 1 得 2.33%，只有前者吻合，所以本頁的「總費用年百分率」是月 IRR × 12，複利年化只放在旁邊對照。
      </p>

      <h2>算例一：30,000 元、零利率 12 期、手續費 600 元</h2>
      <p>
        假設你要買 30,000 元的商品，分期方案是「零利率、12 期、一次性手續費 600 元，加在第 1 期帳單」。（600 元是示範用的假設值；每家發卡機構的手續費不同，見下方彙整表說明。）計算機的預設值就是這一題。
      </p>
      <ol>
        <li>每期本金 = 30,000 ÷ 12 = {n0(ex1Rest)} 元；零利率，沒有利息。</li>
        <li>第 1 期 = {n0(ex1Rest)} + 手續費 600 = <strong>{n0(ex1.firstPayment)} 元</strong>；第 2 到 12 期每期 {n0(ex1Rest)} 元。</li>
        <li>總付款 = {n0(ex1.firstPayment)} + {n0(ex1Rest)} × 11 = <strong>{n0(ex1.totalPaid)} 元</strong>，比現金價多 {n0(ex1.totalCost)} 元，也就是標價的 {p2((600 / 30000) * 100)}%。</li>
        <li>解月 IRR：30,000 = {n0(ex1.firstPayment)} ÷ (1+m) + {n0(ex1Rest)} ÷ (1+m)^2 + … + {n0(ex1Rest)} ÷ (1+m)^12，得 m = {(ex1.monthly * 100).toFixed(4)}%。</li>
        <li>年百分率 = {(ex1.monthly * 100).toFixed(4)}% × 12 = <strong>{p2(ex1.aprPct)}%</strong>（複利年化 {p2(ex1.compoundedPct)}%）。</li>
      </ol>
      <p>
        結論：手續費只有 {p2((600 / 30000) * 100)}%，換算後卻接近 {p2(ex1.aprPct)}%。原因是 12 期等額還本時，平均欠款只有標價的 (12+1) ÷ (2×12) = {p2(avgBalanceShare * 100)}%，{p2((600 / 30000) * 100)}% ÷ {p2(avgBalanceShare * 100)}% ≈ {p2(((600 / 30000) * 100) / avgBalanceShare)}%，方向和 {p2(ex1.aprPct)}% 一致。如果手續費改成購買當下先付，年百分率是 {p2(ex1Up.aprPct)}%；如果平均攤進每期（每期 2,550 元），是 {p2(nominalFromMonthly(ex1Spread) * 100)}%。收費的時點會讓結果差一點，所以輸入欄位讓你選。
      </p>

      <h2>對照表：一次性手續費 × 期數 → 年百分率</h2>
      <p>
        下表由計算機同一個函式算出：零利率、手續費一次收、加在第 1 期帳單，百分比是手續費占標價的比例。同樣的費率，期數越短，年百分率越高。
      </p>
      <table>
        <thead>
          <tr><th>手續費占標價</th>{periods.map((n) => <th>{n} 期</th>)}</tr>
        </thead>
        <tbody>
          {feePcts.map((f) => (
            <tr><td>{f}%</td>{periods.map((n) => <td>{p2(aprOfOneTimeFee(f, n))}%</td>)}</tr>
          ))}
        </tbody>
      </table>
      <p>
        短期分期的年百分率看起來很嚇人，但絕對金額不大。例如標價 30,000 元、3 期、手續費 900 元（3%），年百分率 {p2(short.aprPct)}%，實際多付 {n0(short.totalCost)} 元。比較兩個方案時，年百分率和多付的金額都要看。
      </p>

      <h2>算例二：有利率的分期，本息平均 vs 本金平均</h2>
      <p>
        有些分期方案是有利率的。利率請填約定書上的數字，下面用 6%、8%、10% 只是假設，用來看利率的影響。標價 60,000 元、24 期，月利率 i = 年利率 ÷ 12。
      </p>
      <p>
        <strong>本息平均攤還</strong>（<a href="https://www.landbank.com.tw/Calculate/Repayment">土地銀行說明</a>的年金法，{checked} 查核）：每期本息固定，每月應付本息金額 = 本金 × 平均攤還率，平均攤還率 = i(1+i)^n ÷ ((1+i)^n − 1)；每月利息 = 本金餘額 × 月利率；每月本金 = 每期本息 − 當月利息。
      </p>
      <table>
        <thead>
          <tr><th>年利率（假設）</th><th>每期本息</th><th>24 期總利息</th><th>總付款</th><th>年百分率</th></tr>
        </thead>
        <tbody>
          {ex2.map((r) => (
            <tr><td>{r.rate}%</td><td>約 {n0(r.firstPayment)} 元</td><td>{n0(r.totalInterest)} 元</td><td>{n0(r.totalPaid)} 元</td><td>{p2(r.aprPct)}%</td></tr>
          ))}
        </tbody>
      </table>
      <p>
        8% 這一列的算法：i = 8% ÷ 12 = 0.6667%，平均攤還率 = {annuityFactor(0.08 / 12, 24).toFixed(7)}，每期 = 60,000 × {annuityFactor(0.08 / 12, 24).toFixed(7)} ≈ {n0(ex2Main.firstPayment)} 元（銀行實際可能進位方式不同，最後一期補差額：{n0(ex2Main.lastPayment)} 元）。沒有手續費時，年百分率就等於約定年利率 8.00%。
      </p>
      <p>
        <strong>本金平均攤還</strong>：每月本金固定 = 60,000 ÷ 24 = 2,500 元，利息 = 當月本金餘額 × 月利率，所以每期遞減。8% 時第 1 期 = 2,500 + 400 = {n0(ex2Eq.firstPayment)} 元，最後一期 {n0(ex2Eq.lastPayment)} 元，總利息 {n0(ex2Eq.totalInterest)} 元，比本息平均攤還的 {n0(ex2Main.totalInterest)} 元少 {n0(ex2Main.totalInterest - ex2Eq.totalInterest)} 元，代價是前期每期多繳。哪一種要看約定書。
      </p>
      <p>
        再加手續費會怎樣？8% 加上每期手續費 50 元（假設），每期 {n0(ex2Fee.firstPayment)} 元，24 期共多付 {n0(ex2Fee.totalCost)} 元，年百分率從 8.00% 變成 {p2(ex2Fee.aprPct)}%。
      </p>

      <h2>零利率分期的陷阱：成本藏在哪</h2>
      <h3>一、手續費</h3>
      <p>
        「零利率」只說沒有利息。手續費要另外看，而且收法不一：銀行公會彙整的<a href="https://www.ba.org.tw/consumerCash/details?id=11">各發卡機構信用卡分期付款手續費收費標準彙整表</a>（彙整日期 2026-07-22，{checked} 打開查核）列了 30 家發卡機構（另註明美國運通未開辦分期）。這張表是<strong>2026-07-22 的快照</strong>：網頁另顯示 2024/07/26，附件檔名與表頭「本會彙整日期」都是 115 年 7 月 22 日，表末註明依各發卡行提供的資料彙整，內容是否異動請上各發卡行網站查看。依該表（除一般消費分期外，另有「分期償還代墊帳單帳款」，即帳單分期，本頁沒有統計）：
      </p>
      <ul>
        <li>「分期償還代墊消費帳款」（一般消費分期）：24 家在各期數都標 0 元，6 家有些期數或有分期卡方案收固定金額，從 50 元到 299 元不等。</li>
        <li>「分期償還預借現金」：有承作的 14 家中，5 家收費，金額從 500 元到 2,999 元不等。</li>
        <li>手續費是以新臺幣金額列示，不是百分比；有些發卡機構同一個項目隨期數遞增。</li>
        <li>該表只列手續費，沒有列分期利率，所以「手續費 0 元」不等於「沒有任何成本」；利率要看各行當期活動與約定書。</li>
      </ul>
      <p>
        這些是 2026-07-22 的快照，之後可能異動。本頁不引用任何一家的費率，請以你的分期方案和發卡銀行最新公告為準。每期收費比一次收費更容易被忽略：標價 30,000 元、12 期，一次收 600 元，年百分率 {p2(ex1.aprPct)}%；每期收 100 元，共 {n0(ex1Each.totalFees)} 元，年百分率 {p2(ex1Each.aprPct)}%。
      </p>

      <h3>二、現金價比分期標價低</h3>
      <p>
        有些商品付現可以拿折扣，分期則是原價。這個價差就是隱含的利息，而且不屬於標準定義的「手續費」，廣告上的「零利率」也不會把它算進去。
      </p>
      <p>
        <strong>算例三：</strong>現金價 28,800 元，分期 12 期、每期 2,500 元（共 30,000 元），零利率、零手續費。依標準只計利息與手續費，年百分率是 {p2(ex3.aprPct)}%；但你選分期等於多付 {n0(ex3.totalCost)} 元，把現金價當成借到的錢，月 IRR 是 {(ex3.monthlyReal * 100).toFixed(4)}%，隱含年百分率 <strong>{p2(ex3.aprRealPct)}%</strong>。計算機的「現金價」欄（進階選項）就是做這個比較。
      </p>

      <h3>三、分期期間的信用卡回饋</h3>
      <p>
        刷卡回饋、紅利點數在分期消費上是否照給，要看卡片的活動辦法，沒有統一規定，本頁也查不到官方彙整。如果你的卡分期不給回饋，可以把放棄的回饋金額從現金價扣掉，填進進階選項的「現金價」，當成和算例三一樣的隱含成本；這個數字是你自己的假設，不是標準定義的年百分率。
      </p>

      <h3>四、提前結清</h3>
      <p>
        提前繳清看起來能省利息，但如果手續費已經在第 1 期收掉，就不會因為提前繳清自動退回。金管會的<a href="https://law.fsc.gov.tw/LawContent.aspx?id=FL049932">信用卡定型化契約範本</a>全文只有兩處提到分期：第 14 條（還款抵沖順序的註記）和第 21 條（發卡機構變更約款、持卡人異議而終止契約時，分期付款的持卡人至少給六期緩衝期），<strong>沒有分期提前清償或手續費退費的條文</strong>（{checked} 查核）。所以提前結清要不要作業費、已繳手續費退不退，要看你簽的分期付款約定書。
      </p>
      <p>
        <strong>算例四：</strong>延續算例一（手續費 600 元已在第 1 期繳掉）。假設已繳手續費不退、沒有作業費，在第 k 期繳完後一次還清剩餘本金：
      </p>
      <table>
        <thead>
          <tr><th>提前結清時點</th><th>一次還清的剩餘本金</th><th>總付款</th><th>年百分率</th></tr>
        </thead>
        <tbody>
          {early.map((e) => (
            <tr><td>第 {e.k} 期後</td><td>{n0(e.remaining)} 元</td><td>{n0(e.totalPaid)} 元</td><td>{p2(e.aprPct)}%</td></tr>
          ))}
          <tr><td>不提前（12 期）</td><td>—</td><td>{n0(ex1.totalPaid)} 元</td><td>{p2(ex1.aprPct)}%</td></tr>
        </tbody>
      </table>
      <p>
        多付的 600 元不變，但借的時間變短，年百分率反而更高。想提前結清前，先問銀行三件事：結清金額怎麼算、有沒有提前結清作業費、已繳手續費退不退，並請對方給書面或帳單上的金額。
      </p>

      <h2 id="bill-installment-guide">帳單分期怎麼算</h2>
      <p>
        上面計算機頂端切到「帳單分期」模式，算的是另一件事：這期帳單沒繳完的餘額，要不要拆成分期。它和一般刷卡分期的差別，直接用銀行公告的話說（{checked} 打開查核）：
      </p>
      <ul>
        <li><strong>金額從帳單來：</strong>台北富邦寫「申請金額＝當期帳單應繳總額扣除當期已繳款金額（至少須繳足最低應繳金額）後剩餘未償還之金額」，自次期帳單起分期；<a href="https://www.fubon.com/banking/personal/credit_card/rte02/rte02.htm">富邦帳單分期頁</a>。</li>
        <li><strong>至少先繳最低應繳：</strong>富邦與<a href="https://dbs.com.tw/iwov-resources/pdf/cards/SBI_TC_20250322.pdf">星展約定條款</a>都寫，申請那期要在繳款截止日前繳足最低應繳，申請才生效；兩家的可申請門檻都是「應繳總額扣掉最低應繳」達 NT$1,000。台新頁面沒有寫金額門檻，只列出哪些款項不能分期（例如已成立分期的每期應繳金額、預借現金、循環信用利息、所有費用、違約金等）。</li>
        <li><strong>算法：</strong>三家都是年金法（本息平均攤還，台新寫「約定利率本利均攤方式」），每期本息併入該期帳單的最低應繳金額。金管會的最低應繳金額令（金管銀票字第 10340001781 號）也把「每期應付之分期本金及利息」列為最低應繳的一部分。</li>
        <li><strong>年百分率＝分期利率：</strong>三家都寫總費用年百分率等於分期利率，也沒有另收手續費（台新：「無其他手續費」；富邦：「除另有約定外，不收取消費分期手續費」；星展的範例各項相關費用總金額為 0 元）。所以帳單分期不需要像上面的手續費那樣換算，成本就是利率。</li>
      </ul>

      <h3>三家公告的差別</h3>
      <table>
        <thead>
          <tr><th>項目</th><th>台北富邦</th><th>台新</th><th>星展</th></tr>
        </thead>
